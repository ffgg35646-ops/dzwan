      </div>

      {mobileOpen && (
        <div className="mobile-sidebar-layer">
          <button
            type="button"
            className="mobile-sidebar-overlay"
            aria-label="إغلاق القائمة"
            onClick={() => setMobileOpen(false)}
          />

          <div className="mobile-sidebar-panel">
            <button
              type="button"
              className="mobile-close"
