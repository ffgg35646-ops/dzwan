
import { useEffect, useState } from "react";
import {
  Bell,
  Check,
  Loader2,
} from "lucide-react";
import {
api,
  getApiErrorMessage,
} from "../lib/api";
import HomeBackButton from "../components/admin/HomeBackButton";

type Notification = {
  _id: string;
  title: string;
  message: string;
  isRead: boolean;
  createdAt: string;
};

export default function Notifications() {
  const [items, setItems] =
    useState<Notification[]>([]);

  const [loading, setLoading] =
    useState(true);

  const [saving, setSaving] =
    useState(false);

  const [error, setError] =
    useState("");

  async function loadNotifications() {
    try {
      setLoading(true);
      setError("");

      const response =
        await api.get(
          "/notifications?limit=100",
        );

      setItems(
        Array.isArray(
          response.data?.notifications,
        )
          ? response.data.notifications
          : [],
      );
    } catch (err) {
      console.error(err);

      setError(
        getApiErrorMessage(
          err,
          "تعذر تحميل الإشعارات.",
        ),
      );
    } finally {
      setLoading(false);
    }
  }

  async function markRead(
    item: Notification,
  ) {
    if (item.isRead) return;

    try {
      setSaving(true);

      await api.patch(
        `/notifications/${item._id}/read`,
      );

      setItems((current) =>
        current.map((notification) =>
          notification._id === item._id
            ? {
                ...notification,
                isRead: true,
              }
            : notification,
        ),
      );
    } catch (err) {
      console.error(err);

      setError(
        getApiErrorMessage(
          err,
          "تعذر تحديث الإشعار.",
        ),
      );
    } finally {
      setSaving(false);
    }
  }

  async function markAllRead() {
    try {
      setSaving(true);

      await api.post(
        "/notifications/read-all",
      );

      setItems((current) =>
        current.map((item) => ({
          ...item,
          isRead: true,
        })),
      );
    } catch (err) {
      console.error(err);

      setError(
        getApiErrorMessage(
          err,
          "تعذر تحديث الإشعارات.",
        ),
      );
    } finally {
      setSaving(false);
    }
  }

  useEffect(() => {
    void loadNotifications();
  }, []);

  return (
    <main
      className="admin-main"
      dir="rtl"
    >
      <header className="admin-header">
        <div>
          <div className="header-kicker">
            منصة دزوان
          </div>

          <div className="header-title">
            الإشعارات
          </div>
        </div>
      </header>

      <div className="admin-content">

          <HomeBackButton />
        <div className="dashboard">
          <section className="dashboard-intro">
            <div>
              <span className="dashboard-label">
                مركز التنبيهات
              </span>

              <h1>
                الإشعارات
              </h1>

              <p>
                متابعة إشعارات النظام والطلبات.
              </p>
            </div>

            <div className="captains-intro-icon">
              <Bell size={24} />
            </div>
          </section>

          {error && (
            <div className="location-error">
              {error}
            </div>
          )}

          <section className="panel">
            <div className="panel-header">
              <div>
                <h2>
                  كل الإشعارات
                </h2>

                <p>
                  أحدث التنبيهات الخاصة بحسابك.
                </p>
              </div>

              <button
                type="button"
                className="captain-action approve"
                disabled={
                  saving ||
                  items.every(
                    (item) => item.isRead,
                  )
                }
                onClick={() =>
                  void markAllRead()
                }
              >
                <Check size={16} />
                تحديد الكل كمقروء
              </button>
            </div>

            {loading ? (
              <div className="locations-loading">
                <Loader2
                  size={26}
                  className="location-spin"
                />
                <span>
                  جارٍ تحميل الإشعارات...
                </span>
              </div>
            ) : items.length === 0 ? (
              <div className="locations-empty">
                <div className="locations-empty-icon">
                  <Bell size={24} />
                </div>

                <h3>
                  لا توجد إشعارات
                </h3>

                <p>
                  لا توجد إشعارات متاحة حاليًا.
                </p>
              </div>
            ) : (
              <div className="notifications-list">
                {items.map((item) => (
                  <button
                    type="button"
                    key={item._id}
                    className={`notification-item${
                      item.isRead
                        ? ""
                        : " unread"
                    }`}
                    onClick={() =>
                      void markRead(item)
                    }
                  >
                    <strong>
                      {item.title}
                    </strong>

                    <span>
                      {item.message}
                    </span>

                    <small>
                      {new Date(
                        item.createdAt,
                      ).toLocaleString(
                        "ar-EG",
                        {
                          dateStyle:
                            "medium",
                          timeStyle:
                            "short",
                        },
                      )}
                    </small>
                  </button>
                ))}
              </div>
            )}
          </section>
        </div>
      </div>
    </main>
  );
}
