export async function updateSubAdmin(
  req: AuthenticatedRequest,
  res: Response,
) {
  const id = String(req.params.id);

  if (!Types.ObjectId.isValid(id)) {
    return res.status(400).json({
      message: "معرف الأدمن غير صحيح.",
    });
  }

  const data = z.object({
    fullName: z.string().min(2).max(120).optional(),
    status: z.enum([
      "active",
      "suspended",
      "inactive",
    ]).optional(),
    governorateId: z.string().nullable().optional(),
    areaId: z.string().nullable().optional(),
  }).parse(req.body);

  const user =
    await UserModel.findOneAndUpdate(
      {
        _id: id,
        role: "admin",
      },
      {
        $set: {
          ...data,
          governorateId:
            data.governorateId === undefined
              ? undefined
              : data.governorateId
                ? oid(data.governorateId)
                : null,
          areaId:
            data.areaId === undefined
              ? undefined
              : data.areaId
                ? oid(data.areaId)
                : null,
        },
      },
      {
        returnDocument: "after",
        runValidators: true,
      },
    ).select(
      "_id fullName phone email role status governorateId areaId",
    );

  if (!user) {
    return res.status(404).json({
      message: "الأدمن غير موجود.",
    });
  }

  return res.json({
    message: "تم تحديث الأدمن.",
    user,
  });
}

