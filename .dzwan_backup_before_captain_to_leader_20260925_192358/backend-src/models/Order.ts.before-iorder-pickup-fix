import { Schema, model, type Document, type Types } from "mongoose";

export const ORDER_STATUSES = [
  "pending",
  "confirmed",
  "heading_to_shop",
  "arrived_at_shop",
  "picked_up",
  "on_the_way",
  "delivered",
  "completed",
  "cancelled",
  "rejected",
  "preparing",
  "ready_for_pickup",
  "assigned",
] as const;

export type OrderStatus =
  (typeof ORDER_STATUSES)[number];

export interface IOrderItem {
  productId: Types.ObjectId;
  name: string;
  quantity: number;
  unitPrice: number;
  totalPrice: number;
}

export interface IOrder extends Document {
  orderNumber: string;

  customerId?: Types.ObjectId | null;
  customerName: string;
  customerPhone: string;
  deliveryAddress: string;
  establishmentId: Types.ObjectId;

  pickupEstablishmentName?: string | null;
  pickupEstablishmentType?: string | null;
  pickupEstablishmentPhone?: string | null;
  pickupAddress?: string | null;
  pickupGovernorateId?: Types.ObjectId | null;
  pickupAreaId?: Types.ObjectId | null;
  pickupGovernorateName?: string | null;
  pickupAreaName?: string | null;
  pickupLatitude?: number | null;
  pickupLongitude?: number | null;

  deliveryGovernorateId: Types.ObjectId;
  deliveryAreaId: Types.ObjectId;

  addressId?: Types.ObjectId | null;

  captainId?: Types.ObjectId | null;

  items: IOrderItem[];

  subtotal: number;
  deliveryFee: number;
  discount: number;
  offerId?: Types.ObjectId | null;
  offerCode?: string | null;
  total: number;

  status: OrderStatus;

  customerNote?: string | null;

  confirmedAt?: Date | null;
  assignedAt?: Date | null;
  claimedByCaptainAt?: Date | null;
  pickedUpAt?: Date | null;
  deliveredAt?: Date | null;
  cancelledAt?: Date | null;

  cancellationReason?: string | null;

  createdAt: Date;
  updatedAt: Date;
}

const OrderItemSchema =
  new Schema<IOrderItem>(
    {
      productId: {
        type: Schema.Types.ObjectId,
        ref: "Product",
        required: true,
      },

      name: {
        type: String,
        required: true,
        trim: true,
      },

      quantity: {
        type: Number,
        required: true,
        min: 1,
      },

      unitPrice: {
        type: Number,
        required: true,
        min: 0,
      },

      totalPrice: {
        type: Number,
        required: true,
        min: 0,
      },
    },
    {
      _id: false,
    },
  );

const OrderSchema =
  new Schema<IOrder>(
    {
      orderNumber: {
        type: String,
        required: true,
        unique: true,
        index: true,
      },

      customerId: {
        type: Schema.Types.ObjectId,
        ref: "User",
        default: null,
        index: true,
      },

      customerName: {
        type: String,
        required: true,
        trim: true,
        maxlength: 200,
      },

      customerPhone: {
        type: String,
        required: true,
        trim: true,
        maxlength: 50,
      },

      deliveryAddress: {
        type: String,
        required: false,
        default: "",
        trim: true,
        maxlength: 500,
      },

      establishmentId: {
        type: Schema.Types.ObjectId,
        ref: "Establishment",
        required: true,
        index: true,
      },

      pickupEstablishmentName: {
        type: String,
        default: "",
        trim: true,
        maxlength: 200,
      },

      pickupEstablishmentType: {
        type: String,
        default: "",
        trim: true,
        maxlength: 50,
      },

      pickupEstablishmentPhone: {
        type: String,
        default: "",
        trim: true,
        maxlength: 50,
      },

      pickupAddress: {
        type: String,
        default: "",
        trim: true,
        maxlength: 500,
      },

      pickupGovernorateId: {
        type: Schema.Types.ObjectId,
        ref: "Location",
        default: null,
        index: true,
      },

      pickupAreaId: {
        type: Schema.Types.ObjectId,
        default: null,
        index: true,
      },

      pickupGovernorateName: {
        type: String,
        default: "",
        trim: true,
        maxlength: 150,
      },

      pickupAreaName: {
        type: String,
        default: "",
        trim: true,
        maxlength: 150,
      },

      pickupLatitude: {
        type: Number,
        default: null,
      },

      pickupLongitude: {
        type: Number,
        default: null,
      },

      deliveryGovernorateId: {
        type: Schema.Types.ObjectId,
        ref: "Location",
        required: true,
        index: true,
      },

      deliveryAreaId: {
        type: Schema.Types.ObjectId,
        required: true,
        index: true,
      },

      deliveryGovernorateName: {
        type: String,
        default: "",
        trim: true,
        maxlength: 150,
      },

      deliveryAreaName: {
        type: String,
        default: "",
        trim: true,
        maxlength: 150,
      },

      addressId: {
        type: Schema.Types.ObjectId,
        ref: "CustomerAddress",
        default: null,
        index: true,
      },

      captainId: {
        type: Schema.Types.ObjectId,
        ref: "User",
        default: null,
        index: true,
      },

      items: {
        type: [OrderItemSchema],
        required: true,
        validate: {
          validator: (value: IOrderItem[]) =>
            Array.isArray(value),
          message:
            "قائمة منتجات الطلب غير صحيحة.",
        },
      },

      subtotal: {
        type: Number,
        required: true,
        min: 0,
      },

      deliveryFee: {
        type: Number,
        required: true,
        min: 0,
        default: 0,
      },

      discount: {
        type: Number,
        required: true,
        min: 0,
        default: 0,
      },

      offerId: {
        type: Schema.Types.ObjectId,
        ref: "Offer",
        default: null,
        index: true,
      },

      offerCode: {
        type: String,
        trim: true,
        uppercase: true,
        default: null,
      },

      total: {
        type: Number,
        required: true,
        min: 0,
      },

      status: {
        type: String,
        enum: ORDER_STATUSES,
        required: true,
        default: "pending",
        index: true,
      },

      customerNote: {
        type: String,
        trim: true,
        maxlength: 1000,
        default: null,
      },

      confirmedAt: {
        type: Date,
        default: null,
      },

      assignedAt: {
        type: Date,
        default: null,
      },


      claimedByCaptainAt: {
        type: Date,
        default: null,
      },
      pickedUpAt: {
        type: Date,
        default: null,
      },

      deliveredAt: {
        type: Date,
        default: null,
      },

      cancelledAt: {
        type: Date,
        default: null,
      },

      cancellationReason: {
        type: String,
        trim: true,
        maxlength: 500,
        default: null,
      },
    },
    {
      timestamps: true,
      versionKey: false,
    },
  );

OrderSchema.index({
  customerId: 1,
  createdAt: -1,
});

OrderSchema.index({
  establishmentId: 1,
  status: 1,
  createdAt: -1,
});

OrderSchema.index({
  captainId: 1,
  status: 1,
  createdAt: -1,
});

export const OrderModel =
  model<IOrder>("Order", OrderSchema);
