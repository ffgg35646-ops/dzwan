import React, {
  useCallback,
  useEffect,
  useRef,
  useState,
} from "react";
import {
  Modal,
  Pressable,
  StyleSheet,
  Text,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";
import { useNavigation } from "@react-navigation/native";
import { apiGet } from "../../api/request";

export default function NotificationBell() {
  const navigation = useNavigation<any>();
  const [open, setOpen] = useState(false);
  const [count, setCount] = useState(0);
  const acknowledgedCount = useRef(0);
  const [message, setMessage] = useState(
    "لا توجد رسائل جديدة في الدعم السريع.",
  );

  const [position, setPosition] = useState({
    left: 12,
    top: 64,
  });


  const menuWidth = Math.min(
    366,
    366,
  );

  const loadSupportNotification =
    useCallback(async () => {
      try {
        const response = await apiGet(
          "/support-tickets/my/unread-count",
        );

        const value = Number(
          response?.count ?? 0,
        );

        if (value <= 0) {
          acknowledgedCount.current = 0;
          setCount(0);
        } else if (
          value > acknowledgedCount.current
        ) {
          setCount(value);
        } else {
          setCount(0);
        }

        setMessage(
          response?.message ||
            "لديك رسالة جديدة في الدعم السريع.",
        );
      } catch {
        setCount(0);
      }
    }, []);

  useEffect(() => {
    void loadSupportNotification();

    const timer = setInterval(
      () => void loadSupportNotification(),
      10000,
    );

    return () => clearInterval(timer);
  }, [loadSupportNotification]);

  function openMenu() {
    setOpen(true);
  }

  function goToSupport() {
    setOpen(false);
    navigation.navigate("الدعم");
  }

  return (
    <>
      <Pressable
        onPress={() => {
          if (count > 0) {
            acknowledgedCount.current = count;
            setCount(0);
          }

          if (open) {
            setOpen(false);
          } else {
            openMenu();
          }
        }}
        style={({ pressed }) => [
          styles.button,
          pressed && styles.pressed,
        ]}
        accessibilityRole="button"
        accessibilityLabel="الإشعارات"
      >
        <Ionicons
          name="notifications-outline"
          size={22}
          color="#0F172A"
        />

        {count > 0 ? (
          <View style={styles.totalBadge}>
            <Text style={styles.totalBadgeText}>
              {count > 99 ? "99+" : count}
            </Text>
          </View>
        ) : null}
      </Pressable>

      <Modal
        visible={open}
        transparent
        animationType="fade"
        onRequestClose={() => setOpen(false)}
      >
        <View style={styles.modalRoot}>
          <Pressable
            style={styles.modalBackdrop}
            onPress={() => setOpen(false)}
          />

          <View
            pointerEvents="box-none"
            style={styles.appFrame}
          >
            <View style={styles.menu}>
            <View style={styles.menuHead}>
              <View>
                <Text style={styles.menuTitle}>
                  التنبيهات
                </Text>

                <Text style={styles.menuSub}>
                  إشعارات الدعم السريع
                </Text>
              </View>

              <Pressable
                onPress={() => setOpen(false)}
                style={styles.closeButton}
              >
                <Ionicons
                  name="close"
                  size={17}
                  color="#64748B"
                />
              </Pressable>
            </View>

            <Pressable
              onPress={goToSupport}
              style={({ pressed }) => [
                styles.card,
                pressed && styles.cardPressed,
              ]}
            >
              <View style={styles.cardIcon}>
                <Ionicons
                  name="chatbubble-ellipses-outline"
                  size={20}
                  color="#E87516"
                />
              </View>

              <View style={styles.cardBody}>
                <View style={styles.cardTop}>
                  <Text style={styles.cardTitle}>
                    الدعم السريع
                  </Text>

                  {count > 0 ? (
                    <View style={styles.countBadge}>
                      <Text style={styles.countBadgeText}>
                        {count > 99 ? "99+" : count}
                      </Text>
                    </View>
                  ) : null}
                </View>

                <Text
                  style={styles.cardSmall}
                  numberOfLines={3}
                >
                  {count > 0
                    ? message
                    : "لا توجد رسائل جديدة في الدعم السريع."}
                </Text>
              </View>
            </Pressable>
            </View>
          </View>
        </View>
      </Modal>
    </>
  );
}

