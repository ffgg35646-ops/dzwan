import React, { useEffect, useMemo, useState } from "react";
import {
  ActivityIndicator,
  Alert,
  StyleSheet,
  Text,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";

import Screen from "../../components/Screen";
import AppButton from "../../components/AppButton";
import { useAppTheme } from "../../theme/useAppTheme";
import { useAuthStore } from "../../store/authStore";
import {
  checkShift,
  attendanceIn,
  attendanceOut,
} from "../../api/captain";

const DAYS = [
  "الأحد",
  "الاثنين",
  "الثلاثاء",
  "الأربعاء",
  "الخميس",
  "الجمعة",
  "السبت",
];

export default function ShiftScreen() {
  const appTheme = useAppTheme();
  const styles = createStyles(appTheme);

  const user = useAuthStore((s) => s.user);

  const [data, setData] = useState<any>(null);
  const [busy, setBusy] = useState(false);
  const [loading, setLoading] = useState(true);

  async function load() {
    try {
      setLoading(true);

      const result = await checkShift();

      setData(result);
    } catch (e: any) {
      Alert.alert(
        "تعذر تحميل الشفت",
        e?.response?.data?.message ||
          e?.response?.data?.error ||
          "تعذر الاتصال بالخادم.",
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    load();

    const timer = setInterval(load, 60_000);

    return () => clearInterval(timer);
  }, []);

  async function startWork() {
    if (!user?.id) return;

    setBusy(true);

    try {
      await attendanceIn(user.id);
      await load();

      Alert.alert(
        "تم تسجيل الحضور",
        "تم تسجيل بداية العمل بنجاح.",
      );
    } catch (e: any) {
      Alert.alert(
        "تعذر بدء العمل",
        e?.response?.data?.message ||
          "لا يمكن بدء العمل الآن.",
      );
    } finally {
      setBusy(false);
    }
  }

  async function endWork() {
    if (!user?.id) return;

    setBusy(true);

    try {
      await attendanceOut(user.id);
      await load();

      Alert.alert(
        "تم تسجيل الانصراف",
        "تم تسجيل نهاية العمل بنجاح.",
      );
    } catch (e: any) {
      Alert.alert(
        "تعذر إنهاء العمل",
        e?.response?.data?.message ||
          "تعذر تسجيل الانصراف.",
      );
    } finally {
      setBusy(false);
    }
  }

  const insideShift = Boolean(
    data?.insideShift,
  );

  const currentShift = data?.shift || null;

  const start =
    currentShift?.startTime ??
    data?.start ??
    "—";

  const end =
    currentShift?.endTime ??
    data?.end ??
    "—";

  const dayIndex = new Date().getDay();

  const dayName =
    DAYS[dayIndex] || "اليوم";

  const statusText = useMemo(() => {
    if (insideShift) {
      return "أنت داخل وقت الشفت";
    }

    if (data?.shift) {
      return "أنت خارج وقت الشفت";
    }

    return "لا يوجد شفت فعال اليوم";
  }, [insideShift, data]);

  return (
    <Screen>
      <View style={styles.container}>
        <View style={styles.header}>
          <View>
            <Text style={styles.eyebrow}>
              إدارة العمل
            </Text>

            <Text style={styles.title}>
              الشفت والحضور
            </Text>
          </View>

          <View
            style={[
              styles.headerIcon,
              {
                backgroundColor: insideShift
                  ? `${appTheme.successColor}18`
                  : `${appTheme.secondaryTextColor}14`,
              },
            ]}
          >
            <Ionicons
              name="time-outline"
              size={25}
              color={
                insideShift
                  ? appTheme.successColor
                  : appTheme.secondaryTextColor
              }
            />
          </View>
        </View>

        {loading ? (
          <View style={styles.loadingCard}>
            <ActivityIndicator
              size="small"
              color={appTheme.primaryColor}
            />

            <Text style={styles.loadingText}>
              جاري تحميل بيانات الشفت...
            </Text>
          </View>
        ) : (
          <>
            <View
              style={[
                styles.statusCard,
                {
                  borderColor: insideShift
                    ? `${appTheme.successColor}35`
                    : appTheme.borderColor,
                },
              ]}
            >
              <View
                style={[
                  styles.statusIcon,
                  {
                    backgroundColor: insideShift
                      ? `${appTheme.successColor}18`
                      : `${appTheme.secondaryTextColor}12`,
                  },
                ]}
              >
                <Ionicons
                  name={
                    insideShift
                      ? "checkmark-circle"
                      : "pause-circle-outline"
                  }
                  size={30}
                  color={
                    insideShift
                      ? appTheme.successColor
                      : appTheme.secondaryTextColor
                  }
                />
              </View>

              <View style={styles.statusContent}>
                <Text style={styles.cardLabel}>
                  حالة الشفت الآن
                </Text>

                <Text style={styles.statusTitle}>
                  {statusText}
                </Text>

                <Text style={styles.statusDescription}>
                  {insideShift
                    ? "يمكنك العمل واستقبال الطلبات حسب قواعد النظام."
                    : "لن يتم توزيع طلبات جديدة عليك خارج وقت الشفت."}
                </Text>
              </View>
            </View>

            <View style={styles.section}>
              <Text style={styles.sectionTitle}>
                شفت اليوم
              </Text>

              <View style={styles.dayCard}>
                <Ionicons
                  name="calendar-outline"
                  size={20}
                  color={appTheme.primaryColor}
                />

                <Text style={styles.dayText}>
                  {dayName}
                </Text>
              </View>

              <View style={styles.timeCard}>
                <View style={styles.timeItem}>
                  <View
                    style={[
                      styles.timeIcon,
                      {
                        backgroundColor:
                          `${appTheme.primaryColor}12`,
                      },
                    ]}
                  >
                    <Ionicons
                      name="log-in-outline"
                      size={21}
                      color={appTheme.primaryColor}
                    />
                  </View>

                  <View>
                    <Text style={styles.timeLabel}>
                      بداية الشفت
                    </Text>

                    <Text style={styles.timeValue}>
                      {start}
                    </Text>
                  </View>
                </View>

                <View style={styles.timeDivider} />

                <View style={styles.timeItem}>
                  <View
                    style={[
                      styles.timeIcon,
                      {
                        backgroundColor:
                          `${appTheme.dangerColor}10`,
                      },
                    ]}
                  >
                    <Ionicons
                      name="log-out-outline"
                      size={21}
                      color={appTheme.dangerColor}
                    />
                  </View>

                  <View>
                    <Text style={styles.timeLabel}>
                      نهاية الشفت
                    </Text>

                    <Text style={styles.timeValue}>
                      {end}
                    </Text>
                  </View>
                </View>
              </View>
            </View>

            <View style={styles.actions}>
              {insideShift && (
                <AppButton
                  title="بدء العمل"
                  onPress={startWork}
                  loading={busy}
                />
              )}

              <AppButton
                title="إنهاء العمل"
                secondary
                onPress={endWork}
                loading={busy}
              />
            </View>

            {!insideShift && (
              <View style={styles.warningCard}>
                <Ionicons
                  name="information-circle-outline"
                  size={22}
                  color={appTheme.warningColor}
                />

                <Text style={styles.warningText}>
                  لا يمكن استقبال الطلبات خارج وقت الشفت.
                </Text>
              </View>
            )}
          </>
        )}
      </View>
    </Screen>
  );
}

