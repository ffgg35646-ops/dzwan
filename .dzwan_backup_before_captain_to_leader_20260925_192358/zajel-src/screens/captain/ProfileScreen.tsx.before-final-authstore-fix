import React, { useEffect, useMemo, useState } from "react";
import {
  ActivityIndicator,
  Alert,
  Modal,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";

import Screen from "../../components/Screen";
import { useAppTheme } from "../../theme/useAppTheme";
import { getMyDocuments } from "../../api/captainDocuments";
import {
  changePassword,
  getMyProfile,
  requestEmailChange,
  verifyEmailChange,
} from "../../api/profile";

type CaptainDocument = {
  _id?: string;
  documentType?: string;
  documentNumber?: string;
  status?: string;
  expiresAt?: string | null;
  rejectionReason?: string | null;
  createdAt?: string;
};

type ProfileData = {
  id?: string;
  fullName?: string;
  phone?: string;
  email?: string | null;
  status?: string;
  governorateName?: string | null;
  areaName?: string | null;
};

const REQUIRED_DOCUMENTS = [
  { type: "id_front", label: "الهوية الأمامية" },
  { type: "id_back", label: "الهوية الخلفية" },
  { type: "residence_front", label: "الإقامة الأمامية" },
  { type: "residence_back", label: "الإقامة الخلفية" },
] as const;

const AVATARS: Array<{
  icon: keyof typeof Ionicons.glyphMap;
  background: string;
  foreground: string;
}> = [
  { icon: "bicycle", background: "#E0F2FE", foreground: "#0369A1" },
  { icon: "flash", background: "#FEF3C7", foreground: "#B45309" },
  { icon: "navigate", background: "#DCFCE7", foreground: "#15803D" },
  { icon: "rocket", background: "#EDE9FE", foreground: "#6D28D9" },
  { icon: "shield-checkmark", background: "#FCE7F3", foreground: "#BE185D" },
  { icon: "speedometer", background: "#F3E8FF", foreground: "#7E22CE" },
  { icon: "star", background: "#FFEDD5", foreground: "#C2410C" },
  { icon: "car-sport", background: "#CCFBF1", foreground: "#0F766E" },
  { icon: "map", background: "#DBEAFE", foreground: "#1D4ED8" },
  { icon: "sparkles", background: "#F1F5F9", foreground: "#334155" },
];

function avatarIndex(seed: string) {
  let hash = 0;

  for (let i = 0; i < seed.length; i += 1) {
    hash = (hash * 31 + seed.charCodeAt(i)) >>> 0;
  }

  return hash % AVATARS.length;
}

function latestDocument(
  documents: CaptainDocument[],
  type: string,
) {
  return documents
    .filter((item) => item.documentType === type)
    .sort((a, b) => {
      const aTime = new Date(a.createdAt || 0).getTime();
      const bTime = new Date(b.createdAt || 0).getTime();
      return bTime - aTime;
    })[0];
}

function documentState(document?: CaptainDocument) {
  if (!document) {
    return {
      label: "ناقصة",
      color: "#DC2626",
      icon: "alert-circle" as const,
    };
  }

  if (document.status === "rejected") {
    return {
      label: "مرفوضة",
      color: "#DC2626",
      icon: "close-circle" as const,
    };
  }

  if (document.status === "pending") {
    return {
      label: "قيد المراجعة",
      color: "#D97706",
      icon: "time" as const,
    };
  }

  if (
    document.status === "approved" &&
    document.expiresAt &&
    new Date(document.expiresAt).getTime() <= Date.now()
  ) {
    return {
      label: "منتهية",
      color: "#D97706",
      icon: "warning" as const,
    };
  }

  if (document.status === "approved") {
    return {
      label: "معتمدة",
      color: "#16A34A",
      icon: "checkmark-circle" as const,
    };
  }

  return {
    label: "قيد المراجعة",
    color: "#D97706",
    icon: "time" as const,
  };
}

function errorMessage(error: any, fallback: string) {
  return (
    error?.response?.data?.message ||
    error?.data?.message ||
    error?.message ||
    fallback
  );
}

export default function CaptainProfileScreen() {
  const appTheme = useAppTheme();
  const styles = createStyles(appTheme);

  const [profile, setProfile] = useState<ProfileData | null>(null);
  const [profileLoading, setProfileLoading] = useState(true);

  const [documents, setDocuments] = useState<CaptainDocument[]>([]);
  const [documentsLoading, setDocumentsLoading] = useState(true);

  const [emailModal, setEmailModal] = useState(false);
  const [emailStep, setEmailStep] = useState<"email" | "otp">("email");
  const [newEmail, setNewEmail] = useState("");
  const [emailOtp, setEmailOtp] = useState("");
  const [emailVerificationId, setEmailVerificationId] = useState("");
  const [emailBusy, setEmailBusy] = useState(false);

  const [passwordModal, setPasswordModal] = useState(false);
  const [currentPassword, setCurrentPassword] = useState("");
  const [newPassword, setNewPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [passwordBusy, setPasswordBusy] = useState(false);

  useEffect(() => {
    let mounted = true;

    async function load() {
      try {
        setProfileLoading(true);

        const result: any = await getMyProfile();
        const data = result?.user ?? result;

        if (mounted) {
          setProfile(data || null);
        }
      } catch (error) {
        if (mounted) {
          Alert.alert(
            "تعذر تحميل الحساب",
            errorMessage(error, "حدث خطأ أثناء تحميل بيانات الحساب."),
          );
        }
      } finally {
        if (mounted) {
          setProfileLoading(false);
        }
      }
    }

    void load();

    return () => {
      mounted = false;
    };
  }, []);

  useEffect(() => {
    let mounted = true;

    async function loadDocuments() {
      try {
        setDocumentsLoading(true);

        const response: any = await getMyDocuments();

        const list = Array.isArray(response)
          ? response
          : response?.documents ??
            response?.data?.documents ??
            [];

        if (mounted) {
          setDocuments(Array.isArray(list) ? list : []);
        }
      } catch {
        if (mounted) {
          setDocuments([]);
        }
      } finally {
        if (mounted) {
          setDocumentsLoading(false);
        }
      }
    }

    void loadDocuments();

    return () => {
      mounted = false;
    };
  }, []);

  const avatar = useMemo(() => {
    const seed =
      profile?.id ||
      profile?.phone ||
      profile?.email ||
      profile?.fullName ||
      "captain";

    return AVATARS[avatarIndex(seed)];
  }, [profile]);

  const completeDocuments = useMemo(
    () =>
      REQUIRED_DOCUMENTS.every((required) => {
        const document = latestDocument(
          documents,
          required.type,
        );

        return Boolean(
          document?.status === "approved" &&
            (!document.expiresAt ||
              new Date(document.expiresAt).getTime() >
                Date.now()),
        );
      }),
    [documents],
  );

  function openEmailModal() {
    setNewEmail("");
    setEmailOtp("");
    setEmailVerificationId("");
    setEmailStep("email");
    setEmailModal(true);
  }

  function closeEmailModal() {
    if (!emailBusy) {
      setEmailModal(false);
    }
  }

  async function sendEmailCode() {
    const email = newEmail.trim().toLowerCase();

    if (!email || !/^\S+@\S+\.\S+$/.test(email)) {
      Alert.alert("البريد الإلكتروني", "أدخل بريدًا إلكترونيًا صحيحًا.");
      return;
    }

    try {
      setEmailBusy(true);

      const result: any = await requestEmailChange(email);
      const verificationId =
        result?.verificationId ||
        result?.data?.verificationId;

      if (!verificationId) {
        throw new Error("لم يتم إنشاء طلب التحقق.");
      }

      setEmailVerificationId(String(verificationId));
      setEmailStep("otp");

      Alert.alert(
        "تم إرسال الكود",
        "تم إرسال كود التحقق إلى البريد الإلكتروني الجديد.",
      );
    } catch (error) {
      Alert.alert(
        "تعذر إرسال الكود",
        errorMessage(error, "تعذر إرسال كود التحقق."),
      );
    } finally {
      setEmailBusy(false);
    }
  }

  async function confirmEmailCode() {
    const otp = emailOtp.trim();

    if (!emailVerificationId || !otp) {
      Alert.alert("كود التحقق", "أدخل كود التحقق.");
      return;
    }

    try {
      setEmailBusy(true);

      await verifyEmailChange(
        emailVerificationId,
        otp,
      );

      setProfile((current) =>
        current
          ? {
              ...current,
              email: newEmail.trim().toLowerCase(),
            }
          : current,
      );

      setEmailModal(false);

      Alert.alert(
        "تم بنجاح",
        "تم تغيير البريد الإلكتروني بنجاح.",
      );
    } catch (error) {
      Alert.alert(
        "تعذر التحقق",
        errorMessage(error, "كود التحقق غير صحيح."),
      );
    } finally {
      setEmailBusy(false);
    }
  }

  async function submitPasswordChange() {
    if (!currentPassword || !newPassword || !confirmPassword) {
      Alert.alert(
        "كلمة المرور",
        "املأ جميع خانات كلمة المرور.",
      );
      return;
    }

    if (newPassword.length < 6) {
      Alert.alert(
        "كلمة المرور",
        "كلمة المرور الجديدة يجب ألا تقل عن 6 أحرف.",
      );
      return;
    }

    if (newPassword !== confirmPassword) {
      Alert.alert(
        "كلمة المرور",
        "تأكيد كلمة المرور غير مطابق.",
      );
      return;
    }

    try {
      setPasswordBusy(true);

      await changePassword({
        currentPassword,
        newPassword,
        confirmPassword,
      });

      setPasswordModal(false);
      setCurrentPassword("");
      setNewPassword("");
      setConfirmPassword("");

      Alert.alert(
        "تم بنجاح",
        "تم تغيير كلمة المرور بنجاح.",
      );
    } catch (error) {
      Alert.alert(
        "تعذر تغيير كلمة المرور",
        errorMessage(
          error,
          "تعذر تغيير كلمة المرور.",
        ),
      );
    } finally {
      setPasswordBusy(false);
    }
  }

  if (profileLoading) {
    return (
      <Screen>
        <View style={styles.loadingPage}>
          <ActivityIndicator
            size="large"
            color={appTheme.primaryColor}
          />
          <Text style={styles.loadingText}>
            جاري تحميل الملف الشخصي...
          </Text>
        </View>
      </Screen>
    );
  }

  const name = profile?.fullName || "الكابتن";
  const phone = profile?.phone || "—";
  const email = profile?.email || "غير مضاف";
  const avatarSeed =
    profile?.id ||
    profile?.phone ||
    profile?.email ||
    name;

  return (
    <Screen>
      <ScrollView
        showsVerticalScrollIndicator={false}
        contentContainerStyle={styles.content}
      >
        <View style={styles.heading}>
          <View style={styles.headingIcon}>
            <Ionicons
              name="person-outline"
              size={21}
              color={appTheme.primaryColor}
            />
          </View>

          <View style={styles.headingText}>
            <Text style={styles.eyebrow}>زاجل ديلفري</Text>
            <Text style={styles.title}>حسابي</Text>
          </View>
        </View>

        <View style={styles.hero}>
          <View
            style={[
              styles.avatar,
              { backgroundColor: avatar.background },
            ]}
          >
            <Ionicons
              name={avatar.icon}
              size={40}
              color={avatar.foreground}
            />
          </View>

          <View style={styles.heroText}>
            <Text style={styles.heroName}>{name}</Text>

            <View style={styles.heroBadge}>
              <Ionicons
                name="bicycle-outline"
                size={14}
                color="#CCFBF1"
              />
              <Text style={styles.heroBadgeText}>
                كابتن توصيل
              </Text>
            </View>
          </View>
        </View>

        <SectionTitle
          icon="person-circle-outline"
          title="البيانات الأساسية"
          styles={styles}
        />

        <View style={styles.card}>
          <LockedRow
            icon="person-outline"
            label="الاسم"
            value={name}
            styles={styles}
          />

          <LockedRow
            icon="call-outline"
            label="رقم الهاتف"
            value={phone}
            styles={styles}
          />

          <LockedRow
            icon="location-outline"
            label="المحافظة"
            value={
              profile?.governorateName ||
              "غير متوفرة"
            }
            styles={styles}
          />

          <LockedRow
            icon="map-outline"
            label="المنطقة"
            value={
              profile?.areaName ||
              "غير متوفرة"
            }
            styles={styles}
            last
          />
        </View>

        <SectionTitle
          icon="shield-checkmark-outline"
          title="أمان الحساب"
          styles={styles}
        />

        <View style={styles.card}>
          <ActionRow
            icon="mail-outline"
            label="البريد الإلكتروني"
            value={email}
            buttonText="تغيير"
            onPress={openEmailModal}
            styles={styles}
          />

          <ActionRow
            icon="lock-closed-outline"
            label="كلمة المرور"
            value="••••••••"
            buttonText="تغيير"
            onPress={() => setPasswordModal(true)}
            styles={styles}
            last
          />
        </View>

        <View style={styles.readonlyNotice}>
          <View style={styles.noticeIcon}>
            <Ionicons
              name="lock-closed-outline"
              size={18}
              color={appTheme.primaryColor}
            />
          </View>

          <Text style={styles.noticeText}>
            الاسم والمحافظة والمنطقة ورقم الهاتف بيانات مرتبطة بالتسجيل ولا يمكن تعديلها من التطبيق.
          </Text>
        </View>

        <SectionTitle
          icon="document-text-outline"
          title="وثائق الكابتن"
          styles={styles}
        />

        {documentsLoading ? (
          <View style={styles.documentsLoading}>
            <ActivityIndicator
              size="small"
              color={appTheme.primaryColor}
            />
            <Text style={styles.loadingText}>
              جاري التحقق من الوثائق...
            </Text>
          </View>
        ) : (
          <>
            {REQUIRED_DOCUMENTS.map((required) => {
              const document = latestDocument(
                documents,
                required.type,
              );

              const state = documentState(document);

              return (
                <View
                  key={required.type}
                  style={styles.documentRow}
                >
                  <View style={styles.documentInfo}>
                    <Text style={styles.documentTitle}>
                      {required.label}
                    </Text>

                    <Text style={styles.documentNumber}>
                      {document?.documentNumber
                        ? `رقم الوثيقة: ${document.documentNumber}`
                        : "لا توجد وثيقة معتمدة حاليًا"}
                    </Text>

                    {document?.rejectionReason ? (
                      <Text style={styles.documentReason}>
                        سبب الرفض:{" "}
                        {document.rejectionReason}
                      </Text>
                    ) : null}
                  </View>

                  <View
                    style={[
                      styles.documentStatus,
                      {
                        backgroundColor:
                          state.color + "14",
                      },
                    ]}
                  >
                    <Ionicons
                      name={state.icon}
                      size={17}
                      color={state.color}
                    />

                    <Text
                      style={[
                        styles.documentStatusText,
                        { color: state.color },
                      ]}
                    >
                      {state.label}
                    </Text>
                  </View>
                </View>
              );
            })}

            <View
              style={[
                styles.documentsNotice,
                {
                  backgroundColor: completeDocuments
                    ? "#16A34A12"
                    : "#DC262612",
                },
              ]}
            >
              <Ionicons
                name={
                  completeDocuments
                    ? "checkmark-circle-outline"
                    : "warning-outline"
                }
                size={21}
                color={
                  completeDocuments
                    ? "#16A34A"
                    : "#DC2626"
                }
              />

              <Text
                style={[
                  styles.documentsNoticeText,
                  {
                    color: completeDocuments
                      ? "#16A34A"
                      : "#DC2626",
                  },
                ]}
              >
                {completeDocuments
                  ? "جميع الوثائق المطلوبة معتمدة وصالحة."
                  : "يوجد نقص أو مشكلة في الوثائق. قد يتم منعك من استلام الطلبات حتى اكتمال الوثائق واعتمادها."}
              </Text>
            </View>
          </>
        )}

        <View style={styles.footerSpace} />
      </ScrollView>

      <Modal
        visible={emailModal}
        transparent
        animationType="fade"
        onRequestClose={closeEmailModal}
      >
        <View style={styles.modalBackdrop}>
          <View style={styles.modalCard}>
            <View style={styles.modalHeader}>
              <View style={styles.modalHeaderIcon}>
                <Ionicons
                  name="mail-outline"
                  size={21}
                  color={appTheme.primaryColor}
                />
              </View>

              <View style={styles.modalHeaderText}>
                <Text style={styles.modalTitle}>
                  تغيير البريد الإلكتروني
                </Text>
                <Text style={styles.modalSubtitle}>
                  {emailStep === "email"
                    ? "أدخل البريد الإلكتروني الجديد"
                    : "أدخل الكود المرسل إلى البريد الجديد"}
                </Text>
              </View>
            </View>

            {emailStep === "email" ? (
              <>
                <Field
                  label="البريد الإلكتروني الجديد"
                  value={newEmail}
                  onChangeText={setNewEmail}
                  placeholder="example@gmail.com"
                  keyboardType="email-address"
                  autoCapitalize="none"
                  icon="mail-outline"
                  editable={!emailBusy}
                  styles={styles}
                />

                <ModalButton
                  title={
                    emailBusy
                      ? "جاري الإرسال..."
                      : "إرسال كود التحقق"
                  }
                  icon="send-outline"
                  onPress={sendEmailCode}
                  disabled={emailBusy}
                  styles={styles}
                />
              </>
            ) : (
              <>
                <View style={styles.otpHint}>
                  <Ionicons
                    name="shield-checkmark-outline"
                    size={20}
                    color={appTheme.primaryColor}
                  />
                  <Text style={styles.otpHintText}>
                    تم إرسال كود من 6 أرقام إلى:
                    {"\n"}
                    {newEmail}
                  </Text>
                </View>

                <Field
                  label="كود التحقق"
                  value={emailOtp}
                  onChangeText={(value) =>
                    setEmailOtp(
                      value.replace(/\D/g, ""),
                    )
                  }
                  placeholder="000000"
                  keyboardType="number-pad"
                  icon="keypad-outline"
                  editable={!emailBusy}
                  maxLength={6}
                  styles={styles}
                />

                <ModalButton
                  title={
                    emailBusy
                      ? "جاري التأكيد..."
                      : "تأكيد تغيير البريد"
                  }
                  icon="checkmark-circle-outline"
                  onPress={confirmEmailCode}
                  disabled={emailBusy}
                  styles={styles}
                />

                <Pressable
                  onPress={sendEmailCode}
                  disabled={emailBusy}
                  style={styles.secondaryButton}
                >
                  <Text style={styles.secondaryButtonText}>
                    إعادة إرسال الكود
                  </Text>
                </Pressable>
              </>
            )}

            <Pressable
              onPress={closeEmailModal}
              disabled={emailBusy}
              style={styles.cancelButton}
            >
              <Text style={styles.cancelButtonText}>
                إلغاء
              </Text>
            </Pressable>
          </View>
        </View>
      </Modal>

      <Modal
        visible={passwordModal}
        transparent
        animationType="fade"
        onRequestClose={() =>
          !passwordBusy && setPasswordModal(false)
        }
      >
        <View style={styles.modalBackdrop}>
          <View style={styles.modalCard}>
            <View style={styles.modalHeader}>
              <View style={styles.modalHeaderIcon}>
                <Ionicons
                  name="lock-closed-outline"
                  size={21}
                  color={appTheme.primaryColor}
                />
              </View>

              <View style={styles.modalHeaderText}>
                <Text style={styles.modalTitle}>
                  تغيير كلمة المرور
                </Text>
                <Text style={styles.modalSubtitle}>
                  أدخل كلمة المرور الحالية ثم الجديدة
                </Text>
              </View>
            </View>

            <Field
              label="كلمة المرور الحالية"
              value={currentPassword}
              onChangeText={setCurrentPassword}
              placeholder="أدخل كلمة المرور الحالية"
              secureTextEntry
              icon="lock-closed-outline"
              editable={!passwordBusy}
              styles={styles}
            />

            <Field
              label="كلمة المرور الجديدة"
              value={newPassword}
              onChangeText={setNewPassword}
              placeholder="6 أحرف على الأقل"
              secureTextEntry
              icon="key-outline"
              editable={!passwordBusy}
              styles={styles}
            />

            <Field
              label="تأكيد كلمة المرور الجديدة"
              value={confirmPassword}
              onChangeText={setConfirmPassword}
              placeholder="أعد كتابة كلمة المرور"
              secureTextEntry
              icon="checkmark-done-outline"
              editable={!passwordBusy}
              styles={styles}
            />

            <ModalButton
              title={
                passwordBusy
                  ? "جاري الحفظ..."
                  : "حفظ كلمة المرور الجديدة"
              }
              icon="checkmark-circle-outline"
              onPress={submitPasswordChange}
              disabled={passwordBusy}
              styles={styles}
            />

            <Pressable
              onPress={() =>
                !passwordBusy && setPasswordModal(false)
              }
              disabled={passwordBusy}
              style={styles.cancelButton}
            >
              <Text style={styles.cancelButtonText}>
                إلغاء
              </Text>
            </Pressable>
          </View>
        </View>
      </Modal>
    </Screen>
  );
}

function SectionTitle({
  icon,
  title,
  styles,
}: {
  icon: keyof typeof Ionicons.glyphMap;
  title: string;
  styles: ReturnType<typeof createStyles>;
}) {
  return (
    <View style={styles.sectionTitleRow}>
      <View style={styles.sectionTitleIcon}>
        <Ionicons
          name={icon}
          size={18}
          color={styles.sectionTitleIconColor.color as string}
        />
      </View>
      <Text style={styles.sectionTitle}>
        {title}
      </Text>
    </View>
  );
}

function LockedRow({
  icon,
  label,
  value,
  styles,
  last = false,
}: {
  icon: keyof typeof Ionicons.glyphMap;
  label: string;
  value: string;
  styles: ReturnType<typeof createStyles>;
  last?: boolean;
}) {
  return (
    <View
      style={[
        styles.infoRow,
        !last && styles.infoRowBorder,
      ]}
    >
      <View style={styles.rowIcon}>
        <Ionicons
          name={icon}
          size={19}
          color={styles.rowIconColor.color as string}
        />
      </View>

      <View style={styles.rowContent}>
        <Text style={styles.rowLabel}>{label}</Text>
        <Text style={styles.rowValue}>{value}</Text>
      </View>

    </View>
  );
}

function ActionRow({
  icon,
  label,
  value,
  buttonText,
  onPress,
  styles,
  last = false,
}: {
  icon: keyof typeof Ionicons.glyphMap;
  label: string;
  value: string;
  buttonText: string;
  onPress: () => void;
  styles: ReturnType<typeof createStyles>;
  last?: boolean;
}) {
  return (
    <View
      style={[
        styles.infoRow,
        !last && styles.infoRowBorder,
      ]}
    >
      <View style={styles.rowIcon}>
        <Ionicons
          name={icon}
          size={19}
          color={styles.rowIconColor.color as string}
        />
      </View>

      <View style={styles.rowContent}>
        <Text style={styles.rowLabel}>{label}</Text>
        <Text style={styles.rowValue}>{value}</Text>
      </View>

      <Pressable
        onPress={onPress}
        style={({ pressed }) => [
          styles.changeButton,
          pressed && styles.buttonPressed,
        ]}
      >
        <Text style={styles.changeButtonText}>
          {buttonText}
        </Text>
      </Pressable>
    </View>
  );
}

function Field({
  label,
  value,
  onChangeText,
  placeholder,
  icon,
  styles,
  secureTextEntry = false,
  keyboardType = "default",
  autoCapitalize = "sentences",
  editable = true,
  maxLength,
}: {
  label: string;
  value: string;
  onChangeText: (value: string) => void;
  placeholder: string;
  icon: keyof typeof Ionicons.glyphMap;
  styles: ReturnType<typeof createStyles>;
  secureTextEntry?: boolean;
  keyboardType?: any;
  autoCapitalize?: any;
  editable?: boolean;
  maxLength?: number;
}) {
  return (
    <View style={styles.fieldWrap}>
      <Text style={styles.fieldLabel}>{label}</Text>

      <View style={styles.inputWrap}>
        <View style={styles.inputIcon}>
          <Ionicons
            name={icon}
            size={18}
            color={styles.rowIconColor.color as string}
          />
        </View>

        <TextInput
          value={value}
          onChangeText={onChangeText}
          placeholder={placeholder}
          placeholderTextColor="#94A3B8"
          secureTextEntry={secureTextEntry}
          keyboardType={keyboardType}
          autoCapitalize={autoCapitalize}
          editable={editable}
          maxLength={maxLength}
          style={styles.input}
          textAlign="right"
        />
      </View>
    </View>
  );
}

function ModalButton({
  title,
  icon,
  onPress,
  disabled,
  styles,
}: {
  title: string;
  icon: keyof typeof Ionicons.glyphMap;
  onPress: () => void;
  disabled?: boolean;
  styles: ReturnType<typeof createStyles>;
}) {
  return (
    <Pressable
      onPress={onPress}
      disabled={disabled}
      style={({ pressed }) => [
        styles.primaryButton,
        pressed && styles.buttonPressed,
        disabled && styles.buttonDisabled,
      ]}
    >
      <Ionicons
        name={icon}
        size={18}
        color="#FFFFFF"
      />
      <Text style={styles.primaryButtonText}>
        {title}
      </Text>
    </Pressable>
  );
}

