import React, { useState } from "react";
import {
  Alert,
  StyleSheet,
  Text,
  View,
} from "react-native";
import {
  useNavigation,
  useRoute,
} from "@react-navigation/native";
import { Ionicons } from "@expo/vector-icons";

import Screen from "../../components/Screen";
import AppButton from "../../components/AppButton";
import PhotoPickerButton from "../../components/PhotoPickerButton";
import { useAppTheme } from "../../theme/useAppTheme";
import { submitPickupPhoto } from "../../api/captainOrder";
import { updateOrderStatus } from "../../api/orders";

export default function PickupScreen() {
  const appTheme = useAppTheme();
  const styles = createStyles(appTheme);
  const navigation = useNavigation<any>();
  const route = useRoute<any>();

  const orderId = String(route.params?.orderId || "");

  const [photo, setPhoto] = useState<string | null>(null);
  const [busy, setBusy] = useState(false);

  async function submit() {
    if (!orderId) {
      Alert.alert("طلب غير صالح", "تعذر تحديد رقم الطلب.");
      return;
    }

    setBusy(true);

    try {
      if (photo) {
        await submitPickupPhoto(orderId, photo);
      }

      await updateOrderStatus(orderId, "picked_up");

      Alert.alert(
        "تم استلام الطلب",
        "تم تسجيل استلام الطلب بنجاح."
      );

      navigation.goBack();
    } catch (error: any) {
      Alert.alert(
        "تعذر الاستلام",
        error?.response?.data?.message ||
          "تعذر تسجيل استلام الطلب."
      );
    } finally {
      setBusy(false);
    }
  }

  return (
    <Screen>
      <View style={styles.container}>
        <View style={styles.header}>
          <View
            style={[
              styles.headerIcon,
              {
                backgroundColor: `${appTheme.primaryColor}12`,
              },
            ]}
          >
            <Ionicons
              name="cube-outline"
              size={28}
              color={appTheme.primaryColor}
            />
          </View>

          <View style={styles.headerText}>
            <Text style={styles.eyebrow}>المرحلة الحالية</Text>
            <Text style={styles.title}>استلام الطلب</Text>
          </View>
        </View>

        <View style={styles.progress}>
          <View style={styles.progressStep}>
            <View
              style={[
                styles.progressDot,
                {
                  backgroundColor: appTheme.primaryColor,
                },
              ]}
            >
              <Ionicons
                name="checkmark"
                size={14}
                color={appTheme.surfaceColor}
              />
            </View>
            <Text style={styles.progressText}>تم التعيين</Text>
          </View>

          <View
            style={[
              styles.progressLine,
              {
                backgroundColor: appTheme.primaryColor,
              },
            ]}
          />

          <View style={styles.progressStep}>
            <View
              style={[
                styles.progressDot,
                {
                  backgroundColor: appTheme.primaryColor,
                },
              ]}
            >
              <Ionicons
                name="cube"
                size={14}
                color={appTheme.surfaceColor}
              />
            </View>
            <Text style={styles.progressText}>الاستلام</Text>
          </View>

          <View
            style={[
              styles.progressLine,
              {
                backgroundColor: appTheme.borderColor,
              },
            ]}
          />

          <View style={styles.progressStep}>
            <View
              style={[
                styles.progressDot,
                {
                  backgroundColor: appTheme.borderColor,
                },
              ]}
            >
              <Ionicons
                name="navigate-outline"
                size={14}
                color={appTheme.secondaryTextColor}
              />
            </View>
            <Text style={styles.progressTextMuted}>التوصيل</Text>
          </View>
        </View>

        <View style={styles.infoCard}>
          <View
            style={[
              styles.infoIcon,
              {
                backgroundColor: `${appTheme.infoColor}12`,
              },
            ]}
          >
            <Ionicons
              name="information-circle-outline"
              size={24}
              color={appTheme.infoColor}
            />
          </View>

          <View style={styles.infoContent}>
            <Text style={styles.infoTitle}>
              قبل تأكيد الاستلام
            </Text>
            <Text style={styles.infoText}>
              تأكد من استلام الطلب من المحل. يمكنك إضافة صورة
              للطلب كإثبات للاستلام قبل التأكيد.
            </Text>
          </View>
        </View>

        <View style={styles.photoCard}>
          <View style={styles.cardHeader}>
            <View
              style={[
                styles.cardIcon,
                {
                  backgroundColor: `${appTheme.primaryColor}12`,
                },
              ]}
            >
              <Ionicons
                name="camera-outline"
                size={22}
                color={appTheme.primaryColor}
              />
            </View>

            <View style={styles.cardHeaderText}>
              <Text style={styles.cardTitle}>صورة الاستلام</Text>
              <Text style={styles.cardSubtitle}>
                اختياري حسب حالة الطلب
              </Text>
            </View>
          </View>

          <PhotoPickerButton
            title={
              photo
                ? "إعادة تصوير الطلب"
                : "تصوير الطلب"
            }
            onSelected={setPhoto}
            secondary
          />

          {photo && (
            <View style={styles.selected}>
              <Ionicons
                name="checkmark-circle"
                size={18}
                color={appTheme.successColor}
              />
              <Text style={styles.selectedText}>
                تم اختيار صورة الاستلام
              </Text>
            </View>
          )}
        </View>

        <View style={styles.footer}>
          <AppButton
            title="تأكيد استلام الطلب"
            onPress={submit}
            loading={busy}
          />

          <Text style={styles.footerHint}>
            بعد التأكيد سينتقل الطلب إلى مرحلة التوصيل.
          </Text>
        </View>
      </View>
    </Screen>
  );
}

