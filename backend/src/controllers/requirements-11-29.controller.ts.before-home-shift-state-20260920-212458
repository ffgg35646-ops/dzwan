export async function workAreas(
  req: Request,
  res: Response
) {
  try {
    const result =
      await getCaptainWorkAreas(
        String(req.params.captainId)
      );

    const workAreas = [];

    for (const item of result) {
      const location =
        await LocationModel.findById(
          item.governorateId
        ).lean();

      const area = location?.areas?.find(
        (area: any) =>
          String(area._id) ===
          String(item.areaId)
      );

      workAreas.push({
        ...item,
        governorateName:
          location?.name ?? null,
        areaName:
          area?.name ?? null,
        governorateActive:
          location?.isActive ?? false,
        captainsEnabled:
          location?.captainsEnabled ?? false,
        areaActive:
          area?.isActive ?? false,
        areaCaptainsEnabled:
          area?.captainsEnabled ?? false,
      });
    }

    res.json({
      success: true,
      workAreas,
    });
  } catch (e) {
    return error(res, e);
  }
}

