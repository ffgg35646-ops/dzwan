function actor(req: Request) {
  return (req as any).user?.sub || null;
}

function error(res: Response, e: any) {
  const message =
    e?.message ||
    "OPERATION_FAILED";

  const map: Record<string, number> = {
    CAPTAIN_OUTSIDE_SHIFT: 403,
    CAPTAIN_ACTIVE_ORDER_LIMIT_REACHED: 409,
    ALREADY_CLOCKED_IN: 409,
    NOT_CLOCKED_IN: 409,
    INVALID_RATING: 400,
  };

  return res.status(
    map[message] || 400
  ).json({
    success: false,
    error: message,
  });
}

export async function shiftCheck(
  req: any,
  res: any,
) {
  try {
    const captainId = String(
      req.user?.sub || "",
    );

    if (!captainId) {
      return res.status(401).json({
        insideShift: false,
        assignment: null,
        shift: null,
        message: "غير مصرح.",
      });
    }

    const now = new Date();

    // بداية الأسبوع = الاثنين 00:00
    const weekStart = new Date(now);
    const day = weekStart.getDay();
    const diff = day === 0 ? -6 : 1 - day;

    weekStart.setDate(
      weekStart.getDate() + diff,
    );
    weekStart.setHours(0, 0, 0, 0);

    const weekEnd = new Date(weekStart);
    weekEnd.setDate(
      weekEnd.getDate() + 7,
    );

    // الاختيار الأسبوعي للكابتن
    const assignment =
      await CaptainShiftModel.findOne({
        captainId,
        shiftId: {
          $exists: true,
          $ne: null,
        },
        weekStart: {
          $gte: weekStart,
          $lt: weekEnd,
        },
      })
        .select(
          "_id captainId shiftId weekStart changedAt changeCount",
        )
        .lean();

    // لم يختر الكابتن شفت هذا الأسبوع
    if (!assignment?.shiftId) {
      return res.json({
        insideShift: false,
        start: null,
        end: null,
        shift: null,
        assignment: null,
        shifts: [],
        message:
          "لم يتم اختيار شفت هذا الأسبوع.",
      });
    }

    // الشفت الأساسي الذي اختاره الكابتن
    const selectedShift =
      await CaptainShiftModel.findOne({
        _id: assignment.shiftId,
        isActive: true,
      })
        .select(
          "_id startTime endTime isActive",
        )
        .lean();

    if (!selectedShift) {
      return res.json({
        insideShift: false,
        start: null,
        end: null,
        shift: null,
        assignment: null,
        shifts: [],
        message:
          "الشفت المختار غير متاح حاليًا.",
      });
    }

    const toMinutes = (
      value: string,
    ) => {
      const [hour, minute] =
        String(value)
          .split(":")
          .map(Number);

      if (
        !Number.isFinite(hour) ||
        !Number.isFinite(minute)
      ) {
        return -1;
      }

      return hour * 60 + minute;
    };

    const current =
      now.getHours() * 60 +
      now.getMinutes();

    const start = toMinutes(
      String(selectedShift.startTime),
    );

    const end = toMinutes(
      String(selectedShift.endTime),
    );

    let insideShift = false;

    if (start >= 0 && end >= 0) {
      if (start === end) {
        insideShift = true;
      } else if (start < end) {
        insideShift =
          current >= start &&
          current < end;
      } else {
        // شفت يمتد بعد منتصف الليل
        insideShift =
          current >= start ||
          current < end;
      }
    }

    return res.json({
      insideShift,
      withinShift: insideShift,
      allowed: insideShift,

      start: selectedShift.startTime,
      end: selectedShift.endTime,

      // الشفت المختار فعليًا
      shift: selectedShift,

      // مهم جدًا للـHome:
      // هذا هو الاختيار الأسبوعي نفسه
      assignment: {
        _id: assignment._id,
        captainId: assignment.captainId,
        shiftId: selectedShift,
        weekStart: assignment.weekStart,
        changedAt: assignment.changedAt,
        changeCount:
          assignment.changeCount || 1,
      },

      shifts: [selectedShift],
    });
  } catch (error: any) {
    console.error(
      "shiftCheck error:",
      error,
    );

    return res.status(500).json({
      insideShift: false,
      assignment: null,
      shift: null,
      message:
        error?.message ||
        "تعذر تحميل حالة الشفت.",
    });
  }
}

