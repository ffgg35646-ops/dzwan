export async function checkCurrentShift(
  req: Request,
  res: Response
) {
  try {
    const captainId = String(
      (req as any).user?.sub ||
      req.params?.captainId ||
      ""
    );

    const result =
      await assertCaptainInsideShift(
        captainId
      );

    return res.json({
      success: true,
      data: {
        allowed: true,
        assignment:
          result.assignment,
        shift:
          result.shift,
      },
    });
  } catch (error: any) {
    return res.status(403).json({
      success: false,
      allowed: false,
      message:
        error?.message ||
        "الكابتن خارج الشفت",
    });
  }
}
