function oid(value: string) {
  return Types.ObjectId.isValid(value)
    ? new Types.ObjectId(value)
    : null;
}

function period(req: AuthenticatedRequest) {
  const to =
    req.query.to
      ? new Date(String(req.query.to))
      : new Date();

  const from =
    req.query.from
      ? new Date(String(req.query.from))
      : new Date(
          to.getTime() -
            30 * 24 * 60 * 60 * 1000,
        );

  return { from, to };
}

