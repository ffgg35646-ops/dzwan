export async function captainRatingSummaries(
  req: AuthenticatedRequest,
  res: Response,
) {
  try {
    const [captains, summaryRows] =
      await Promise.all([
        UserModel.find({
          role: "captain",
        })
          .select("_id fullName phone")
          .sort({ fullName: 1 })
          .lean(),

        CaptainRatingFinalModel.aggregate([
          {
            $group: {
              _id: "$captainId",
              total: { $sum: 1 },
              average: { $avg: "$stars" },
            },
          },
        ]),
      ]);

    const summaryMap = new Map(
      summaryRows.map((row: any) => [
        String(row._id),
        {
          total: Number(row.total || 0),
          average: Number(
            Number(row.average || 0).toFixed(2),
          ),
        },
      ]),
    );

    return res.json({
      captains: captains.map((captain: any) => {
        const summary =
          summaryMap.get(String(captain._id)) || {
            total: 0,
            average: 0,
          };

        return {
          _id: String(captain._id),
          name: captain.fullName || "كابتن",
          phone: captain.phone || "—",
          total: summary.total,
          average: summary.average,
        };
      }),
    });
  } catch (error) {
    return res.status(400).json({
      message:
        error instanceof Error
          ? error.message
          : "تعذر تحميل تقييمات الكباتن.",
    });
  }
}

