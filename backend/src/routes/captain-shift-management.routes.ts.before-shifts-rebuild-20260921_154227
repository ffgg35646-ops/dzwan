import { Router } from "express";
import {
  requireAuth,
  requireAdmin,
} from "../middleware/auth.middleware.js";

import {
  createShift,
  listAvailableShifts,
  updateShift,
  selectWeeklyShift,
  changeWeeklyShift,
  checkCurrentShift,
} from "../controllers/captain-shift-management.controller.js";

const router = Router();

router.post(
  "/",
  requireAdmin,
  createShift
);

router.patch(
  "/:id",
  requireAdmin,
  updateShift
);

router.get(
  "/available",
  requireAuth,
  listAvailableShifts
);

router.post(
  "/weekly/select",
  requireAuth,
  selectWeeklyShift
);

router.post(
  "/weekly/change",
  requireAuth,
  changeWeeklyShift
);

router.get(
  "/current/check",
  requireAuth,
  checkCurrentShift
);

export default router;
