
import { Schema, model, Document } from "mongoose";

export type OfferAudience =
  | "all"
  | "captains"
  | "establishments";

export interface IOffer extends Document {
  title: string;
  description?: string;
  imageUrl?: string;

  audience: OfferAudience;

  startsAt: Date;
  endsAt: Date;

  isActive: boolean;
}

const schema = new Schema<IOffer>(
  {
    title: {
      type: String,
      required: true,
      trim: true,
    },

    description: String,
    imageUrl: String,

    audience: {
      type: String,
      enum: [
        "all",
        "captains",
        "establishments",
      ],
      default: "all",
    },

    startsAt: {
      type: Date,
      required: true,
    },

    endsAt: {
      type: Date,
      required: true,
    },

    isActive: {
      type: Boolean,
      default: true,
    },
  },
  {
    timestamps: true,
  },
);

export default model<IOffer>(
  "Offer",
  schema,
);
