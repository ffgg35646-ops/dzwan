{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "admin/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "framework": "node",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "entrypoint": "src/server.mts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "admin"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/internal/cron/run",
      "schedule": "*/5 * * * *"
    }
  ]
}
