{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "admin/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "framework": "express",
      "installCommand": "npm install --include=dev",
      "buildCommand": "npm install --include=prod",
      "entrypoint": "src/server.mts"
    },
    "web": {
      "root": "zajel-web/",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "zajel-web-debug.vercel.app"
        }
      ],
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "admin"
      }
    }
  ]
}
