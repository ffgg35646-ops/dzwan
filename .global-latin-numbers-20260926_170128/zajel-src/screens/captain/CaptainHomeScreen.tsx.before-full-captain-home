  const insideShift = Boolean(
    shift?.insideShift ??
      shift?.withinShift ??
      shift?.allowed,
  );

  const currentShift = shift?.shift || shift;

  const shiftStart =
    currentShift?.startTime ||
    currentShift?.start ||
    "--:--";

  const shiftEnd =
    currentShift?.endTime ||
    currentShift?.end ||
    "--:--";

  const captainName =
    user?.name?.trim() || "الكابتن";

  const areaName =
    workArea?.areaName ||
    workArea?.area?.name ||
    workArea?.name ||
    "منطقتك الحالية";

  async function loadGps() {
    try {
      const permission =
        await Location.requestForegroundPermissionsAsync();

      if (!permission.granted) {
        return;
      }

      const current =
        await Location.getCurrentPositionAsync({
          accuracy: Location.Accuracy.High,
        });

      const nextLocation = {
        latitude: current.coords.latitude,
        longitude: current.coords.longitude,
      };

      setLocation(nextLocation);

      return nextLocation;
    } catch {
      return null;
    }
  }

  async function loadData() {
    try {
      const [
        capacityResult,
        shiftResult,
        workAreasResult,
        attendanceResult,
      ] = await Promise.all([
        user?.id
          ? getCaptainCapacity(user.id)
          : Promise.resolve(null),

        checkShift(),

        user?.id
          ? getMyWorkAreas()
          : Promise.resolve(null),

        getAttendanceHistory().catch(() => null),
      ]);

      setCapacity(capacityResult);
      setShift(shiftResult);
      setAttendance(attendanceResult);

      const areas =
        workAreasResult?.workAreas ||
        workAreasResult?.areas ||
        [];

      setWorkArea(
        Array.isArray(areas)
          ? areas[0] || null
          : null,
      );

      const availableOrders =
        getOrders(capacityResult);

      const firstOrder =
        availableOrders.find((order) =>
          [
            "assigned",
            "heading_to_shop",
            "arrived_at_shop",
            "picked_up",
            "on_the_way",
          ].includes(order?.status || ""),
        ) || availableOrders[0];

      setCustomerLocation(
        getCustomerCoordinate(firstOrder),
      );

      const gps = await loadGps();

      if (
        gps &&
        getCustomerCoordinate(firstOrder)
      ) {
        await buildRoute(
          gps,
          getCustomerCoordinate(firstOrder)!,
        );
      }
    } catch (error: any) {
      console.log(
        "CAPTAIN HOME LOAD ERROR:",
        error?.message || error,
      );
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }

  async function buildRoute(
    from: Coordinate,
    to: Coordinate,
  ) {
    try {
      const url =
        "https://router.project-osrm.org/route/v1/driving/" +
        `${from.longitude},${from.latitude};` +
        `${to.longitude},${to.latitude}` +
        "?overview=full&geometries=geojson";

      const response = await fetch(url);

      if (!response.ok) {
        setRoute([]);
        setEtaMinutes(null);
        return;
      }

      const data = await response.json();
      const routeData = data?.routes?.[0];

      if (!routeData) {
        setRoute([]);
        setEtaMinutes(null);
        return;
      }

      const coordinates =
        routeData?.geometry?.coordinates || [];

      setRoute(
        coordinates.map(
          ([longitude, latitude]: [
            number,
            number,
          ]) => ({
            latitude,
            longitude,
          }),
        ),
      );

      if (Number.isFinite(routeData.duration)) {
        setEtaMinutes(
          Math.max(
            1,
            Math.round(routeData.duration / 60),
          ),
        );
      }
    } catch {
      setRoute([]);
      setEtaMinutes(null);
    }
  }

  useEffect(() => {
    void loadData();
  }, [user?.id]);

  useEffect(() => {
    if (!location || !customerLocation) {
      return;
    }

    void buildRoute(
      location,
      customerLocation,
    );
