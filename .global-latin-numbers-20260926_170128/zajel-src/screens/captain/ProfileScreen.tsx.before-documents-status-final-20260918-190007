import React from "react";
import {
  StyleSheet,
  Text,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";

import Screen from "../../components/Screen";
import { useAuthStore } from "../../store/authStore";
import { useAppTheme } from "../../theme/useAppTheme";

export default function CaptainProfileScreen() {
  const appTheme = useAppTheme();
  const styles = createStyles(appTheme);
  const user = useAuthStore((s) => s.user);

  const name = user?.name || "الكابتن";
  const initial = name.trim().charAt(0) || "ك";

  return (
    <Screen>
      <View style={styles.container}>
        <Text style={styles.eyebrow}>زاجل ديلفري</Text>
        <Text style={styles.title}>حسابي</Text>

        <View style={styles.profileHero}>
          <View style={styles.avatar}>
            <Text style={styles.avatarText}>{initial}</Text>
          </View>

          <Text style={styles.name}>{name}</Text>

          <View style={styles.rolePill}>
            <Ionicons
              name="bicycle-outline"
              size={15}
              color={appTheme.secondaryColor}
            />
            <Text style={styles.roleText}>كابتن توصيل</Text>
          </View>
        </View>

        <Text style={styles.sectionTitle}>معلومات الحساب</Text>

        <View style={styles.card}>
          <InfoRow
            icon="person-outline"
            label="الاسم"
            value={user?.name || "—"}
            appTheme={appTheme}
          />

          <InfoRow
            icon="call-outline"
            label="الهاتف"
            value={user?.phone || "—"}
            appTheme={appTheme}
          />

          <InfoRow
            icon="mail-outline"
            label="البريد الإلكتروني"
            value={user?.email || "—"}
            appTheme={appTheme}
          />

          <InfoRow
            icon="shield-checkmark-outline"
            label="حالة الحساب"
            value={user?.status || "—"}
            appTheme={appTheme}
            last
          />
        </View>

        <View style={styles.notice}>
          <View style={styles.noticeIcon}>
            <Ionicons
              name="information-circle-outline"
              size={20}
              color={appTheme.infoColor}
            />
          </View>

          <Text style={styles.noticeText}>
            بيانات الحساب الأساسية يتم جلبها من حسابك المسجل في النظام.
          </Text>
        </View>
      </View>
    </Screen>
  );
}

function InfoRow({
  icon,
  label,
  value,
  appTheme,
  last = false,
}: {
  icon: keyof typeof Ionicons.glyphMap;
  label: string;
  value: string;
  appTheme: ReturnType<typeof useAppTheme>;
  last?: boolean;
}) {
  const styles = createStyles(appTheme);

  return (
    <View
      style={[
        styles.infoRow,
        !last && styles.infoRowBorder,
      ]}
    >
      <View style={styles.infoIcon}>
        <Ionicons
          name={icon}
          size={19}
          color={appTheme.primaryColor}
        />
      </View>

      <View style={styles.infoContent}>
        <Text style={styles.infoLabel}>{label}</Text>
        <Text style={styles.infoValue}>{value}</Text>
      </View>
    </View>
  );
}

