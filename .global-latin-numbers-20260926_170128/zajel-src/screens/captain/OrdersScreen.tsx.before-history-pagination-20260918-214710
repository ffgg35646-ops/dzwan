import React, { useCallback, useEffect, useMemo, useState } from "react";
import {
  ActivityIndicator,
  FlatList,
  RefreshControl,
  StyleSheet,
  Text,
  TouchableOpacity,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";
import { useNavigation } from "@react-navigation/native";

import Screen from "../../components/Screen";
import LoadingState from "../../components/LoadingState";
import OrderStatusBadge from "../../components/OrderStatusBadge";
import { useAppTheme } from "../../theme/useAppTheme";
import { getOrders } from "../../api/orders";

export default function CaptainOrdersScreen() {
  const appTheme = useAppTheme();
  const styles = createStyles(appTheme);
  const navigation = useNavigation<any>();

  const [orders, setOrders] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);

  const load = useCallback(async (silent = false) => {
    if (!silent) setLoading(true);

    try {
      const data = await getOrders();

      const list = Array.isArray(data)
        ? data
        : data?.orders || data?.items || data?.data || [];

      const visible = (Array.isArray(list) ? list : []).filter(
        (item: any) =>
          ["pending", "assigned", "picked_up", "on_the_way", "delivered"].includes(
            item?.status
          )
      );

      setOrders(visible);
    } catch {
      // لا نكسر الشاشة عند فشل التحديث التلقائي.
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  useEffect(() => {
    load();

    const timer = setInterval(() => load(true), 15000);
    return () => clearInterval(timer);
  }, [load]);

  const stats = useMemo(() => {
    const active = orders.filter((o) =>
      ["pending", "confirmed", "preparing", "ready_for_pickup", "assigned", "picked_up", "on_the_way"].includes(o?.status)
    ).length;

    const delivered = orders.filter((o) => o?.status === "delivered").length;

    return {
      total: orders.length,
      active,
      delivered,
    };
  }, [orders]);

  const onRefresh = () => {
    setRefreshing(true);
    load(true);
  };

  if (loading) {
    return (
      <Screen>
        <LoadingState message="جاري تحميل الطلبات..." />
      </Screen>
    );
  }

  return (
    <Screen>
      <View style={styles.container}>
        <View style={styles.header}>
          <View style={styles.headerIcon}>
            <Ionicons
              name="receipt-outline"
              size={24}
              color={appTheme.primaryColor}
            />
          </View>

          <View style={styles.headerText}>
            <Text style={styles.eyebrow}>زاجل ديلفري</Text>
            <Text style={styles.title}>الطلبات</Text>
          </View>
        </View>

        <View style={styles.stats}>
          <Stat
            icon="layers-outline"
            label="كل الطلبات"
            value={stats.total}
            appTheme={appTheme}
          />
          <Stat
            icon="bicycle-outline"
            label="النشطة"
            value={stats.active}
            appTheme={appTheme}
          />
          <Stat
            icon="checkmark-circle-outline"
            label="المسلّمة"
            value={stats.delivered}
            appTheme={appTheme}
          />
        </View>

        <FlatList
          data={orders}
          showsVerticalScrollIndicator={false}
          keyExtractor={(item, index) =>
            String(item?._id || item?.id || index)
          }
          refreshControl={
            <RefreshControl
              refreshing={refreshing}
              onRefresh={onRefresh}
              tintColor={appTheme.primaryColor}
              colors={[appTheme.primaryColor]}
            />
          }
          contentContainerStyle={
            orders.length === 0
              ? styles.emptyContainer
              : styles.list
          }
          renderItem={({ item }) => {
            const orderId = String(item?._id || item?.id || "");

            return (
              <TouchableOpacity
                activeOpacity={0.88}
                style={styles.card}
                onPress={() =>
                  navigation.navigate("OrderDetails", {
                    orderId,
                  })
                }
              >
                <View style={styles.cardTop}>
                  <View style={styles.chevron}>
                    <Ionicons
                      name="chevron-back"
                      size={18}
                      color={appTheme.secondaryTextColor}
                    />
                  </View>

                  <View style={styles.orderIdentity}>
                    <View style={styles.orderIcon}>
                      <Ionicons
                        name="cube-outline"
                        size={19}
                        color={appTheme.primaryColor}
                      />
                    </View>

                    <View>
                      <Text style={styles.orderNumber}>
                        #{item?.orderNumber || orderId || "—"}
                      </Text>
                      <Text style={styles.orderSub}>
                        طلب توصيل
                      </Text>
                    </View>
                  </View>

                  <OrderStatusBadge status={item?.status} />
                </View>

                <View style={styles.divider} />

                <View style={styles.infoRow}>
                  <View style={styles.infoBlock}>
                    <Text style={styles.infoLabel}>القيمة</Text>
                    <Text style={styles.money}>
                      {item?.total ?? item?.subtotal ?? 0} د.ع
                    </Text>
                  </View>

                  <View style={styles.infoBlock}>
                    <Text style={styles.infoLabel}>الزبون</Text>
                    <Text
                      style={styles.customer}
                      numberOfLines={1}
                    >
                      {item?.customerSnapshot?.name ||
                        item?.customer?.name ||
                        item?.customerName ||
                        "زبون"}
                    </Text>
                  </View>
                </View>

                {!!(
                  item?.deliveryAddress ||
                  item?.address?.address ||
                  item?.customerNote
                ) && (
                  <View style={styles.locationRow}>
                    <Ionicons
                      name="location-outline"
                      size={17}
                      color={appTheme.secondaryTextColor}
                    />
                    <Text
                      style={styles.location}
                      numberOfLines={2}
                    >
                      {item?.deliveryAddress ||
                        item?.address?.address ||
                        item?.customerNote}
                    </Text>
                  </View>
                )}
              </TouchableOpacity>
            );
          }}
          ListEmptyComponent={
            <View style={styles.empty}>
              <View style={styles.emptyIcon}>
                <Ionicons
                  name="cube-outline"
                  size={42}
                  color={appTheme.primaryColor}
                />
              </View>

              <Text style={styles.emptyTitle}>
                لا توجد طلبات حالياً
              </Text>

              <Text style={styles.emptyText}>
                ستظهر الطلبات المتاحة لك هنا تلقائياً.
              </Text>

              <TouchableOpacity
                style={styles.refreshButton}
                onPress={() => load()}
              >
                <Ionicons
                  name="refresh"
                  size={18}
                  color={appTheme.primaryColor}
                />
                <Text style={styles.refreshText}>
                  تحديث الطلبات
                </Text>
              </TouchableOpacity>
            </View>
          }
        />
      </View>
    </Screen>
  );
}

function Stat({
  icon,
  label,
  value,
  appTheme,
}: {
  icon: keyof typeof Ionicons.glyphMap;
  label: string;
  value: number;
  appTheme: ReturnType<typeof useAppTheme>;
}) {
  const styles = createStyles(appTheme);

  return (
    <View style={styles.stat}>
      <View style={styles.statIcon}>
        <Ionicons
          name={icon}
          size={18}
          color={appTheme.primaryColor}
        />
      </View>

      <Text style={styles.statValue}>{value}</Text>
      <Text style={styles.statLabel}>{label}</Text>
    </View>
  );
}

