  async function openHomeShiftPicker() {
    if (shiftSaving) return;

    setShiftPickerOpen(true);
    setShiftPickerLoading(true);

    try {
      const [
        shiftsResponse,
        currentResponse,
      ] = await Promise.all([
        getAvailableShifts(),
        checkShift(),
      ]);

      setAvailableShifts(
        Array.isArray(shiftsResponse?.data)
          ? shiftsResponse.data
          : [],
      );

      setShift(currentResponse);
    } catch (error: any) {
      Alert.alert(
        "تعذر تحميل الشفتات",
        error?.response?.data?.message ||
          error?.response?.data?.error ||
          "تعذر تحميل الشفتات المتاحة حاليًا.",
      );
    } finally {
      setShiftPickerLoading(false);
    }
  }

  async function saveHomeShift(
    newShiftId: string,
  ) {
    if (!newShiftId || shiftSaving) return;

    if (
      selectedWeeklyShiftId &&
      newShiftId === selectedWeeklyShiftId
    ) {
      setShiftPickerOpen(false);
      return;
    }

    /*
     * الواجهة تمنع المحاولة الثانية،
     * والـBackend يمنعها أيضًا كحماية نهائية.
     */
    if (
      selectedWeeklyShiftId &&
      shiftChangeUsed
    ) {
      Alert.alert(
        "تغيير الشفت",
        "متاح تغيير الشفت مرة واحدة فقط أسبوعيًا، وقد تم استخدام التغيير لهذا الأسبوع.",
      );
      return;
    }

    setShiftSaving(true);

    try {
      if (selectedWeeklyShiftId) {
        await changeWeeklyShift(newShiftId);
      } else {
        await selectWeeklyShift(newShiftId);
      }

      /*
       * نقرأ الحالة من الخادم بعد الحفظ.
       * لا نعتمد على حالة محلية ثابتة.
       */
      await loadData();

      setShiftPickerOpen(false);

      Alert.alert(
        selectedWeeklyShiftId
          ? "تم تغيير الشفت"
          : "تم اختيار الشفت",
        selectedWeeklyShiftId
          ? "تم تغيير شفت هذا الأسبوع بنجاح."
          : "تم حفظ شفت هذا الأسبوع بنجاح.",
      );
    } catch (error: any) {
      Alert.alert(
        selectedWeeklyShiftId
          ? "تعذر تغيير الشفت"
          : "تعذر اختيار الشفت",
        error?.response?.data?.message ||
          error?.response?.data?.error ||
          "تعذر تنفيذ العملية الآن.",
      );
    } finally {
      setShiftSaving(false);
    }
  }

