                        </View>

                        <View style={styles.orderDetailItem}>
                          <Text style={styles.orderDetailLabel}>
                            وقت التوصيل
                          </Text>
                          <Text style={styles.orderDetailValue}>
                            {orderDate
                              ? formatTime(orderDate)
                              : "--:--"}
                          </Text>
                        </View>

                        <View style={styles.orderDetailItem}>
                          <Text style={styles.orderDetailLabel}>
                            المطعم / المتجر
                          </Text>
                          <Text
                            style={styles.orderDetailValue}
                            numberOfLines={2}
                          >
                            {restaurant}
                          </Text>
                        </View>

                        <View style={styles.orderDetailItem}>
                          <Text style={styles.orderDetailLabel}>
                            السعر
                          </Text>
                          <Text
                            style={[
                              styles.orderDetailValue,
                              styles.orderPrice,
                            ]}
                          >
                            {amount != null
                              ? `${amount} د.ع`
                              : "غير متوفر"}
                          </Text>
                        </View>

                        <View
                          style={[
                            styles.orderDetailItem,
                            styles.orderDetailFull,
                          ]}
                        >
                          <Text style={styles.orderDetailLabel}>
                            عنوان العميل
                          </Text>
                          <Text
                            style={styles.orderDetailValue}
                            numberOfLines={3}
                          >
                            {order.deliveryAddress ||
                              "غير متوفر"}
                          </Text>
                        </View>
                      </View>

                      {getCustomerCoordinate(order) ? (
                        <Pressable
                          onPress={() => {
                            const next =
                              getCustomerCoordinate(order);

                            if (!next) return;

                            setCustomerLocation(next);

                            if (location) {
                              void buildRoute(
                                location,
                                next,
                              );
                            }
                          }}
                          style={styles.orderMapButton}
                        >
                          <Ionicons
                            name="location-outline"
                            size={17}
                            color={ORANGE}
                          />

                          <Text
                            style={styles.orderMapButtonText}
                          >
                            عرض موقع العميل على الخريطة
                          </Text>
                        </Pressable>
