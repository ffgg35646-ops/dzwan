    try {
      setMapSearchLoading(true);

      const response = await fetch(
        "https://nominatim.openstreetmap.org/search" +
          `?q=${encodeURIComponent(
            query + ", Iraq",
          )}` +
          "&format=jsonv2" +
          "&limit=5" +
          "&accept-language=ar",
      );

      if (!response.ok) {
        setSearchResults([]);
        return;
      }

      const data = await response.json();

      setSearchResults(
        Array.isArray(data)
          ? data
          : [],
      );
    } catch {
      setSearchResults([]);
    } finally {
      setMapSearchLoading(false);
    }
  }

