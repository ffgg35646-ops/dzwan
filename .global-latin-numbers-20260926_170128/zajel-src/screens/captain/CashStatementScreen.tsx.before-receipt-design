import React, { useCallback, useEffect, useMemo, useState } from "react";
import {
  ActivityIndicator,
  RefreshControl,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";

import Screen from "../../components/Screen";
import { useAppTheme } from "../../theme/useAppTheme";
import { useAuthStore } from "../../store/authStore";
import { getCaptainCashStatement } from "../../api/captainRuntime";

function money(value: any) {
  const number = Number(value ?? 0);

  return `${new Intl.NumberFormat("ar-IQ").format(
    Number.isFinite(number) ? number : 0,
  )} د.ع`;
}

function number(value: any) {
  const n = Number(value ?? 0);

  return new Intl.NumberFormat("ar-IQ").format(
    Number.isFinite(n) ? n : 0,
  );
}

function pick(data: any, keys: string[], fallback = 0) {
  for (const key of keys) {
    const value = data?.[key];

    if (value !== undefined && value !== null) {
      return value;
    }
  }

  return fallback;
}

export default function CashStatementScreen() {
  const appTheme = useAppTheme();
  const styles = createStyles(appTheme);

  const user = useAuthStore((s) => s.user);

  const [data, setData] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);

  const load = useCallback(
    async (silent = false) => {
      if (!user?.id) {
        setLoading(false);
        return;
      }

      try {
        if (silent) {
          setRefreshing(true);
        } else {
          setLoading(true);
        }

        const result: any =
          await getCaptainCashStatement(user.id);

        const realData =
          result?.statement ??
          result?.data?.statement ??
          result?.data ??
          result;

        setData(realData || {});
      } catch {
        setData(null);
      } finally {
        setLoading(false);
        setRefreshing(false);
      }
    },
    [user?.id],
  );

  useEffect(() => {
    void load();
  }, [load]);

  const summary = useMemo(() => {
    const orders = Number(
      pick(data, [
        "orders",
        "ordersCount",
        "totalOrders",
        "count",
      ]),
    );

    const paidToEstablishments = Number(
      pick(data, [
        "paidToEstablishments",
        "totalPaidShops",
        "paidToShops",
      ]),
    );

    const collectedFromCustomers = Number(
      pick(data, [
        "collectedFromCustomers",
        "totalCollectedCustomers",
        "collected",
      ]),
    );

    const deliveryFees = Number(
      pick(data, [
        "deliveryFees",
        "totalDeliveryFees",
        "earnings",
      ]),
    );

    const netCash = Number(
      pick(
        data,
        [
          "netCash",
          "cashBalance",
          "remainingCash",
          "balance",
        ],
        collectedFromCustomers -
          paidToEstablishments,
      ),
    );

    return {
      orders,
      paidToEstablishments,
      collectedFromCustomers,
      deliveryFees,
      netCash,
    };
  }, [data]);

  if (loading) {
    return (
      <Screen>
        <View style={styles.loading}>
          <ActivityIndicator
            size="large"
            color={appTheme.primaryColor}
          />

          <Text style={styles.loadingText}>
            جاري تحميل كشف الحساب...
          </Text>
        </View>
      </Screen>
    );
  }

  return (
    <Screen>
      <ScrollView
        showsVerticalScrollIndicator={false}
        refreshControl={
          <RefreshControl
            refreshing={refreshing}
            onRefresh={() => load(true)}
          />
        }
        contentContainerStyle={styles.content}
      >
        <View style={styles.header}>
          <View style={styles.headerIcon}>
            <Ionicons
              name="receipt-outline"
              size={22}
              color={appTheme.primaryColor}
            />
          </View>

          <View style={styles.headerText}>
            <Text style={styles.eyebrow}>
              الحسابات
            </Text>

            <Text style={styles.title}>
              كشف حساب الكابتن
            </Text>
          </View>
        </View>

        <View style={styles.hero}>
          <View style={styles.heroTop}>
            <View>
              <Text style={styles.heroLabel}>
                الرصيد النقدي الحالي
              </Text>

              <Text style={styles.heroValue}>
                {money(summary.netCash)}
              </Text>
            </View>

            <View style={styles.heroIcon}>
              <Ionicons
                name="wallet-outline"
                size={30}
                color="#FFFFFF"
              />
            </View>
          </View>

          <View style={styles.heroFooter}>
            <View style={styles.heroFooterItem}>
              <Text style={styles.heroFooterLabel}>
                الطلبات
              </Text>

              <Text style={styles.heroFooterValue}>
                {number(summary.orders)}
              </Text>
            </View>

            <View style={styles.heroDivider} />

            <View style={styles.heroFooterItem}>
              <Text style={styles.heroFooterLabel}>
                أجور التوصيل
              </Text>

              <Text style={styles.heroFooterValue}>
                {money(summary.deliveryFees)}
              </Text>
            </View>
          </View>
        </View>

        <View style={styles.grid}>
          <SummaryCard
            icon="arrow-down-circle-outline"
            title="المستلم من الزبائن"
            value={money(
              summary.collectedFromCustomers,
            )}
            tone="green"
            styles={styles}
          />

          <SummaryCard
            icon="arrow-up-circle-outline"
            title="المدفوع للمحلات"
            value={money(
              summary.paidToEstablishments,
            )}
            tone="orange"
            styles={styles}
          />

          <SummaryCard
            icon="bicycle-outline"
            title="أجور التوصيل"
            value={money(summary.deliveryFees)}
            tone="blue"
            styles={styles}
          />

          <SummaryCard
            icon="cube-outline"
            title="عدد الطلبات"
            value={number(summary.orders)}
            tone="purple"
            styles={styles}
          />
        </View>

        <View style={styles.infoCard}>
          <View style={styles.infoIcon}>
            <Ionicons
              name="information-circle-outline"
              size={20}
              color={appTheme.primaryColor}
            />
          </View>

          <View style={styles.infoTextWrap}>
            <Text style={styles.infoTitle}>
              كشف نقدي
            </Text>

            <Text style={styles.infoText}>
              هذه الأرقام مأخوذة من السجل المالي الفعلي للكابتن في النظام وليست محفظة إلكترونية.
            </Text>
          </View>
        </View>

        {!data ? (
          <View style={styles.emptyCard}>
            <Ionicons
              name="cloud-offline-outline"
              size={30}
              color={appTheme.secondaryTextColor}
            />

            <Text style={styles.emptyTitle}>
              تعذر تحميل البيانات
            </Text>

            <Text style={styles.emptyText}>
              اسحب الصفحة للأسفل لإعادة المحاولة.
            </Text>
          </View>
        ) : null}

        <View style={styles.footer}>
          <Text style={styles.footerText}>
            اسحب للأسفل لتحديث الكشف
          </Text>
        </View>
      </ScrollView>
    </Screen>
  );
}

function SummaryCard({
  icon,
  title,
  value,
  tone,
  styles,
}: {
  icon: keyof typeof Ionicons.glyphMap;
  title: string;
  value: string;
  tone: "green" | "orange" | "blue" | "purple";
  styles: ReturnType<typeof createStyles>;
}) {
  const color =
    tone === "green"
      ? "#16A34A"
      : tone === "orange"
        ? "#EA580C"
        : tone === "blue"
          ? "#2563EB"
          : "#7C3AED";

  const background =
    tone === "green"
      ? "#F0FDF4"
      : tone === "orange"
        ? "#FFF7ED"
        : tone === "blue"
          ? "#EFF6FF"
          : "#F5F3FF";

  return (
    <View style={styles.summaryCard}>
      <View
        style={[
          styles.summaryIcon,
          { backgroundColor: background },
        ]}
      >
        <Ionicons
          name={icon}
          size={20}
          color={color}
        />
      </View>

      <Text style={styles.summaryLabel}>
        {title}
      </Text>

      <Text
        style={[
          styles.summaryValue,
          { color },
        ]}
      >
        {value}
      </Text>
    </View>
  );
}

