import { getMyDocuments } from "../../api/captainDocuments";


type CaptainDocument = {
  _id?: string;
  documentType?: string;
  documentNumber?: string;
  status?: string;
  expiresAt?: string | null;
  rejectionReason?: string | null;
  createdAt?: string;
};

const REQUIRED_DOCUMENTS = [
  { type: "id_front", label: "الهوية الأمامية" },
  { type: "id_back", label: "الهوية الخلفية" },
  { type: "residence_front", label: "الإقامة الأمامية" },
  { type: "residence_back", label: "الإقامة الخلفية" },
] as const;

function latestDocument(
  documents: CaptainDocument[],
  type: string,
) {
  return documents
    .filter((item) => item.documentType === type)
    .sort((a, b) => {
      const aTime = new Date(a.createdAt || 0).getTime();
      const bTime = new Date(b.createdAt || 0).getTime();
      return bTime - aTime;
    })[0];
}

function documentState(document?: CaptainDocument) {
  if (!document) {
    return {
      key: "missing",
      label: "ناقصة",
      color: "#DC2626",
      icon: "alert-circle" as const,
    };
  }

  if (document.status === "rejected") {
    return {
      key: "rejected",
      label: "مرفوضة",
      color: "#DC2626",
      icon: "close-circle" as const,
    };
  }

  if (document.status === "pending") {
    return {
      key: "pending",
      label: "قيد المراجعة",
      color: "#D97706",
      icon: "time" as const,
    };
  }

  if (
    document.status === "approved" &&
    document.expiresAt &&
    new Date(document.expiresAt).getTime() <= Date.now()
  ) {
    return {
      key: "expired",
      label: "منتهية",
      color: "#D97706",
      icon: "warning" as const,
    };
  }

  if (document.status === "approved") {
    return {
      key: "approved",
      label: "معتمدة",
      color: "#16A34A",
      icon: "checkmark-circle" as const,
    };
  }

  return {
    key: "pending",
    label: "قيد المراجعة",
    color: "#D97706",
    icon: "time" as const,
  };
}

export default function CaptainProfileScreen() {
  const appTheme = useAppTheme();
  const styles = createStyles(appTheme);
  const user = useAuthStore((s) => s.user);

  const [documents, setDocuments] =
    useState<CaptainDocument[]>([]);
  const [documentsLoading, setDocumentsLoading] =
    useState(true);

  useEffect(() => {
    let mounted = true;

    async function loadDocuments() {
      try {
        setDocumentsLoading(true);

        const response: any =
          await getMyDocuments();

        const list = Array.isArray(response)
          ? response
          : response?.documents ??
            response?.data?.documents ??
            [];

        if (mounted) {
          setDocuments(
            Array.isArray(list) ? list : [],
          );
        }
      } catch {
        if (mounted) {
          setDocuments([]);
        }
      } finally {
        if (mounted) {
          setDocumentsLoading(false);
        }
      }
    }

    void loadDocuments();

    return () => {
      mounted = false;
    };
  }, []);

  const name = user?.name || "الكابتن";
  const initial = name.trim().charAt(0) || "ك";

  return (
    <Screen>
      <View style={styles.container}>
        <Text style={styles.eyebrow}>زاجل ديلفري</Text>
        <Text style={styles.title}>حسابي</Text>

        <View style={styles.profileHero}>
          <View style={styles.avatar}>
            <Text style={styles.avatarText}>{initial}</Text>
          </View>

          <Text style={styles.name}>{name}</Text>

          <View style={styles.rolePill}>
            <Ionicons
              name="bicycle-outline"
              size={15}
              color={appTheme.secondaryColor}
            />
            <Text style={styles.roleText}>كابتن توصيل</Text>
          </View>
        </View>

        <Text style={styles.sectionTitle}>معلومات الحساب</Text>

        <View style={styles.card}>
          <InfoRow
            icon="person-outline"
            label="الاسم"
            value={user?.name || "—"}
            appTheme={appTheme}
          />

          <InfoRow
            icon="call-outline"
            label="الهاتف"
            value={user?.phone || "—"}
            appTheme={appTheme}
          />

          <InfoRow
            icon="mail-outline"
            label="البريد الإلكتروني"
            value={user?.email || "—"}
            appTheme={appTheme}
          />

          <InfoRow
            icon="shield-checkmark-outline"
            label="حالة الحساب"
            value={user?.status || "—"}
            appTheme={appTheme}
            last
          />
        </View>

        <Text style={styles.sectionTitle}>
          وثائق الكابتن
        </Text>

        {documentsLoading ? (
          <View style={styles.documentsLoading}>
            <ActivityIndicator
              size="small"
              color={appTheme.primaryColor}
            />
            <Text style={styles.documentsLoadingText}>
              جاري التحقق من الوثائق...
            </Text>
          </View>
        ) : (
          <>
            {REQUIRED_DOCUMENTS.map((required) => {
              const document = latestDocument(
                documents,
                required.type,
              );

              const state = documentState(document);

              return (
                <View
                  key={required.type}
                  style={styles.documentRow}
                >
                  <View style={styles.documentInfo}>
                    <Text style={styles.documentTitle}>
                      {required.label}
                    </Text>

                    <Text style={styles.documentNumber}>
                      {document?.documentNumber
                        ? `رقم الوثيقة: ${document.documentNumber}`
                        : "لا توجد وثيقة معتمدة حاليًا"}
                    </Text>

                    {document?.rejectionReason ? (
                      <Text style={styles.documentReason}>
                        سبب الرفض: {document.rejectionReason}
                      </Text>
                    ) : null}
                  </View>

                  <View
                    style={[
                      styles.documentStatus,
                      {
                        backgroundColor:
                          state.color + "14",
                      },
                    ]}
                  >
                    <Ionicons
                      name={state.icon}
                      size={17}
                      color={state.color}
                    />

                    <Text
                      style={[
                        styles.documentStatusText,
                        { color: state.color },
                      ]}
                    >
                      {state.label}
                    </Text>
                  </View>
                </View>
              );
            })}

            {(() => {
              const complete =
                REQUIRED_DOCUMENTS.every((required) => {
                  const document = latestDocument(
                    documents,
                    required.type,
                  );

                  return Boolean(
                    document?.status === "approved" &&
                    (
                      !document.expiresAt ||
                      new Date(
                        document.expiresAt,
                      ).getTime() > Date.now()
                    ),
                  );
                });

              return (
                <View
                  style={[
                    styles.documentsNotice,
                    {
                      backgroundColor: complete
                        ? "#16A34A12"
                        : "#DC262612",
                    },
                  ]}
                >
                  <Ionicons
                    name={
                      complete
                        ? "checkmark-circle-outline"
                        : "warning-outline"
                    }
                    size={21}
                    color={
                      complete
                        ? "#16A34A"
                        : "#DC2626"
                    }
                  />

                  <Text
                    style={[
                      styles.documentsNoticeText,
                      {
                        color: complete
                          ? "#16A34A"
                          : "#DC2626",
                      },
                    ]}
                  >
                    {complete
                      ? "جميع الوثائق المطلوبة معتمدة وصالحة."
                      : "يوجد نقص أو مشكلة في الوثائق. قد يتم منعك من استلام الطلبات حتى اكتمال الوثائق واعتمادها."}
                  </Text>
                </View>
              );
            })()}
          </>
        )}

        <View style={styles.notice}>
          <View style={styles.noticeIcon}>
            <Ionicons
              name="information-circle-outline"
              size={20}
              color={appTheme.infoColor}
            />
          </View>

          <Text style={styles.noticeText}>
            بيانات الحساب الأساسية يتم جلبها من حسابك المسجل في النظام.
          </Text>
        </View>
      </View>
    </Screen>
  );
}

function InfoRow({
  icon,
  label,
  value,
  appTheme,
  last = false,
}: {
  icon: keyof typeof Ionicons.glyphMap;
  label: string;
  value: string;
  appTheme: ReturnType<typeof useAppTheme>;
  last?: boolean;
}) {
  const styles = createStyles(appTheme);

  return (
    <View
      style={[
        styles.infoRow,
        !last && styles.infoRowBorder,
      ]}
    >
      <View style={styles.infoIcon}>
        <Ionicons
          name={icon}
          size={19}
          color={appTheme.primaryColor}
        />
      </View>

      <View style={styles.infoContent}>
        <Text style={styles.infoLabel}>{label}</Text>
        <Text style={styles.infoValue}>{value}</Text>
      </View>
    </View>
  );
}

