import {
  getCaptainCapacity,
  checkShift,
  getMyWorkAreas,
} from "../../api/captain";


function CaptainWebMap() {
  if (Platform.OS !== "web") return null;

  return (
    <View style={styles.mapCard}>
      <View style={styles.mapHeader}>
        <View style={styles.mapLiveDot} />
        <View style={{ flex: 1 }}>
          <Text style={styles.mapTitle}>موقعك الآن</Text>
          <Text style={styles.mapSubtitle}>متابعة موقعك أثناء العمل</Text>
        </View>
        <View style={styles.mapIconBubble}>
          <Ionicons name="location" size={18} color="#F97316" />
        </View>
      </View>

      {React.createElement("iframe", {
        src: "https://www.google.com/maps?q=Iraq&output=embed",
        title: "Captain location map",
        style: {
          width: "100%",
          height: 210,
          border: "0",
          borderRadius: 22,
          display: "block",
        },
        loading: "lazy",
      })}
    </View>
  );
}

export default function CaptainHomeScreen() {
  const appTheme = useAppTheme();
  const styles = createStyles(appTheme);
  const user = useAuthStore((s) => s.user);

  const [capacity, setCapacity] = useState<any>(null);
  const [shift, setShift] = useState<any>(null);
  const [workArea, setWorkArea] = useState<any>(null);
  const [loading, setLoading] = useState(true);

  async function load() {
    if (!user?.id) {
      setLoading(false);
      return;
    }

    try {
      setLoading(true);

      const [
        capacityResult,
        shiftResult,
        workAreaResult,
      ] = await Promise.all([
        getCaptainCapacity(user.id),
        checkShift(),
        getMyWorkAreas(user.id),
      ]);

      setCapacity(capacityResult);
      setShift(shiftResult);
      setWorkArea(workAreaResult?.workAreas?.[0] ?? null);
    } catch {
      // نحتفظ بالبيانات الحالية عند فشل التحديث المؤقت.
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void load();
  }, [user?.id]);

  const withinShift = Boolean(shift?.withinShift);
  const activeOrders = Number(capacity?.activeOrders ?? 0);
  const maxOrders = Number(capacity?.maxActiveOrders ?? 0);

  const remaining =
    maxOrders > activeOrders
      ? maxOrders - activeOrders
      : 0;

  const progress =
    maxOrders > 0
      ? Math.min(activeOrders / maxOrders, 1)
      : 0;

  const locationBlocked =
    workArea &&
    (
      workArea.governorateActive === false ||
      workArea.captainsEnabled === false ||
      workArea.areaActive === false ||
      workArea.areaCaptainsEnabled === false
    );

  const captainName = user?.name || "الكابتن";
  const firstLetter = captainName.trim().charAt(0) || "ك";

  return (
    <Screen>
      <ScrollView
        showsVerticalScrollIndicator={false}
        contentContainerStyle={styles.container}
        refreshControl={
          <RefreshControl
            refreshing={loading}
            onRefresh={load}
            tintColor={appTheme.primaryColor}
            colors={["#F97316", "#FFB52E", "#FFF3D5", "#FFFFFF"]}
          />
        }
      >
        {/* ================= HEADER ================= */}
        <View style={styles.topHeader}>
          <View style={styles.profileBlock}>
            <View style={styles.avatarOuter}>
              <LinearGradient
                colors={[
                  appTheme.primaryColor,
                  appTheme.primaryDarkColor,
                ]}
                start={{ x: 0, y: 0 }}
                end={{ x: 1, y: 1 }}
                style={styles.avatar}
              >
              <View pointerEvents="none" style={styles.heroWaveLayerOne} />
              <View pointerEvents="none" style={styles.heroWaveLayerTwo} />
              <View pointerEvents="none" style={styles.heroWaveLayerThree} />
              <View pointerEvents="none" style={styles.heroGlowOrb} />

                <Text style={styles.avatarText}>
                  {firstLetter}
                </Text>
              </LinearGradient>

              <View
                style={[
                  styles.avatarStatus,
                  {
                    backgroundColor: withinShift
                      ? "#2DD4BF"
                      : "#FBBF24",
                  },
                ]}
              />
            </View>

            <View style={styles.profileText}>
              <Text style={styles.overline}>
                زاجل ديلفري
              </Text>

              <Text
                style={styles.profileName}
                numberOfLines={1}
              >
                {captainName}
              </Text>

              <Text style={styles.profileSub}>
                لوحة التحكم اليومية
              </Text>
            </View>
          </View>

          <View style={styles.liveBadge}>
            <View
              style={[
                styles.liveDot,
                {
                  backgroundColor: withinShift
                    ? "#2DD4BF"
                    : "#FBBF24",
                },
              ]}
            />
            <Text style={styles.liveText}>
              {withinShift ? "LIVE" : "OFF"}
            </Text>
          </View>
        </View>

        {/* ================= MAIN HERO ================= */}
        <LinearGradient
          colors={
            withinShift
              ? [
                  appTheme.primaryDarkColor,
                  appTheme.primaryColor,
                ]
              : [
                  "#0F172A",
                  "#334155",
                ]
          }
          start={{ x: 0, y: 0 }}
          end={{ x: 1, y: 1 }}
          style={styles.hero}
        >
          <View style={styles.heroOrbOne} />
          <View style={styles.heroOrbTwo} />

          <View style={styles.heroTop}>
            <View style={styles.heroIcon}>
              <Ionicons
                name={
                  withinShift
                    ? "radio-outline"
                    : "moon-outline"
                }
                size={25}
                color="#FFFFFF"
              />
            </View>

            <View style={styles.heroState}>
              <Text style={styles.heroStateSmall}>
                حالة التشغيل
              </Text>

              <Text style={styles.heroStateMain}>
                {withinShift
                  ? "متاح الآن"
                  : "خارج الشفت"}
              </Text>
            </View>
          </View>

          <Text style={styles.heroHeadline}>
            {withinShift
              ? "جاهز لاستقبال الطلبات"
              : "لا توجد طلبات جديدة الآن"}
          </Text>

          <Text style={styles.heroDescription}>
            {withinShift
              ? remaining > 0
                ? `لديك مساحة لاستقبال ${remaining} طلب ${
                    remaining === 1 ? "إضافي" : "إضافية"
                  }.`
                : "وصلت إلى الحد الأقصى للسعة الحالية."
              : "يمكنك معرفة الشفت القادم من قسم الشفت والحضور."}
          </Text>

          <View style={styles.heroFooter}>
            <View style={styles.heroMeta}>
              <Ionicons
                name="time-outline"
                size={15}
                color="rgba(255,255,255,0.72)"
              />
              <Text style={styles.heroMetaText}>
                {withinShift
                  ? "الشفت نشط"
                  : "بانتظار وقت الشفت"}
              </Text>
            </View>

            <View style={styles.heroMeta}>
              <Ionicons
                name="location-outline"
                size={15}
                color="rgba(255,255,255,0.72)"
              />
              <Text
                style={styles.heroMetaText}
                numberOfLines={1}
              >
                {workArea?.areaName || "المنطقة غير محددة"}
              </Text>
            </View>
          </View>
        </LinearGradient>

        {/* ================= WARNING ================= */}
        {locationBlocked ? (
          <View style={styles.warningCard}>
            <View style={styles.warningIcon}>
              <Ionicons
                name="warning-outline"
                size={19}
                color={appTheme.dangerColor}
              />
            </View>

            <View style={styles.warningContent}>
              <Text style={styles.warningTitle}>
                منطقة التشغيل متوقفة
              </Text>

              <Text style={styles.warningText}>
                تم إيقاف استقبال الطلبات من الإدارة حتى يتم
                تفعيل المحافظة أو المنطقة.
              </Text>
            </View>
          </View>
        ) : null}

        {/* ================= SECTION TITLE ================= */}
        <View style={styles.sectionTitleRow}>
          <View>
            <Text style={styles.sectionKicker}>
              PERFORMANCE
            </Text>
            <Text style={styles.sectionTitle}>
              أداء اليوم
            </Text>
          </View>

          <View style={styles.sectionBadge}>
            <Ionicons
              name="pulse-outline"
              size={14}
              color={appTheme.primaryColor}
            />
            <Text style={styles.sectionBadgeText}>
              مباشر
            </Text>
          </View>
        </View>

        {loading ? (
          <View style={styles.loadingCard}>
            <ActivityIndicator
              size="small"
              color={appTheme.primaryColor}
            />
            <Text style={styles.loadingText}>
              جاري تحديث البيانات...
            </Text>
          </View>
        ) : (
          <>
            {/* ================= METRICS ================= */}
          <CaptainWebMap />

            <View style={styles.metricsRow}>
              <MetricCard
                styles={styles}
                icon="bicycle-outline"
                label="الطلبات النشطة"
                value={String(activeOrders)}
                color={appTheme.primaryColor}
              />

              <MetricCard
                styles={styles}
                icon="layers-outline"
                label="السعة القصوى"
                value={String(maxOrders)}
                color={appTheme.infoColor}
              />
            </View>

            {/* ================= CAPACITY ================= */}
            <View style={styles.glassCard}>
              <View style={styles.capacityTop}>
                <View>
                  <Text style={styles.miniLabel}>
                    CAPACITY
                  </Text>

                  <Text style={styles.capacityTitle}>
                    سعة الطلبات
                  </Text>
                </View>

                <View style={styles.capacityNumberBlock}>
                  <Text style={styles.capacityNumber}>
                    {activeOrders}
                  </Text>

                  <Text style={styles.capacitySlash}>
                    / {maxOrders}
                  </Text>
                </View>
              </View>

              <View style={styles.progressOuter}>
                <LinearGradient
                  colors={[
                    appTheme.primaryColor,
                    appTheme.secondaryColor,
                  ]}
                  start={{ x: 0, y: 0 }}
                  end={{ x: 1, y: 0 }}
                  style={[
                    styles.progressInner,
                    {
                      width: `${progress * 100}%`,
                    },
                  ]}
                />
              </View>

              <View style={styles.capacityBottom}>
                <Text style={styles.capacityHint}>
                  {maxOrders > activeOrders
                    ? `يمكنك استقبال ${remaining} طلب إضافي`
                    : maxOrders > 0
                      ? "السعة ممتلئة"
                      : "السعة غير محددة"}
                </Text>

                <Text style={styles.capacityPercent}>
                  {Math.round(progress * 100)}%
                </Text>
              </View>
            </View>

            {/* ================= OPERATION INFO ================= */}
            <View style={styles.glassCard}>
              <View style={styles.cardHeading}>
                <Text style={styles.cardHeadingTitle}>
                  معلومات التشغيل
                </Text>

                <Text style={styles.cardHeadingHint}>
                  اليوم
                </Text>
              </View>

              <InfoItem
                styles={styles}
                icon="time-outline"
                title="حالة الشفت"
                value={
                  withinShift
                    ? "نشط الآن"
                    : "غير نشط"
                }
                positive={withinShift}
              />

              <View style={styles.rowDivider} />

              <InfoItem
                styles={styles}
                icon="location-outline"
                title="المنطقة"
                value={
                  workArea?.areaName ||
                  "غير محددة"
                }
              />

              <View style={styles.rowDivider} />

              <InfoItem
                styles={styles}
                icon="business-outline"
                title="المحافظة"
                value={
                  workArea?.governorateName ||
                  "غير محددة"
                }
              />
            </View>

            {/* ================= FOOT NOTE ================= */}
            <View style={styles.footerNote}>
              <Ionicons
                name="shield-checkmark-outline"
                size={17}
                color={appTheme.primaryColor}
              />

              <Text style={styles.footerNoteText}>
                يتم توزيع الطلبات تلقائيًا حسب الشفت والسعة
                ومنطقة العمل.
              </Text>
            </View>
          </>
        )}
      </ScrollView>
    </Screen>
  );
}

function MetricCard({
  styles,
  icon,
  label,
  value,
  color,
}: {
  styles: ReturnType<typeof createStyles>;
  icon: keyof typeof Ionicons.glyphMap;
  label: string;
  value: string;
  color: string;
}) {
  return (
    <View style={styles.metricCard}>
      <View
        style={[
          styles.metricIcon,
          {
            backgroundColor: color + "14",
          },
        ]}
      >
        <Ionicons
          name={icon}
          size={19}
          color={color}
        />
      </View>

      <Text style={styles.metricValue}>
        {value}
      </Text>

      <Text style={styles.metricLabel}>
        {label}
      </Text>
    </View>
  );
}

function InfoItem({
  styles,
  icon,
  title,
  value,
  positive = false,
}: {
  styles: ReturnType<typeof createStyles>;
  icon: keyof typeof Ionicons.glyphMap;
  title: string;
  value: string;
  positive?: boolean;
}) {
  return (
    <View style={styles.infoItem}>
      <View style={styles.infoIcon}>
        <Ionicons
          name={icon}
          size={18}
          color="#FFFFFF"
        />
      </View>

      <View style={styles.infoCopy}>
        <Text style={styles.infoTitle}>
          {title}
        </Text>

        <Text
          style={[
            styles.infoValue,
            positive && {
              color: "#16A085",
            },
          ]}
          numberOfLines={1}
        >
          {value}
        </Text>
      </View>
    </View>
  );
}

