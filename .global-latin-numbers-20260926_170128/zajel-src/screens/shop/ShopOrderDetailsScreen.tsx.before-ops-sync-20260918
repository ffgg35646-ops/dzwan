import { useAppTheme } from "../../theme/useAppTheme";
import React, { useCallback, useEffect, useState } from "react";
import {
  Alert,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from "react-native";
import {
  useNavigation,
  useRoute,
} from "@react-navigation/native";

import Screen from "../../components/Screen";
import LoadingState from "../../components/LoadingState";
import OrderStatusBadge from "../../components/OrderStatusBadge";
import AppButton from "../../components/AppButton";
import {
  getOrder,
  getTimeline,
} from "../../api/orders";

export default function ShopOrderDetailsScreen() {
  const appTheme = useAppTheme();
  const styles = createStyles(appTheme);

  const route = useRoute<any>();
  const navigation = useNavigation<any>();

  const orderId = String(route.params?.orderId || "");

  const [order, setOrder] = useState<any>(null);
  const [timeline, setTimeline] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);

  const load = useCallback(
    async (silent = false) => {
      if (!orderId) {
        setLoading(false);
        return;
      }

      if (!silent) {
        setLoading(true);
      }

      try {
        const [orderResponse, timelineResponse] =
          await Promise.all([
            getOrder(orderId),
            getTimeline(orderId),
          ]);

        const normalizedOrder =
          orderResponse?.data ??
          orderResponse?.order ??
          orderResponse;

        const normalizedTimeline =
          timelineResponse?.data ??
          timelineResponse?.timeline ??
          timelineResponse;

        setOrder(normalizedOrder);
        setTimeline(normalizedTimeline);
      } catch (error: any) {
        if (!silent) {
          Alert.alert(
            "تعذر تحميل الطلب",
            error?.response?.data?.message ||
              error?.response?.data?.error ||
              "تعذر تحميل تفاصيل الطلب."
          );
        }
      } finally {
        setLoading(false);
        setRefreshing(false);
      }
    },
    [orderId]
  );

  useEffect(() => {
    load();

    const timer = setInterval(() => {
      load(true);
    }, 10000);

    return () => clearInterval(timer);
  }, [load]);

  function handleRefresh() {
    setRefreshing(true);
    load(true);
  }

  function openCaptainRating() {
    const captainId =
      route.params?.captainId ??
      order?.captainId ??
      order?.captain?._id ??
      order?.captain?.id;

    if (!captainId) {
      Alert.alert(
        "التقييم",
        "لا يوجد كابتن مرتبط بهذا الطلب."
      );
      return;
    }

    navigation.navigate("RateCaptain", {
      orderId:
        order?._id ??
        order?.id ??
        orderId,
      captainId,
    });
  }

  if (loading) {
    return (
      <Screen>
        <LoadingState message="جاري تحميل تفاصيل الطلب..." />
      </Screen>
    );
  }

  if (!order) {
    return (
      <Screen>
        <View style={styles.empty}>
          <View style={styles.emptyIcon}>
            <Text style={styles.emptyIconText}>!</Text>
          </View>

          <Text style={styles.emptyTitle}>
            تعذر العثور على الطلب
          </Text>

          <Text style={styles.emptyText}>
            لم نتمكن من تحميل بيانات هذا الطلب.
          </Text>

          <AppButton
            title="إعادة المحاولة"
            onPress={() => load()}
          />
        </View>
      </Screen>
    );
  }

  const events = Array.isArray(timeline?.events)
    ? timeline.events
    : Array.isArray(timeline)
      ? timeline
      : [];

  const status = order?.status;

  const isDelivered = status === "delivered";

  const customerName =
    order?.customerName ||
    order?.customer?.name ||
    "الزبون";

  const customerPhone =
    order?.customerPhone ||
    order?.customer?.phone ||
    "غير متوفر";

  const deliveryAddress =
    order?.deliveryAddress ||
    order?.address ||
    "غير محدد";

  const subtotal =
    Number(order?.subtotal ?? 0);

  const deliveryFee =
    Number(order?.deliveryFee ?? 0);

  const total =
    Number(
      order?.total ??
        subtotal + deliveryFee
    );

  return (
    <Screen>
      <ScrollView
        contentContainerStyle={styles.container}
        showsVerticalScrollIndicator={false}
        keyboardShouldPersistTaps="handled"
      >
        <View style={styles.header}>
          <View style={styles.headerTop}>
            <View style={styles.orderIcon}>
              <Text style={styles.orderIconText}>
                #
              </Text>
            </View>

            <View style={styles.headerInfo}>
              <Text style={styles.eyebrow}>
                تفاصيل الطلب
              </Text>

              <Text style={styles.title}>
                #{order?.orderNumber || orderId}
              </Text>

              <Text style={styles.createdAt}>
                {order?.createdAt
                  ? new Date(
                      order.createdAt
                    ).toLocaleString("ar-IQ")
                  : "وقت الإنشاء غير متوفر"}
              </Text>
            </View>
          </View>

          <View style={styles.statusRow}>
            <OrderStatusBadge status={status} />

            <View style={styles.liveIndicator}>
              <View style={styles.liveDot} />
              <Text style={styles.liveText}>
                يتم التحديث تلقائيًا
              </Text>
            </View>
          </View>
        </View>

        <View style={styles.totalCard}>
          <View style={styles.totalHeader}>
            <Text style={styles.totalLabel}>
              إجمالي الطلب
            </Text>

            <View style={styles.totalIcon}>
              <Text style={styles.totalIconText}>
                د.ع
              </Text>
            </View>
          </View>

          <Text style={styles.totalValue}>
            {total.toLocaleString("ar-IQ")} د.ع
          </Text>

          <View style={styles.totalDivider} />

          <View style={styles.priceRow}>
            <Text style={styles.priceValue}>
              {subtotal.toLocaleString("ar-IQ")} د.ع
            </Text>

            <Text style={styles.priceLabel}>
              قيمة الطلب
            </Text>
          </View>

          <View style={styles.priceRow}>
            <Text style={styles.priceValue}>
              {deliveryFee.toLocaleString("ar-IQ")} د.ع
            </Text>

            <Text style={styles.priceLabel}>
              أجرة التوصيل
            </Text>
          </View>
        </View>

        <View style={styles.card}>
          <View style={styles.sectionHeader}>
            <View style={styles.sectionIcon}>
              <Text style={styles.sectionIconText}>
                01
              </Text>
            </View>

            <View style={styles.sectionHeaderContent}>
              <Text style={styles.sectionTitle}>
                بيانات الزبون
              </Text>

              <Text style={styles.sectionSubtitle}>
                معلومات المستلم
              </Text>
            </View>
          </View>

          <View style={styles.details}>
            <DetailRow
              label="الاسم"
              value={customerName}
              styles={styles}
              appTheme={appTheme}
            />

            <DetailRow
              label="رقم الهاتف"
              value={customerPhone}
              styles={styles}
              appTheme={appTheme}
            />

            <DetailRow
              label="عنوان التوصيل"
              value={deliveryAddress}
              styles={styles}
              appTheme={appTheme}
              last
            />
          </View>
        </View>

        <View style={styles.card}>
          <View style={styles.sectionHeader}>
            <View style={styles.sectionIcon}>
              <Text style={styles.sectionIconText}>
                02
              </Text>
            </View>

            <View style={styles.sectionHeaderContent}>
              <Text style={styles.sectionTitle}>
                ملاحظات الطلب
              </Text>

              <Text style={styles.sectionSubtitle}>
                التعليمات الخاصة بالتوصيل
              </Text>
            </View>
          </View>

          <View style={styles.noteBox}>
            <Text style={styles.noteText}>
              {order?.customerNote ||
                "لا توجد ملاحظات خاصة بهذا الطلب."}
            </Text>
          </View>
        </View>

        <View style={styles.card}>
          <View style={styles.sectionHeader}>
            <View style={styles.sectionIcon}>
              <Text style={styles.sectionIconText}>
                03
              </Text>
            </View>

            <View style={styles.sectionHeaderContent}>
              <Text style={styles.sectionTitle}>
                مراحل الطلب
              </Text>

              <Text style={styles.sectionSubtitle}>
                سجل حركة الطلب
              </Text>
            </View>
          </View>

          {events.length === 0 ? (
            <View style={styles.noEvents}>
              <Text style={styles.noEventsText}>
                لا توجد تحديثات مسجلة حتى الآن.
              </Text>
            </View>
          ) : (
            <View style={styles.timeline}>
              {events.map(
                (event: any, index: number) => {
                  const isLast =
                    index === events.length - 1;

                  return (
                    <View
                      key={String(
                        event?._id ??
                          event?.id ??
                          `${index}`
                      )}
                      style={styles.timelineItem}
                    >
                      <View style={styles.timelineRail}>
                        <View
                          style={[
                            styles.timelineDot,
                            index === 0 &&
                              styles.timelineDotActive,
                          ]}
                        />

                        {!isLast && (
                          <View
                            style={styles.timelineLine}
                          />
                        )}
                      </View>

                      <View
                        style={[
                          styles.eventContent,
                          !isLast &&
                            styles.eventContentSpacing,
                        ]}
                      >
                        <Text style={styles.eventName}>
                          {event?.message ||
                            event?.type ||
                            "تحديث على الطلب"}
                        </Text>

                        <Text style={styles.date}>
                          {event?.createdAt
                            ? new Date(
                                event.createdAt
                              ).toLocaleString(
                                "ar-IQ"
                              )
                            : "وقت غير متوفر"}
                        </Text>
                      </View>
                    </View>
                  );
                }
              )}
            </View>
          )}
        </View>

        {isDelivered && (
          <View style={styles.ratingCard}>
            <View style={styles.ratingIcon}>
              <Text style={styles.ratingIconText}>
                ★
              </Text>
            </View>

            <View style={styles.ratingContent}>
              <Text style={styles.ratingTitle}>
                هل انتهى التوصيل بشكل جيد؟
              </Text>

              <Text style={styles.ratingText}>
                يمكنك تقييم الكابتن بعد إتمام الطلب.
              </Text>
            </View>

            <AppButton
              title="تقييم الكابتن"
              onPress={openCaptainRating}
            />
          </View>
        )}

        <AppButton
          title={
            refreshing
              ? "جاري التحديث..."
              : "تحديث حالة الطلب"
          }
          onPress={handleRefresh}
          loading={refreshing}
        />

        <Text style={styles.footerHint}>
          يتم تحديث حالة الطلب تلقائيًا كل 10 ثوانٍ.
        </Text>
      </ScrollView>
    </Screen>
  );
}

function DetailRow({
  label,
  value,
  styles,
  appTheme,
  last = false,
}: {
  label: string;
  value: string;
  styles: ReturnType<typeof createStyles>;
  appTheme: ReturnType<typeof useAppTheme>;
  last?: boolean;
}) {
  return (
    <View
      style={[
        styles.detailRow,
        !last && styles.detailRowBorder,
      ]}
    >
      <Text style={styles.detailValue}>
        {value}
      </Text>

      <Text style={styles.detailLabel}>
        {label}
      </Text>
    </View>
  );
}

