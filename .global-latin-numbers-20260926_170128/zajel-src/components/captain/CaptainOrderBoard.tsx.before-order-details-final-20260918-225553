import React, {
  useCallback,
  useEffect,
  useState,
} from "react";
import {
  ActivityIndicator,
  Alert,
  Modal,
  Pressable,
  StyleSheet,
  Text,
  TextInput,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";
import {
  claimCaptainOrder,
  getCaptainOrderBoard,
  rejectCaptainOrder,
} from "../../api/captainOrderBoard";
import { getOrder } from "../../api/orders";

const ORANGE = "#F97316";
const WHITE = "#FFFFFF";
const TEXT = "#21170F";
const MUTED = "#8D8175";
const GREEN = "#16A34A";
const RED = "#EF4444";

const DEFAULT_MAX_ORDERS = 3;

const REJECTABLE_STATUSES = [
  "assigned",
  "heading_to_shop",
  "arrived_at_shop",
];

function orderIdOf(order: any) {
  return String(
    order?.id ||
      order?._id ||
      order?.orderNumber ||
      "",
  );
}

function orderNumberOf(order: any) {
  return String(
    order?.orderNumber ||
      order?.id ||
      order?._id ||
      "—",
  );
}

function restaurantOf(order: any) {
  return (
    order?.restaurantName ||
    order?.shopName ||
    order?.establishmentName ||
    order?.establishment?.name ||
    "المطعم / المتجر"
  );
}

function customerOf(order: any) {
  return (
    order?.customerName ||
    order?.customer?.name ||
    order?.customer?.fullName ||
    "العميل"
  );
}

function addressOf(order: any) {
  return (
    order?.deliveryAddress ||
    order?.customerAddress ||
    order?.address?.address ||
    order?.address?.label ||
    "عنوان التوصيل غير متوفر"
  );
}

function totalOf(order: any) {
  const value =
    order?.total ??
    order?.totalAmount ??
    order?.amount ??
    order?.price;

  if (
    value === null ||
    value === undefined ||
    value === ""
  ) {
    return "غير متوفر";
  }

  return `${value} د.ع`;
}

function dateOf(order: any) {
  const value =
    order?.createdAt ||
    order?.assignedAt;

  if (!value) {
    return "غير متوفر";
  }

  const date = new Date(value);

  if (
    Number.isNaN(
      date.getTime()
    )
  ) {
    return "غير متوفر";
  }

  return date.toLocaleString(
    "ar-IQ",
    {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
    }
  );
}

export default function CaptainOrderBoard() {
  const [activeOrders, setActiveOrders] =
    useState<any[]>([]);

  const [availableOrders, setAvailableOrders] =
    useState<any[]>([]);

  const [maxOrders, setMaxOrders] =
    useState(DEFAULT_MAX_ORDERS);

  const [openedPanel, setOpenedPanel] =
    useState<
      "active" | "available" | null
    >(null);

  const [expandedActiveId, setExpandedActiveId] =
    useState<string | null>(null);

  const [detailsById, setDetailsById] =
    useState<Record<string, any>>({});

  const [detailsLoadingId, setDetailsLoadingId] =
    useState<string | null>(null);

  const [claimingId, setClaimingId] =
    useState<string | null>(null);

  const [loading, setLoading] =
    useState(true);

  const [rejectVisible, setRejectVisible] =
    useState(false);

  const [rejectingId, setRejectingId] =
    useState<string | null>(null);

  const [rejectReason, setRejectReason] =
    useState("");

  const loadBoard = useCallback(
    async (showLoader = false) => {
      try {
        if (showLoader) {
          setLoading(true);
        }

        const result =
          await getCaptainOrderBoard();

        setActiveOrders(
          Array.isArray(
            result?.activeOrders
          )
            ? result.activeOrders
            : []
        );

        setAvailableOrders(
          Array.isArray(
            result?.availableOrders
          )
            ? result.availableOrders
            : []
        );

        setMaxOrders(
          Number(
            result?.maxActiveOrders
          ) > 0
            ? Number(
                result.maxActiveOrders
              )
            : DEFAULT_MAX_ORDERS
        );
      } catch {
        if (showLoader) {
          Alert.alert(
            "تعذر تحديث الطلبات",
            "حدث خطأ أثناء تحميل الطلبات.",
          );
        }
      } finally {
        if (showLoader) {
          setLoading(false);
        }
      }
    },
    []
  );

  useEffect(() => {
    void loadBoard(true);

    const timer =
      setInterval(
        () => {
          void loadBoard(false);
        },
        4000
      );

    return () =>
      clearInterval(timer);
  }, [loadBoard]);

  async function openActiveDetails(
    order: any
  ) {
    const id = orderIdOf(order);

    if (!id) return;

    const expanded =
      expandedActiveId === id;

    setExpandedActiveId(
      expanded
        ? null
        : id
    );

    if (
      expanded ||
      detailsById[id]
    ) {
      return;
    }

    try {
      setDetailsLoadingId(id);

      const result =
        await getOrder(id);

      const details =
        result?.order ||
        result?.data?.order ||
        result?.data ||
        result;

      setDetailsById(
        (previous) => ({
          ...previous,
          [id]: details,
        })
      );
    } catch {
      Alert.alert(
        "تعذر تحميل التفاصيل",
        "لم نتمكن من تحميل تفاصيل هذا الطلب.",
      );
    } finally {
      setDetailsLoadingId(null);
    }
  }

  async function claim(order: any) {
    const id = orderIdOf(order);

    if (!id) return;

    if (
      activeOrders.length >=
      maxOrders
    ) {
      Alert.alert(
        "الطلبات النشطة ممتلئة",
        `لديك ${maxOrders} طلبات نشطة بالفعل.`,
      );
      return;
    }

    try {
      setClaimingId(id);

      await claimCaptainOrder(id);

      await loadBoard(false);

      setOpenedPanel("active");

      Alert.alert(
        "تم حجز الطلب",
        "تمت إضافة الطلب إلى الطلبات النشطة.",
      );
    } catch (error: any) {
      await loadBoard(false);

      const message =
        error?.response?.data?.message ||
        error?.message ||
        "الطلب لم يعد متاحًا.";

      Alert.alert(
        "تعذر حجز الطلب",
        message,
      );
    } finally {
      setClaimingId(null);
    }
  }

  function openReject(
    order: any
  ) {
    const status =
      String(order?.status || "");

    if (
      !REJECTABLE_STATUSES.includes(
        status
      )
    ) {
      Alert.alert(
        "لا يمكن رفض الطلب الآن",
        "بعد استلام الطلب من المطعم لا يمكن استخدام الرفض من هذه القائمة.",
      );
      return;
    }

    setRejectingId(
      orderIdOf(order)
    );

    setRejectReason("");
    setRejectVisible(true);
  }

  async function confirmReject() {
    const id =
      String(
        rejectingId || ""
      );

    const reason =
      rejectReason.trim();

    if (!id) return;

    if (reason.length < 3) {
      Alert.alert(
        "سبب الرفض مطلوب",
        "اكتب سببًا واضحًا للرفض.",
      );
      return;
    }

    try {
      await rejectCaptainOrder(
        id,
        reason
      );

      setRejectVisible(false);
      setRejectingId(null);
      setRejectReason("");
      setExpandedActiveId(null);

      await loadBoard(false);

      Alert.alert(
        "تم رفض الطلب",
        "تم نقل الطلب إلى تاريخ الطلبات.",
      );
    } catch (error: any) {
      const message =
        error?.response?.data?.message ||
        error?.message ||
        "تعذر رفض الطلب.";

      Alert.alert(
        "تعذر رفض الطلب",
        message,
      );
    }
  }

  return (
    <View style={styles.wrapper}>
      <View style={styles.cardsRow}>
        <Pressable
          onPress={() =>
            setOpenedPanel(
              openedPanel === "active"
                ? null
                : "active"
            )
          }
          style={[
            styles.summaryCard,
            openedPanel === "active" &&
              styles.summaryCardActive,
          ]}
        >
          <View
            style={[
              styles.iconBox,
              {
                backgroundColor:
                  "#FFF1E7",
              },
            ]}
          >
            <Ionicons
              name="cube-outline"
              size={22}
              color={ORANGE}
            />
          </View>

          <Text style={styles.summaryTitle}>
            الطلبات النشطة
          </Text>

          <Text style={styles.summaryCount}>
            {activeOrders.length} /{" "}
            {maxOrders}
          </Text>

          <Text style={styles.summaryHint}>
            الطلبات التي حجزتها
          </Text>
        </Pressable>

        <Pressable
          onPress={() =>
            setOpenedPanel(
              openedPanel === "available"
                ? null
                : "available"
            )
          }
          style={[
            styles.summaryCard,
            openedPanel ===
              "available" &&
              styles.summaryCardAvailable,
          ]}
        >
          <View
            style={[
              styles.iconBox,
              {
                backgroundColor:
                  "#ECFDF3",
              },
            ]}
          >
            <Ionicons
              name="layers-outline"
              size={22}
              color={GREEN}
            />
          </View>

          <Text style={styles.summaryTitle}>
            الطلبات المتاحة
          </Text>

          <Text style={styles.summaryCount}>
            {availableOrders.length}
          </Text>

          <Text style={styles.summaryHint}>
            طلب متاح للحجز
          </Text>
        </Pressable>
      </View>

      {openedPanel === "active" ? (
        <View style={styles.panel}>
          <View style={styles.panelHeader}>
            <View>
              <Text style={styles.panelTitle}>
                الطلبات النشطة
              </Text>

              <Text style={styles.panelSubtitle}>
                {activeOrders.length} /{" "}
                {maxOrders}
              </Text>
            </View>

            {loading ? (
              <ActivityIndicator
                size="small"
                color={ORANGE}
              />
            ) : null}
          </View>

          {activeOrders.length === 0 ? (
            <View style={styles.empty}>
              <Ionicons
                name="file-tray-outline"
                size={30}
                color="#C5B7A8"
              />

              <Text style={styles.emptyTitle}>
                لا توجد طلبات نشطة
              </Text>

              <Text style={styles.emptyText}>
                احجز طلبًا من قائمة الطلبات المتاحة.
              </Text>
            </View>
          ) : (
            activeOrders.map(
              (order) => {
                const id =
                  orderIdOf(order);

                const expanded =
                  expandedActiveId ===
                  id;

                const details =
                  detailsById[id] ||
                  order;

                const canReject =
                  REJECTABLE_STATUSES.includes(
                    String(
                      order?.status || ""
                    )
                  );

                return (
                  <View
                    key={id}
                    style={
                      styles.activeCard
                    }
                  >
                    <View
                      style={
                        styles.activeTop
                      }
                    >
                      <View
                        style={
                          styles.numberBox
                        }
                      >
                        <Ionicons
                          name="receipt-outline"
                          size={18}
                          color={ORANGE}
                        />
                      </View>

                      <View
                        style={
                          styles.activeMain
                        }
                      >
                        <Text
                          style={
                            styles.orderNumber
                          }
                        >
                          #
                          {orderNumberOf(
                            order
                          )}
                        </Text>

                        <Text
                          style={
                            styles.activeRestaurant
                          }
                          numberOfLines={
                            1
                          }
                        >
                          {restaurantOf(
                            order
                          )}
                        </Text>
                      </View>

                      <View
                        style={
                          styles.assignedPill
                        }
                      >
                        <Text
                          style={
                            styles.assignedText
                          }
                        >
                          محجوز
                        </Text>
                      </View>
                    </View>

                    <View
                      style={
                        styles.actionRow
                      }
                    >
                      <Pressable
                        onPress={() =>
                          void openActiveDetails(
                            order
                          )
                        }
                        style={
                          styles.detailsButton
                        }
                      >
                        <Ionicons
                          name={
                            expanded
                              ? "chevron-up"
                              : "eye-outline"
                          }
                          size={17}
                          color={ORANGE}
                        />

                        <Text
                          style={
                            styles.detailsButtonText
                          }
                        >
                          عرض تفاصيل الطلب
                        </Text>
                      </Pressable>

                      {canReject ? (
                        <Pressable
                          onPress={() =>
                            openReject(
                              order
                            )
                          }
                          style={
                            styles.rejectButton
                          }
                        >
                          <Ionicons
                            name="close-circle-outline"
                            size={17}
                            color={RED}
                          />

                          <Text
                            style={
                              styles.rejectButtonText
                            }
                          >
                            رفض الطلب
                          </Text>
                        </Pressable>
                      ) : null}
                    </View>

                    {expanded ? (
                      <View
                        style={
                          styles.detailsCard
                        }
                      >
                        {detailsLoadingId ===
                        id ? (
                          <ActivityIndicator
                            size="small"
                            color={
                              ORANGE
                            }
                          />
                        ) : (
                          <>
                            <Text
                              style={
                                styles.detailsTitle
                              }
                            >
                              تفاصيل الطلب
                            </Text>

                            <View
                              style={
                                styles.detailGrid
                              }
                            >
                              <View
                                style={
                                  styles.detailItem
                                }
                              >
                                <Text
                                  style={
                                    styles.detailLabel
                                  }
                                >
                                  المطعم / المتجر
                                </Text>

                                <Text
                                  style={
                                    styles.detailValue
                                  }
                                >
                                  {restaurantOf(
                                    details
                                  )}
                                </Text>
                              </View>

                              <View
                                style={
                                  styles.detailItem
                                }
                              >
                                <Text
                                  style={
                                    styles.detailLabel
                                  }
                                >
                                  العميل
                                </Text>

                                <Text
                                  style={
                                    styles.detailValue
                                  }
                                >
                                  {customerOf(
                                    details
                                  )}
                                </Text>
                              </View>

                              <View
                                style={[
                                  styles.detailItem,
                                  styles.fullWidth,
                                ]}
                              >
                                <Text
                                  style={
                                    styles.detailLabel
                                  }
                                >
                                  عنوان التوصيل
                                </Text>

                                <Text
                                  style={
                                    styles.detailValue
                                  }
                                >
                                  {addressOf(
                                    details
                                  )}
                                </Text>
                              </View>

                              <View
                                style={
                                  styles.detailItem
                                }
                              >
                                <Text
                                  style={
                                    styles.detailLabel
                                  }
                                >
                                  رقم العميل
                                </Text>

                                <Text
                                  style={
                                    styles.detailValue
                                  }
                                >
                                  {details?.customerPhone ||
                                    details?.customer?.phone ||
                                    "غير متوفر"}
                                </Text>
                              </View>

                              <View
                                style={
                                  styles.detailItem
                                }
                              >
                                <Text
                                  style={
                                    styles.detailLabel
                                  }
                                >
                                  الإجمالي
                                </Text>

                                <Text
                                  style={[
                                    styles.detailValue,
                                    styles.price,
                                  ]}
                                >
                                  {totalOf(
                                    details
                                  )}
                                </Text>
                              </View>

                              <View
                                style={[
                                  styles.detailItem,
                                  styles.fullWidth,
                                ]}
                              >
                                <Text
                                  style={
                                    styles.detailLabel
                                  }
                                >
                                  تاريخ الطلب
                                </Text>

                                <Text
                                  style={
                                    styles.detailValue
                                  }
                                >
                                  {dateOf(
                                    details
                                  )}
                                </Text>
                              </View>

                              {details?.customerNote ? (
                                <View
                                  style={[
                                    styles.detailItem,
                                    styles.fullWidth,
                                  ]}
                                >
                                  <Text
                                    style={
                                      styles.detailLabel
                                    }
                                  >
                                    ملاحظة العميل
                                  </Text>

                                  <Text
                                    style={
                                      styles.detailValue
                                    }
                                  >
                                    {
                                      details.customerNote
                                    }
                                  </Text>
                                </View>
                              ) : null}
                            </View>

                            {Array.isArray(
                              details?.items
                            ) &&
                            details.items.length >
                              0 ? (
                              <View
                                style={
                                  styles.productsBox
                                }
                              >
                                <Text
                                  style={
                                    styles.detailLabel
                                  }
                                >
                                  المنتجات
                                </Text>

                                {details.items
                                  .slice(
                                    0,
                                    5
                                  )
                                  .map(
                                    (
                                      item: any,
                                      index: number
                                    ) => (
                                      <View
                                        key={`${id}-item-${index}`}
                                        style={
                                          styles.productRow
                                        }
                                      >
                                        <Text
                                          style={
                                            styles.productName
                                          }
                                        >
                                          {item?.productName ||
                                            item?.product?.name ||
                                            `منتج ${
                                              index +
                                              1
                                            }`}
                                        </Text>

                                        <Text
                                          style={
                                            styles.productQty
                                          }
                                        >
                                          ×{" "}
                                          {item?.quantity ??
                                            1}
                                        </Text>
                                      </View>
                                    )
                                  )}
                              </View>
                            ) : null}
                          </>
                        )}
                      </View>
                    ) : null}
                  </View>
                );
              }
            )
          )}
        </View>
      ) : null}

      {openedPanel === "available" ? (
        <View style={styles.panel}>
          <View style={styles.panelHeader}>
            <View>
              <Text style={styles.panelTitle}>
                الطلبات المتاحة
              </Text>

              <Text style={styles.panelSubtitle}>
                كل طلب يحجزه كابتن واحد فقط
              </Text>
            </View>

            {loading ? (
              <ActivityIndicator
                size="small"
                color={GREEN}
              />
            ) : null}
          </View>

          {availableOrders.length === 0 ? (
            <View style={styles.empty}>
              <Ionicons
                name="checkmark-circle-outline"
                size={30}
                color={GREEN}
              />

              <Text style={styles.emptyTitle}>
                لا توجد طلبات متاحة الآن
              </Text>

              <Text style={styles.emptyText}>
                سيظهر الطلب هنا عندما يصبح متاحًا لمنطقتك.
              </Text>
            </View>
          ) : (
            availableOrders.map(
              (order) => {
                const id =
                  orderIdOf(order);

                const full =
                  activeOrders.length >=
                  maxOrders;

                return (
                  <View
                    key={id}
                    style={
                      styles.availableCard
                    }
                  >
                    <View
                      style={
                        styles.activeTop
                      }
                    >
                      <View
                        style={[
                          styles.numberBox,
                          {
                            backgroundColor:
                              "#ECFDF3",
                          },
                        ]}
                      >
                        <Ionicons
                          name="cube-outline"
                          size={18}
                          color={GREEN}
                        />
                      </View>

                      <View
                        style={
                          styles.activeMain
                        }
                      >
                        <Text
                          style={
                            styles.orderNumber
                          }
                        >
                          #
                          {orderNumberOf(
                            order
                          )}
                        </Text>

                        <Text
                          style={
                            styles.activeRestaurant
                          }
                          numberOfLines={
                            1
                          }
                        >
                          {restaurantOf(
                            order
                          )}
                        </Text>
                      </View>

                      <View
                        style={
                          styles.availablePill
                        }
                      >
                        <Text
                          style={
                            styles.availableText
                          }
                        >
                          طلب متاح
                        </Text>
                      </View>
                    </View>

                    <Text
                      style={
                        styles.availableAddress
                      }
                      numberOfLines={1}
                    >
                      {addressOf(
                        order
                      )}
                    </Text>

                    <View
                      style={
                        styles.availableBottom
                      }
                    >
                      <Text
                        style={
                          styles.availableTotal
                        }
                      >
                        {totalOf(
                          order
                        )}
                      </Text>

                      <Pressable
                        onPress={() =>
                          void claim(
                            order
                          )
                        }
                        disabled={
                          claimingId ===
                            id ||
                          full
                        }
                        style={[
                          styles.claimButton,
                          full &&
                            styles.claimButtonDisabled,
                        ]}
                      >
                        {claimingId ===
                        id ? (
                          <ActivityIndicator
                            size="small"
                            color={WHITE}
                          />
                        ) : (
                          <>
                            <Ionicons
                              name="hand-left-outline"
                              size={17}
                              color={
                                WHITE
                              }
                            />

                            <Text
                              style={
                                styles.claimText
                              }
                            >
                              {full
                                ? "السعة ممتلئة"
                                : "حجز الطلب"}
                            </Text>
                          </>
                        )}
                      </Pressable>
                    </View>
                  </View>
                );
              }
            )
          )}
        </View>
      ) : null}

      <Modal
        visible={rejectVisible}
        transparent
        animationType="fade"
        onRequestClose={() =>
          setRejectVisible(false)
        }
      >
        <View
          style={
            styles.modalBackdrop
          }
        >
          <View
            style={
              styles.modalCard
            }
          >
            <View
              style={
                styles.modalIcon
              }
            >
              <Ionicons
                name="close-circle-outline"
                size={28}
                color={RED}
              />
            </View>

            <Text
              style={
                styles.modalTitle
              }
            >
              رفض الطلب
            </Text>

            <Text
              style={
                styles.modalText
              }
            >
              كتابة سبب الرفض إلزامية حتى يتم حفظه في تاريخ الطلبات.
            </Text>

            <TextInput
              value={
                rejectReason
              }
              onChangeText={
                setRejectReason
              }
              placeholder="اكتب سبب الرفض..."
              placeholderTextColor="#B0A49A"
              multiline
              textAlignVertical="top"
              maxLength={500}
              style={
                styles.reasonInput
              }
            />

            <View
              style={
                styles.modalActions
              }
            >
              <Pressable
                onPress={() =>
                  setRejectVisible(
                    false
                  )
                }
                style={
                  styles.cancelButton
                }
              >
                <Text
                  style={
                    styles.cancelButtonText
                  }
                >
                  إلغاء
                </Text>
              </Pressable>

              <Pressable
                onPress={() =>
                  void confirmReject()
                }
                style={[
                  styles.confirmRejectButton,
                  rejectReason.trim().length <
                    3 &&
                    styles.disabledConfirm,
                ]}
              >
                <Text
                  style={
                    styles.confirmRejectText
                  }
                >
                  تأكيد الرفض
                </Text>
              </Pressable>
            </View>
          </View>
        </View>
      </Modal>
    </View>
  );
}

