import { useEffect, useState } from "react";
import { api } from "../lib/api";

export default function NotificationRules() {
  const [rules, setRules] = useState<any[]>([]);

  async function load() {
    const response = await api.get(
      "/completion/notification-rules",
    );
    setRules(response.data.rules || []);
  }

  async function toggle(rule: any) {
    await api.put(
      `/completion/notification-rules/${rule.event}`,
      {
        event: rule.event,
        enabled: !rule.enabled,
        recipients:
          rule.recipients || [],
        title: rule.title,
        message: rule.message,
      },
    );

    await load();
  }

  useEffect(() => {
    void load();
  }, []);

  return (
    <div className="admin-page">
      <h1>إشعارات الأحداث</h1>

      {rules.map((rule) => (
        <div
          className="admin-card"
          key={rule._id}
        >
          <h2>{rule.title}</h2>
          <p>{rule.message}</p>

          <button
            onClick={() => toggle(rule)}
          >
            {rule.enabled
              ? "🚫 تعطيل"
              : "✅ تفعيل"}
          </button>
        </div>
      ))}
    </div>
  );
}
