function idOf(value: unknown): string {
  if (!value) return "";

  if (typeof value === "string") {
    return value;
  }

  if (typeof value === "object" && value !== null && "_id" in value) {
    const id = (value as { _id?: unknown })._id;
    return typeof id === "string" ? id : "";
  }

  return "";
}

function unwrapArray<T = unknown>(payload: unknown): T[] {
  if (Array.isArray(payload)) {
    return payload as T[];
  }

  if (!payload || typeof payload !== "object") {
    return [];
  }

  const object = payload as Record<string, unknown>;

  const candidates = [
    object.data,
    object.items,
    object.results,
    object.locations,
    object.establishments,
    object.geofences,
    object.rules,
  ];

  for (const candidate of candidates) {
    if (Array.isArray(candidate)) {
      return candidate as T[];
    }

    if (
      candidate &&
      typeof candidate === "object" &&
      Array.isArray((candidate as Record<string, unknown>).items)
    ) {
      return (candidate as Record<string, unknown>)
        .items as T[];
    }
  }

  return [];
}

function toDateTimeLocal(value?: string | null) {
  if (!value) return "";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "";
  }

  const local = new Date(
    date.getTime() - date.getTimezoneOffset() * 60000,
  );

  return local.toISOString().slice(0, 16);
}

function toIsoOrNull(value: string) {
  if (!value) return null;

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return null;
  }

  return date.toISOString();
}

function getRuleSummary(row: PricingRule) {
  switch (row.type) {
    case "default":
      return "تطبق كقاعدة أساسية عند عدم وجود قاعدة أكثر تخصيصًا.";

    case "governorate":
      return "تطبق على المحافظة المحددة.";

    case "area":
      return "تطبق على المنطقة المحددة.";

    case "area_to_area":
      return "تطبق على مسار منطقة إلى منطقة محدد.";

    case "establishment":
      return "تطبق على منشأة محددة.";

    case "establishment_type":
      return `تطبق على جميع ${
        row.establishmentType === "restaurant"
          ? "المطاعم"
          : "المحلات"
      }.`;

    case "geofence_to_geofence":
      return "تطبق بين منطقتين جغرافيتين محددتين.";

    default:
      return "";
  }
}


function PricingGeofenceEditor({
  geofences,
  onSaved,
}: {
  geofences: GeofenceItem[];
  onSaved: () => void;
}) {
  const mapRef = useRef<HTMLDivElement | null>(null);
  const leafletRef = useRef<any>(null);
  const mapInstanceRef = useRef<any>(null);
  const polygonRef = useRef<any>(null);
  const markersRef = useRef<any[]>([]);
  const pointsRef = useRef<[number, number][]>([]);

  const [name, setName] = useState("");
  const [description, setDescription] = useState("");
  const [points, setPoints] = useState<[number, number][]>([]);
  const [saving, setSaving] = useState(false);
  const [mapReady, setMapReady] = useState(false);

  useEffect(() => {
    let cancelled = false;

    async function loadLeaflet() {
      if ((window as any).L) {
        leafletRef.current = (window as any).L;
        setMapReady(true);
        return;
      }

      const cssId = "dzwAN-leaflet-css";
      if (!document.getElementById(cssId)) {
        const link = document.createElement("link");
        link.id = cssId;
        link.rel = "stylesheet";
        link.href =
          "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
        document.head.appendChild(link);
      }

      await new Promise<void>((resolve, reject) => {
        const existing = document.getElementById(
          "dzwAN-leaflet-js",
        );

        if (existing) {
          existing.addEventListener("load", () => resolve(), {
            once: true,
          });
          existing.addEventListener("error", () => reject(), {
            once: true,
          });
          return;
        }

        const script = document.createElement("script");
        script.id = "dzwAN-leaflet-js";
        script.src =
          "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
        script.onload = () => resolve();
        script.onerror = () => reject();
        document.body.appendChild(script);
      });

      if (!cancelled) {
        leafletRef.current = (window as any).L;
        setMapReady(true);
      }
    }

    loadLeaflet().catch(() => {
      if (!cancelled) {
        setMapReady(false);
      }
    });

    return () => {
      cancelled = true;
    };
  }, []);

  useEffect(() => {
    if (!mapReady || !mapRef.current || mapInstanceRef.current) {
      return;
    }

    const L = leafletRef.current;

    const map = L.map(mapRef.current, {
      center: [30.5085, 47.7804],
      zoom: 11,
      zoomControl: true,
    });

    L.tileLayer(
      "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
      {
        maxZoom: 19,
        attribution: "&copy; OpenStreetMap",
      },
    ).addTo(map);

    map.on("click", (event: any) => {
      const point: [number, number] = [
        Number(event.latlng.lat.toFixed(6)),
        Number(event.latlng.lng.toFixed(6)),
      ];

      const next = [...pointsRef.current, point];
      pointsRef.current = next;
      setPoints(next);

      const marker = L.circleMarker(point, {
        radius: 6,
        color: "#D85B18",
        fillColor: "#D85B18",
        fillOpacity: 1,
        weight: 2,
      }).addTo(map);

      markersRef.current.push(marker);

      if (polygonRef.current) {
        map.removeLayer(polygonRef.current);
      }

      if (next.length >= 3) {
        polygonRef.current = L.polygon(next, {
          color: "#D85B18",
          fillColor: "#D85B18",
          fillOpacity: 0.22,
          weight: 3,
        }).addTo(map);
      }
    });

    mapInstanceRef.current = map;

    setTimeout(() => map.invalidateSize(), 250);

    return () => {
      map.remove();
      mapInstanceRef.current = null;
      polygonRef.current = null;
      markersRef.current = [];
    };
  }, [mapReady]);

  function clearDrawing() {
    const map = mapInstanceRef.current;

    if (map && polygonRef.current) {
      map.removeLayer(polygonRef.current);
    }

    for (const marker of markersRef.current) {
      map?.removeLayer(marker);
    }

    polygonRef.current = null;
    markersRef.current = [];
    pointsRef.current = [];
    setPoints([]);
  }

  async function saveGeofence() {
    if (!name.trim()) {
      alert("اكتب اسم المنطقة الجغرافية.");
      return;
    }

    if (points.length < 3) {
      alert("حدد 3 نقاط على الأقل على الخريطة.");
      return;
    }

    setSaving(true);

    try {
      await api.post("/geofences", {
        name: name.trim(),
        description: description.trim() || null,
        coordinates: points,
        isActive: true,
      });

      setName("");
      setDescription("");
      clearDrawing();
      onSaved();
      alert("تم حفظ المنطقة الجغرافية بنجاح.");
    } catch (error) {
      alert(
        getApiErrorMessage(
          error,
          "تعذر حفظ المنطقة الجغرافية.",
        ),
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <section className="pricing-map-editor">
      <div className="pricing-map-editor-header">
        <div>
          <span className="pricing-map-kicker">
            إنشاء منطقة جغرافية
          </span>

          <h2>
            ارسم منطقة التوصيل على الخريطة
          </h2>

          <p>
            اضغط على الخريطة نقطة وراء نقطة لتحديد حدود المنطقة.
            عند تحديد 3 نقاط أو أكثر سيظهر الشكل الجغرافي تلقائيًا.
          </p>
        </div>

        <div className="pricing-map-count">
          <strong>{points.length}</strong>
          <span>نقاط محددة</span>
        </div>
      </div>

      <div className="pricing-map-layout">
        <div className="pricing-map-canvas-wrap">
          {!mapReady && (
            <div className="pricing-map-loading">
              جاري تجهيز الخريطة...
            </div>
          )}

          <div
            ref={mapRef}
            className="pricing-map-canvas"
          />

          {mapReady && (
            <div className="pricing-map-hint">
              اضغط على الخريطة لإضافة نقاط حدود المنطقة
            </div>
          )}
        </div>

        <div className="pricing-map-form">
          <div className="pricing-map-form-title">
            بيانات المنطقة
          </div>

          <label>
            اسم المنطقة
            <input
              value={name}
              onChange={(event) =>
                setName(event.target.value)
              }
              placeholder="مثال: وسط البصرة"
            />
          </label>

          <label>
            الوصف
            <textarea
              value={description}
              onChange={(event) =>
                setDescription(event.target.value)
              }
              placeholder="مثال: منطقة المطاعم والأسواق"
              rows={4}
            />
          </label>

          <div className="pricing-map-existing">
            <span>المناطق الموجودة</span>

            <strong>
              {geofences.length}
            </strong>
          </div>

          <div className="pricing-map-actions">
            <button
              type="button"
              className="btn"
              onClick={clearDrawing}
              disabled={!points.length || saving}
            >
              مسح الرسم
            </button>

            <button
              type="button"
              className="btn btn-primary"
              onClick={() => void saveGeofence()}
              disabled={saving}
            >
              {saving ? "جاري الحفظ..." : "حفظ المنطقة"}
            </button>
          </div>
        </div>
      </div>
    </section>
  );
}


function RestaurantPriceOverrideEditor({
  establishments,
}: {
  establishments: EstablishmentItem[];
}) {
  type RestaurantOverride = {
    _id: string;
    scope: string;
    establishmentId?: string | { _id: string };
    price: number;
    priority?: number;
    isActive?: boolean;
  };

  const restaurants = useMemo(
    () =>
      establishments.filter(
        (item) => item.type === "restaurant",
      ),
    [establishments],
  );

  const [overrides, setOverrides] = useState<RestaurantOverride[]>([]);
  const [restaurantId, setRestaurantId] = useState("");
  const [price, setPrice] = useState("");
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState("");
  const [error, setError] = useState("");

  function idOfEstablishment(value: unknown) {
    if (!value) return "";

    if (typeof value === "string") {
      return value;
    }

    if (
      typeof value === "object" &&
      value !== null &&
      "_id" in value
    ) {
      const id = (value as { _id?: unknown })._id;
      return typeof id === "string" ? id : "";
    }

    return "";
  }

  function restaurantName(id: string) {
    return (
      restaurants.find(
        (item) => item._id === id,
      )?.name || "مطعم غير معروف"
    );
  }

  async function loadOverrides() {
    try {
      setLoading(true);
      setError("");

      const response = await api.get(
        "/delivery-price-overrides",
      );

      const rows = Array.isArray(response.data?.data)
        ? response.data.data
        : [];

      setOverrides(
        rows.filter(
          (row: RestaurantOverride) =>
            row.scope === "establishment" &&
            row.isActive !== false,
        ),
      );
    } catch (error) {
      setError(
        getApiErrorMessage(
          error,
          "تعذر تحميل أسعار المطاعم المخصصة.",
        ),
      );
    } finally {
      setLoading(false);
    }
  }

  function selectRestaurant(id: string) {
    setRestaurantId(id);
    setError("");
    setMessage("");

    const existing = overrides.find(
      (row) =>
        row.scope === "establishment" &&
        idOfEstablishment(row.establishmentId) === id,
    );

    setPrice(
      existing ? String(existing.price ?? "") : "",
    );
  }

  async function saveRestaurantPrice() {
    setError("");
    setMessage("");

    const numericPrice = Number(price);

    if (!restaurantId) {
      setError("اختر المطعم أولًا.");
      return;
    }

    if (
      !price.trim() ||
      !Number.isFinite(numericPrice) ||
      numericPrice < 0
    ) {
      setError("أدخل سعر توصيل صحيح.");
      return;
    }

    try {
      setSaving(true);

      const existing = overrides.find(
        (row) =>
          row.scope === "establishment" &&
          idOfEstablishment(row.establishmentId) ===
            restaurantId,
      );

      if (existing) {
        await api.patch(
          `/delivery-price-overrides/${existing._id}`,
          {
            scope: "establishment",
            establishmentId: restaurantId,
            price: numericPrice,
            priority: Number(
              existing.priority ?? 0,
            ),
            isActive: true,
          },
        );
      } else {
        await api.post(
          "/delivery-price-overrides",
          {
            scope: "establishment",
            establishmentId: restaurantId,
            price: numericPrice,
            priority: 0,
            isActive: true,
          },
        );
      }

      setMessage(
        `تم حفظ السعر المخصص لـ ${restaurantName(
          restaurantId,
        )} وسيُستخدم لكل طلباته.`,
      );

      await loadOverrides();
    } catch (error) {
      setError(
        getApiErrorMessage(
          error,
          "تعذر حفظ السعر المخصص للمطعم.",
        ),
      );
    } finally {
      setSaving(false);
    }
  }

  async function deleteRestaurantPrice(
    item: RestaurantOverride,
  ) {
    const id = idOfEstablishment(
      item.establishmentId,
    );

    const confirmed = window.confirm(
      `حذف السعر المخصص لـ ${restaurantName(id)}؟`,
    );

    if (!confirmed) {
      return;
    }

    try {
      setSaving(true);
      setError("");
      setMessage("");

      await api.delete(
        `/delivery-price-overrides/${item._id}`,
      );

      if (restaurantId === id) {
        setPrice("");
      }

      setMessage(
        `تم إلغاء السعر الخاص بـ ${restaurantName(id)}.`,
      );

      await loadOverrides();
    } catch (error) {
      setError(
        getApiErrorMessage(
          error,
          "تعذر حذف السعر المخصص.",
        ),
      );
    } finally {
      setSaving(false);
    }
  }

  useEffect(() => {
    void loadOverrides();
  }, []);

  return (
    <section className="panel">
      <div className="page-section-title">
        <div>
          <span>تخصيص أسعار التوصيل</span>

          <h2>سعر مخصص لمطعم</h2>

          <p>
            اختر أي مطعم وحدد له سعر توصيل ثابتًا، وسيُستخدم
            هذا السعر في جميع طلبات المطعم.
          </p>
        </div>

        <div className="pricing-main-amount">
          <strong>{overrides.length}</strong>
          <span>أسعار خاصة</span>
        </div>
      </div>

      {(message || error) && (
        <div
          className={
            error
              ? "status status-inactive"
              : "status status-active"
          }
          style={{ marginBottom: 18 }}
        >
          {error || message}
        </div>
      )}

      <div className="form-grid">
        <label>
          المطعم
          <select
            value={restaurantId}
            disabled={saving}
            onChange={(event) =>
              selectRestaurant(event.target.value)
            }
          >
            <option value="">
              اختر المطعم
            </option>

            {restaurants.map((restaurant) => (
              <option
                key={restaurant._id}
                value={restaurant._id}
              >
                {restaurant.name}
              </option>
            ))}
          </select>
        </label>

        <label>
          السعر المخصص
          <input
            type="number"
            min="0"
            step="any"
            value={price}
            disabled={saving}
            onChange={(event) =>
              setPrice(event.target.value)
            }
            placeholder="مثال: 5000"
          />
        </label>
      </div>

      <div className="form-actions">
        <button
          type="button"
          className="btn btn-primary"
          disabled={saving || loading}
          onClick={() =>
            void saveRestaurantPrice()
          }
        >
          {saving
            ? "جاري الحفظ..."
            : "حفظ سعر المطعم"}
        </button>

        <button
          type="button"
          className="btn"
          disabled={saving || loading}
          onClick={() =>
            void loadOverrides()
          }
        >
          <RefreshCw size={15} />
          تحديث
        </button>
      </div>

      <div style={{ marginTop: 22 }}>
        {loading ? (
          <div className="empty-state">
            جاري تحميل أسعار المطاعم...
          </div>
        ) : overrides.length === 0 ? (
          <div className="empty-state">
            لا توجد أسعار مخصصة للمطاعم حاليًا.
          </div>
        ) : (
          <div className="cards-grid">
            {overrides.map((item) => {
              const id = idOfEstablishment(
                item.establishmentId,
              );

              return (
                <article
                  className="data-card"
                  key={item._id}
                >
                  <div className="data-card-header">
                    <div>
                      <strong>
                        {restaurantName(id)}
                      </strong>

                      <p>
                        سعر ثابت لجميع طلبات المطعم
                      </p>
                    </div>

                    <span className="status-active">
                      {Number(
                        item.price || 0,
                      ).toLocaleString("ar-IQ")}
                    </span>
                  </div>

                  <div className="data-card-actions">
                    <button
                      type="button"
                      className="btn"
                      disabled={saving}
                      onClick={() => {
                        setRestaurantId(id);
                        setPrice(
                          String(item.price ?? ""),
                        );
                        setError("");
                        setMessage("");
                      }}
                    >
                      <Edit3 size={15} />
                      تعديل
                    </button>

                    <button
                      type="button"
                      className="btn btn-danger"
                      disabled={saving}
                      onClick={() =>
                        void deleteRestaurantPrice(
                          item,
                        )
                      }
                    >
                      <Trash2 size={15} />
                      حذف السعر الخاص
                    </button>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>
    </section>
  );
}


