      borderColor: appTheme.borderColor,
    },

    mainKpi: {
      borderRadius: 22,
      backgroundColor: appTheme.primaryColor,
      padding: 20,
      marginBottom: 12,
    },

    kpiIcon: {
      width: 46,
      height: 46,
      borderRadius: 15,
      alignItems: "center",
      justifyContent: "center",
      backgroundColor: "rgba(255,255,255,0.16)",
      alignSelf: "flex-end",
      marginBottom: 14,
    },

    kpiLabel: {
      color: "rgba(255,255,255,0.78)",
      fontSize: 11,
      fontWeight: "700",
      textAlign: "right",
    },

    kpiValue: {
      color: "#FFFFFF",
      fontSize: 36,
      fontWeight: "900",
      textAlign: "right",
      marginTop: 2,
    },

    kpiHint: {
      color: "rgba(255,255,255,0.72)",
      fontSize: 11,
      fontWeight: "600",
      textAlign: "right",
      marginTop: 2,
    },

    metricsGrid: {
      flexDirection: "row-reverse",
      flexWrap: "wrap",
      justifyContent: "space-between",
      marginBottom: 10,
    },

    sectionHeader: {
      flexDirection: "row-reverse",
      alignItems: "center",
      justifyContent: "space-between",
      marginTop: 7,
      marginBottom: 9,
    },

    sectionTitle: {
      color: appTheme.textColor,
      fontSize: 17,
      fontWeight: "900",
      textAlign: "right",
    },

    sectionCount: {
      color: appTheme.secondaryTextColor,
      fontSize: 11,
      fontWeight: "700",
    },

    ordersCard: {
      backgroundColor: appTheme.cardColor,
      borderWidth: 1,
      borderColor: appTheme.borderColor,
      borderRadius: 20,
      paddingHorizontal: 15,
    },

    orderRow: {
      minHeight: 70,
      flexDirection: "row-reverse",
      alignItems: "center",
      borderBottomWidth: 1,
      borderBottomColor: appTheme.borderColor,
    },

    lastOrderRow: {
      borderBottomWidth: 0,
    },

    orderIcon: {
      width: 39,
      height: 39,
      borderRadius: 13,
      alignItems: "center",
      justifyContent: "center",
      marginLeft: 10,
      backgroundColor: `${appTheme.primaryColor}10`,
    },

    orderInfo: {
      flex: 1,
      alignItems: "flex-end",
    },

    orderNumber: {
      color: appTheme.textColor,
      fontSize: 13,
      fontWeight: "900",
      textAlign: "right",
    },

    orderStatus: {
      color: appTheme.secondaryTextColor,
      fontSize: 10,
      fontWeight: "600",
      marginTop: 3,
      textAlign: "right",
    },

    orderRight: {
      alignItems: "flex-end",
      marginRight: 10,
    },

    orderAmount: {
      color: appTheme.textColor,
      fontSize: 11,
      fontWeight: "800",
    },

    statusDot: {
      width: 7,
