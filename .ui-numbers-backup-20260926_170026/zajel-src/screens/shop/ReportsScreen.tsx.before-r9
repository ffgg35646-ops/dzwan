      borderRadius: 4,
      marginTop: 6,
    },

    empty: {
      alignItems: "center",
      justifyContent: "center",
      paddingVertical: 45,
      paddingHorizontal: 25,
    },

    emptyIcon: {
      width: 72,
      height: 72,
      borderRadius: 24,
      alignItems: "center",
      justifyContent: "center",
      backgroundColor: `${appTheme.primaryColor}10`,
      marginBottom: 14,
    },

    emptyTitle: {
