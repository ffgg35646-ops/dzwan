    const R = 6371;
    const dLat = rad(toLat - fromLat);
    const dLng = rad(toLng - fromLng);

    const a =
      Math.sin(dLat / 2) ** 2 +
      Math.cos(rad(fromLat)) *
        Math.cos(rad(toLat)) *
        Math.sin(dLng / 2) ** 2;

    return (
      R *
      2 *
      Math.atan2(
        Math.sqrt(a),
        Math.sqrt(1 - a),
      )
    );
  }

