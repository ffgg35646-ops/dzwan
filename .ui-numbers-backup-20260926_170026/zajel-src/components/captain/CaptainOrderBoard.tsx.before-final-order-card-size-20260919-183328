                              }
                            >
                              <View
                                style={
                                  styles.detailSectionHeader
                                }
                              >
                                <Ionicons
                                  name="time-outline"
                                  size={16}
                                  color={ORANGE}
                                />

                                <Text
                                  style={
                                    styles.detailSectionTitle
                                  }
                                >
                                  معلومات الطلب
                                </Text>
                              </View>

                              <View
                                style={
                                  styles.detailField
                                }
                              >
                                <Text
                                  style={
                                    styles.detailLabel
                                  }
                                >
                                  تاريخ الطلب
                                </Text>

                                <Text
                                  style={
                                    styles.detailValue
                                  }
                                >
                                  {dateOf(details)}
                                </Text>
                              </View>

                              {details?.customerNote ? (
                                <View
                                  style={
                                    styles.noteBox
                                  }
                                >
                                  <Text
                                    style={
                                      styles.noteLabel
                                    }
                                  >
                                    ملاحظة الزبون
                                  </Text>

                                  <Text
                                    style={
                                      styles.noteValue
                                    }
                                  >
                                    {details.customerNote}
                                  </Text>
                                </View>
                              ) : null}
                            </View>
                          </>
                        )}
                      </View>
                    ) : null}
                  </View>
                );
              }
            )
          )}
        </View>
      ) : null}

      {openedPanel === "available" ? (
        <View style={styles.panel}>
          <View style={styles.panelHeader}>
            <View>
              <Text style={styles.panelTitle}>
                الطلبات المتاحة
              </Text>

              <Text style={styles.panelSubtitle}>
                كل طلب يحجزه كابتن واحد فقط
              </Text>
            </View>

            {loading ? (
              <ActivityIndicator
                size="small"
                color={GREEN}
              />
            ) : null}
          </View>

          {availableOrders.length === 0 ? (
            <View style={styles.empty}>
              <Ionicons
                name="checkmark-circle-outline"
                size={30}
                color={GREEN}
              />

              <Text style={styles.emptyTitle}>
                لا توجد طلبات متاحة الآن
              </Text>

              <Text style={styles.emptyText}>
                سيظهر الطلب هنا عندما يصبح متاحًا لمنطقتك.
              </Text>
            </View>
          ) : (
            availableOrders.map(
              (order) => {
                const id =
                  orderIdOf(order);

                const full =
                  activeOrders.length >=
                  maxOrders;

                return (
                  <View
                    key={id}
                    style={
                      styles.availableCard
                    }
                  >
                    <View
                      style={
                        styles.activeTop
                      }
                    >
                      <View
                        style={[
                          styles.numberBox,
                          {
                            backgroundColor:
                              "#ECFDF3",
                          },
                        ]}
                      >
                        <Ionicons
                          name="cube-outline"
                          size={18}
                          color={GREEN}
                        />
                      </View>

                      <View
                        style={
                          styles.activeMain
                        }
                      >
                        <Text
                          style={
                            styles.orderNumber
                          }
                        >
                          #
                          {orderNumberOf(
                            order
                          )}
                        </Text>

                        <Text
                          style={
                            styles.activeRestaurant
                          }
                          numberOfLines={
                            1
                          }
                        >
                          {restaurantOf(
                            order
                          )}
                        </Text>
                      </View>

                      <View
                        style={
                          styles.availablePill
                        }
                      >
                        <Text
                          style={
                            styles.availableText
                          }
                        >
                          طلب متاح
                        </Text>
                      </View>
                    </View>

                    <Text
                      style={
                        styles.availableAddress
                      }
                      numberOfLines={1}
                    >
                      {addressOf(
                        order
                      )}
                    </Text>

                    <View
                      style={
                        styles.availableBottom
                      }
                    >
                      <Text
                        style={
                          styles.availableTotal
                        }
                      >
                        {totalOf(
                          order
                        )}
                      </Text>

                      <Pressable
                        onPress={() =>
                          void claim(
                            order
                          )
                        }
                        disabled={
                          claimingId ===
                            id ||
                          full
                        }
                        style={[
                          styles.claimButton,
                          full &&
                            styles.claimButtonDisabled,
                        ]}
                      >
                        {claimingId ===
                        id ? (
                          <ActivityIndicator
                            size="small"
                            color={WHITE}
                          />
                        ) : (
                          <>
                            <Ionicons
                              name="hand-left-outline"
                              size={17}
                              color={
                                WHITE
                              }
                            />

                            <Text
                              style={
                                styles.claimText
                              }
                            >
                              {full
                                ? "السعة ممتلئة"
                                : "حجز الطلب"}
                            </Text>
                          </>
                        )}
                      </Pressable>
                    </View>
                  </View>
                );
              }
            )
          )}
        </View>
      ) : null}

      <Modal
        visible={rejectVisible}
        transparent
        animationType="fade"
        onRequestClose={() =>
          setRejectVisible(false)
        }
      >
        <View
          style={
            styles.modalBackdrop
          }
        >
          <View
            style={
              styles.modalCard
            }
          >
            <View
              style={
                styles.modalIcon
              }
            >
              <Ionicons
                name="close-circle-outline"
                size={28}
                color={RED}
              />
            </View>

            <Text
              style={
                styles.modalTitle
              }
            >
              رفض الطلب
            </Text>

            <Text
              style={
                styles.modalText
              }
            >
              كتابة سبب الرفض إلزامية حتى يتم حفظه في تاريخ الطلبات.
            </Text>

            <TextInput
              value={
                rejectReason
              }
              onChangeText={
                setRejectReason
              }
              placeholder="اكتب سبب الرفض..."
              placeholderTextColor="#B0A49A"
              multiline
              textAlignVertical="top"
              maxLength={500}
              style={
                styles.reasonInput
              }
            />

            <View
              style={
                styles.modalActions
              }
            >
              <Pressable
                onPress={() =>
                  setRejectVisible(
                    false
                  )
                }
                style={
                  styles.cancelButton
                }
              >
                <Text
                  style={
                    styles.cancelButtonText
                  }
                >
                  إلغاء
                </Text>
              </Pressable>

              <Pressable
                onPress={() =>
                  void confirmReject()
                }
                style={[
                  styles.confirmRejectButton,
                  rejectReason.trim().length <
                    3 &&
                    styles.disabledConfirm,
                ]}
              >
                <Text
                  style={
                    styles.confirmRejectText
                  }
                >
                  تأكيد الرفض
                </Text>
              </Pressable>
            </View>
          </View>
        </View>
      </Modal>
    </View>
  );
}

