import React, {
  useCallback,
  useEffect,
  useState,
} from "react";
import {
  ActivityIndicator,
  Alert,
  Modal,
  Pressable,
  StyleSheet,
  Text,
  TextInput,
  View,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";
import {
  claimCaptainOrder,
  getCaptainOrderBoard,
  rejectCaptainOrder,
} from "../../api/captainOrderBoard";
import { getOrder } from "../../api/orders";
import { checkCurrentSelectedShift } from "../../api/captain";

const ORANGE = "#F97316";
const WHITE = "#FFFFFF";
const TEXT = "#21170F";
const MUTED = "#8D8175";
const GREEN = "#16A34A";
const RED = "#EF4444";

const DEFAULT_MAX_ORDERS = 3;

const REJECTABLE_STATUSES = [
  "assigned",
  "heading_to_shop",
  "arrived_at_shop",
];

function orderIdOf(order: any) {
  return String(
    order?.id ||
      order?._id ||
      order?.orderNumber ||
      "",
  );
}

function orderNumberOf(order: any) {
  return String(
    order?.orderNumber ||
      order?.id ||
      order?._id ||
      "—",
  );
}

function restaurantOf(order: any) {
  return (
    order?.restaurantName ||
    order?.shopName ||
    order?.establishmentName ||
    order?.establishment?.name ||
    "المطعم / المتجر"
  );
}

function customerOf(order: any) {
  return (
    order?.customerName ||
    order?.customer?.name ||
    order?.customer?.fullName ||
    "العميل"
  );
}

function addressOf(order: any) {
  return (
    order?.deliveryAddress ||
    order?.customerAddress ||
    order?.address?.address ||
    order?.address?.label ||
    "عنوان التوصيل غير متوفر"
  );
}

function totalOf(order: any) {
  const value =
    order?.total ??
    order?.totalAmount ??
    order?.amount ??
    order?.price;

  if (
    value === null ||
    value === undefined ||
    value === ""
  ) {
    return "غير متوفر";
  }

  return `${value} د.ع`;
}

function dateOf(order: any) {
  const value =
    order?.createdAt ||
    order?.assignedAt;

  if (!value) {
    return "غير متوفر";
  }

  const date = new Date(value);

  if (
    Number.isNaN(
      date.getTime()
    )
  ) {
    return "غير متوفر";
  }

  return date.toLocaleString(
    "ar-IQ",
    {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
    }
  );
}


function displayValue(
  value: any,
  fallback = "غير متوفر",
) {
  if (
    value === null ||
    value === undefined ||
    value === ""
  ) {
    return fallback;
  }

  return String(value);
}

function moneyValue(value: any) {
  if (
    value === null ||
    value === undefined ||
    value === ""
  ) {
    return "غير متوفر";
  }

  const numeric = Number(value);

  if (Number.isFinite(numeric)) {
    return `${numeric.toLocaleString("ar-IQ")} د.ع`;
  }

  return `${value} د.ع`;
}

function orderSubtotal(order: any) {
  return (
    order?.subtotal ??
    order?.subTotal ??
    order?.itemsSubtotal
  );
}

function orderDeliveryFee(order: any) {
  return (
    order?.deliveryFee ??
    order?.shippingFee ??
    order?.deliveryPrice
  );
}

function orderTotal(order: any) {
  return (
    order?.total ??
    order?.totalAmount ??
    order?.amount ??
    order?.price
  );
}

function restaurantPhone(order: any) {
  return (
    order?.establishment?.phone ||
    order?.restaurantPhone ||
    order?.shopPhone ||
    order?.establishmentPhone ||
    ""
  );
}

function restaurantAddress(order: any) {
  return (
    order?.establishment?.address ||
    order?.restaurantAddress ||
    order?.shopAddress ||
    order?.establishmentAddress ||
    ""
  );
}

function customerPhone(order: any) {
  return (
    order?.customerPhone ||
    order?.customer?.phone ||
    ""
  );
}

function customerAddress(order: any) {
  return (
    order?.deliveryAddress ||
    order?.customerAddress ||
    order?.address?.address ||
    order?.address?.label ||
    ""
  );
}

function productName(item: any) {
  return (
    item?.productName ||
    item?.product?.name ||
    item?.name ||
    "منتج"
  );
}

function productUnitPrice(item: any) {
  return (
    item?.unitPrice ??
    item?.price ??
    item?.product?.price ??
    item?.product?.sellingPrice
  );
}

function productLineTotal(item: any) {
  const direct =
    item?.lineTotal ??
    item?.total ??
    item?.subtotal;

  if (
    direct !== null &&
    direct !== undefined &&
    direct !== ""
  ) {
    return direct;
  }

  const unit = Number(
    productUnitPrice(item)
  );

  const quantity = Number(
    item?.quantity ?? 1
  );

  if (
    Number.isFinite(unit) &&
    Number.isFinite(quantity)
  ) {
    return unit * quantity;
  }

  return null;
}

export default function CaptainOrderBoard({ areaId }: { areaId?: string }) {
  const [activeOrders, setActiveOrders] =
    useState<any[]>([]);

  const [availableOrders, setAvailableOrders] =
    useState<any[]>([]);

  const [maxOrders, setMaxOrders] =
    useState(DEFAULT_MAX_ORDERS);

  const [openedPanel, setOpenedPanel] =
    useState<
      "active" | "available" | null
    >(null);

  const [expandedActiveId, setExpandedActiveId] =
    useState<string | null>(null);

  const [detailsById, setDetailsById] =
    useState<Record<string, any>>({});

  const [detailsLoadingId, setDetailsLoadingId] =
    useState<string | null>(null);

  const [claimingId, setClaimingId] =
    useState<string | null>(null);

  const [loading, setLoading] =
    useState(true);

  const [rejectVisible, setRejectVisible] =
    useState(false);

  const [rejectingId, setRejectingId] =
    useState<string | null>(null);

  const [rejectReason, setRejectReason] =
    useState("");

  const loadBoard = useCallback(
    async (showLoader = false) => {
      try {
        if (!areaId) {
          setActiveOrders([]);
          setAvailableOrders([]);
          setMaxOrders(DEFAULT_MAX_ORDERS);
          return;
        }

        if (showLoader) {
          setLoading(true);
        }

        /*
         * الشفت الحالي هو البوابة الحقيقية للطلبات.
         * لو لا يوجد شفت مختار/نشط الآن:
         * لا نعرض أي طلب متاح ولا أي طلب نشط.
         */
        try {
          await checkCurrentSelectedShift();
        } catch {
          setActiveOrders([]);
          setAvailableOrders([]);
          setMaxOrders(DEFAULT_MAX_ORDERS);
          return;
        }

        const result =
          await getCaptainOrderBoard(areaId);

        setActiveOrders(
          Array.isArray(
            result?.activeOrders
          )
            ? result.activeOrders
            : []
        );

        setAvailableOrders(
          Array.isArray(
            result?.availableOrders
          )
            ? result.availableOrders
            : []
        );

        setMaxOrders(
          Number(
            result?.maxActiveOrders
          ) > 0
            ? Number(
                result.maxActiveOrders
              )
            : DEFAULT_MAX_ORDERS
        );
      } catch {
        if (showLoader) {
          Alert.alert(
            "تعذر تحديث الطلبات",
            "حدث خطأ أثناء تحميل الطلبات.",
          );
        }
      } finally {
        if (showLoader) {
          setLoading(false);
        }
      }
    },
    []
  );

  useEffect(() => {
    void loadBoard(true);

    const timer =
      setInterval(
        () => {
          void loadBoard(false);
        },
        4000
      );

    return () =>
      clearInterval(timer);
  }, [loadBoard]);

  async function openActiveDetails(
    order: any
  ) {
    const id = orderIdOf(order);

    if (!id) return;

    const expanded =
      expandedActiveId === id;

    setExpandedActiveId(
      expanded
        ? null
        : id
    );

    if (
      expanded ||
      detailsById[id]
    ) {
      return;
    }

    try {
      setDetailsLoadingId(id);

      const result =
        await getOrder(id);

      const details =
        result?.order ||
        result?.data?.order ||
        result?.data ||
        result;

      setDetailsById(
        (previous) => ({
          ...previous,
          [id]: details,
        })
      );
    } catch {
      Alert.alert(
        "تعذر تحميل التفاصيل",
        "لم نتمكن من تحميل تفاصيل هذا الطلب.",
      );
    } finally {
      setDetailsLoadingId(null);
    }
  }

  async function claim(order: any) {
    const id = orderIdOf(order);

    if (!id) return;

    if (
      activeOrders.length >=
      maxOrders
    ) {
      Alert.alert(
        "الطلبات النشطة ممتلئة",
        `لديك ${maxOrders} طلبات نشطة بالفعل.`,
      );
      return;
    }

    try {
      setClaimingId(id);

      await claimCaptainOrder(id);

      await loadBoard(false);

      setOpenedPanel("active");

      Alert.alert(
        "تم حجز الطلب",
        "تمت إضافة الطلب إلى الطلبات النشطة.",
      );
    } catch (error: any) {
      await loadBoard(false);

      const message =
        error?.response?.data?.message ||
        error?.message ||
        "الطلب لم يعد متاحًا.";

      Alert.alert(
        "تعذر حجز الطلب",
        message,
      );
    } finally {
      setClaimingId(null);
    }
  }

  function openReject(
    order: any
  ) {
    const status =
      String(order?.status || "");

    if (
      !REJECTABLE_STATUSES.includes(
        status
      )
    ) {
      Alert.alert(
        "لا يمكن رفض الطلب الآن",
        "بعد استلام الطلب من المطعم لا يمكن استخدام الرفض من هذه القائمة.",
      );
      return;
    }

    setRejectingId(
      orderIdOf(order)
    );

    setRejectReason("");
    setRejectVisible(true);
  }

  async function confirmReject() {
    const id =
      String(
        rejectingId || ""
      );

    const reason =
      rejectReason.trim();

    if (!id) return;

    if (reason.length < 3) {
      Alert.alert(
        "سبب الرفض مطلوب",
        "اكتب سببًا واضحًا للرفض.",
      );
      return;
    }

    try {
      await rejectCaptainOrder(
        id,
        reason
      );

      setRejectVisible(false);
      setRejectingId(null);
      setRejectReason("");
      setExpandedActiveId(null);

      await loadBoard(false);

      Alert.alert(
        "تم رفض الطلب",
        "تم نقل الطلب إلى تاريخ الطلبات.",
      );
    } catch (error: any) {
      const message =
        error?.response?.data?.message ||
        error?.message ||
        "تعذر رفض الطلب.";

      Alert.alert(
        "تعذر رفض الطلب",
        message,
      );
    }
  }

  return (
    <View style={styles.wrapper}>
      <View
        style={{
          width: "100%",
          gap: 10,
          marginBottom: 2,
        }}
      >
        <Pressable
          onPress={() =>
            setOpenedPanel(
              openedPanel === "active"
                ? null
                : "active"
            )
          }
          style={({ pressed }) => [
            {
              width: "100%",
              height: 70,
              borderRadius: 18,
              paddingHorizontal: 16,
              backgroundColor: "#F97316",
              borderWidth: 1,
              borderColor: "#EA580C",
              flexDirection: "row-reverse",
              alignItems: "center",
            },
            pressed && {
              opacity: 0.9,
            },
            openedPanel === "active" && {
              backgroundColor: "#EA580C",
              borderColor: "#C2410C",
            },
          ]}
        >
          <View
            style={{
              width: 40,
              height: 40,
              borderRadius: 13,
              backgroundColor: "#C2410C",
              alignItems: "center",
              justifyContent: "center",
            }}
          >
            <Ionicons
              name="bicycle-outline"
              size={21}
              color="#FFFFFF"
            />
          </View>

          <Text
            style={{
              flex: 1,
              marginRight: 12,
              color: "#FFFFFF",
              fontSize: 14,
              fontWeight: "900",
            }}
          >
            الطلبات النشطة
          </Text>

          <Text
            style={{
              color: "#FFFFFF",
              fontSize: 21,
              fontWeight: "900",
            }}
          >
            {activeOrders.length} / {maxOrders}
          </Text>
        </Pressable>

        <Pressable
          onPress={() =>
            setOpenedPanel(
              openedPanel === "available"
                ? null
                : "available"
            )
          }
          style={({ pressed }) => [
            {
              width: "100%",
              height: 70,
              borderRadius: 18,
              paddingHorizontal: 16,
              backgroundColor: "#F7C948",
              borderWidth: 1,
              borderColor: "#D49A00",
              flexDirection: "row-reverse",
              alignItems: "center",
            },
            pressed && {
              opacity: 0.9,
            },
            openedPanel === "available" && {
              backgroundColor: "#EAB308",
              borderColor: "#CA8A04",
            },
          ]}
        >
          <View
            style={{
              width: 40,
              height: 40,
              borderRadius: 13,
              backgroundColor: "#B77900",
              alignItems: "center",
              justifyContent: "center",
            }}
          >
            <Ionicons
              name="layers-outline"
              size={21}
              color="#FFFFFF"
            />
          </View>

          <Text
            style={{
              flex: 1,
              marginRight: 12,
              color: "#FFFFFF",
              fontSize: 14,
              fontWeight: "900",
            }}
          >
            الطلبات المتاحة
          </Text>

          <Text
            style={{
              color: "#FFFFFF",
              fontSize: 21,
              fontWeight: "900",
            }}
          >
            {availableOrders.length}
          </Text>
        </Pressable>
      </View>

      {openedPanel === "active" ? (
        <View style={styles.panel}>
          <View style={styles.panelHeader}>
            <View>
              <Text style={styles.panelTitle}>
                الطلبات النشطة
              </Text>

              <Text style={styles.panelSubtitle}>
                {activeOrders.length} /{" "}
                {maxOrders}
              </Text>
            </View>

            {loading ? (
              <ActivityIndicator
                size="small"
                color={ORANGE}
              />
            ) : null}
          </View>

          {activeOrders.length === 0 ? (
            <View style={styles.empty}>
              <Ionicons
                name="file-tray-outline"
                size={30}
                color="#C5B7A8"
              />

              <Text style={styles.emptyTitle}>
                لا توجد طلبات نشطة
              </Text>

              <Text style={styles.emptyText}>
                احجز طلبًا من قائمة الطلبات المتاحة.
              </Text>
            </View>
          ) : (
            activeOrders.map(
              (order) => {
                const id =
                  orderIdOf(order);

                const expanded =
                  expandedActiveId ===
                  id;

                const details =
                  detailsById[id] ||
                  order;

                const canReject =
                  REJECTABLE_STATUSES.includes(
                    String(
                      order?.status || ""
                    )
                  );

                return (
                  <View
                    key={id}
                    style={
                      styles.activeCard
                    }
                  >
                    <View
                      style={
                        styles.activeTop
                      }
                    >
                      <View
                        style={
                          styles.numberBox
                        }
                      >
                        <Ionicons
                          name="receipt-outline"
                          size={18}
                          color={ORANGE}
                        />
                      </View>

                      <View
                        style={
                          styles.activeMain
                        }
                      >
                        <Text
                          style={
                            styles.orderNumber
                          }
                        >
                          #
                          {orderNumberOf(
                            order
                          )}
                        </Text>

                        <Text
                          style={
                            styles.activeRestaurant
                          }
                          numberOfLines={
                            1
                          }
                        >
                          {restaurantOf(
                            order
                          )}
                        </Text>
                      </View>

                      <View
                        style={
                          styles.assignedPill
                        }
                      >
                        <Text
                          style={
                            styles.assignedText
                          }
                        >
                          محجوز
                        </Text>
                      </View>
                    </View>

                    <View
                      style={
                        styles.actionRow
                      }
                    >
                      <Pressable
                        onPress={() =>
                          void openActiveDetails(
                            order
                          )
                        }
                        style={
                          styles.detailsButton
                        }
                      >
                        <Ionicons
                          name={
                            expanded
                              ? "chevron-up"
                              : "eye-outline"
                          }
                          size={17}
                          color={ORANGE}
                        />

                        <Text
                          style={
                            styles.detailsButtonText
                          }
                        >
                          عرض تفاصيل الطلب
                        </Text>
                      </Pressable>

                      {canReject ? (
                        <Pressable
                          onPress={() =>
                            openReject(
                              order
                            )
                          }
                          style={
                            styles.rejectButton
                          }
                        >
                          <Ionicons
                            name="close-circle-outline"
                            size={17}
                            color={RED}
                          />

                          <Text
                            style={
                              styles.rejectButtonText
                            }
                          >
                            رفض الطلب
                          </Text>
                        </Pressable>
                      ) : null}
                    </View>

                    {expanded ? (
                      <View style={styles.detailsCard}>
                        {detailsLoadingId === id ? (
                          <View style={styles.detailsLoading}>
                            <ActivityIndicator
                              size="small"
                              color={ORANGE}
                            />

                            <Text
                              style={
                                styles.detailsLoadingText
                              }
                            >
                              جاري تحميل تفاصيل الطلب...
                            </Text>
                          </View>
                        ) : (
                          <>
                            {/* HEADER */}
                            <View
                              style={
                                styles.detailsHeaderCard
                              }
                            >
                              <View
                                style={
                                  styles.detailsHeaderIcon
                                }
                              >
                                <Ionicons
                                  name="receipt-outline"
                                  size={18}
                                  color={ORANGE}
                                />
                              </View>

                              <View
                                style={
                                  styles.detailsHeaderText
                                }
                              >
                                <Text
                                  style={
                                    styles.detailsTitle
                                  }
                                >
                                  تفاصيل الطلب
                                </Text>

                                <Text
                                  style={
                                    styles.detailsOrderNumber
                                  }
                                >
                                  #{orderNumberOf(details)}
                                </Text>
                              </View>

                              <View
                                style={
                                  styles.detailsStatusPill
                                }
                              >
                                <Text
                                  style={
                                    styles.detailsStatusText
                                  }
                                >
                                  {String(
                                    details?.status ||
                                      order?.status ||
                                      ""
                                  ) === "assigned"
                                    ? "محجوز"
                                    : "نشط"}
                                </Text>
                              </View>
                            </View>

                            {/* RESTAURANT */}
                            <View
                              style={
                                styles.detailSection
                              }
                            >
                              <View
                                style={
                                  styles.detailSectionHeader
                                }
                              >
                                <Ionicons
                                  name="storefront-outline"
                                  size={16}
                                  color={ORANGE}
                                />

                                <Text
                                  style={
                                    styles.detailSectionTitle
                                  }
                                >
                                  المطعم / المتجر
                                </Text>
                              </View>

                              <View
                                style={
                                  styles.detailField
                                }
                              >
                                <Text
                                  style={
                                    styles.detailLabel
                                  }
                                >
                                  الاسم
                                </Text>

                                <Text
                                  style={
                                    styles.detailValue
                                  }
                                  numberOfLines={2}
                                >
                                  {restaurantOf(details)}
                                </Text>
                              </View>

                              <View
                                style={
                                  styles.detailTwoColumns
                                }
                              >
                                <View
                                  style={
                                    styles.detailHalf
                                  }
                                >
                                  <Text
                                    style={
                                      styles.detailLabel
                                    }
                                  >
                                    الهاتف
                                  </Text>

                                  <Text
                                    style={
                                      styles.detailValue
                                    }
                                    numberOfLines={1}
                                  >
                                    {displayValue(
                                      restaurantPhone(details)
                                    )}
                                  </Text>
                                </View>

                                <View
                                  style={
                                    styles.detailHalf
                                  }
                                >
                                  <Text
                                    style={
                                      styles.detailLabel
                                    }
                                  >
                                    عنوان الاستلام
                                  </Text>

                                  <Text
                                    style={
                                      styles.detailValue
                                    }
                                    numberOfLines={2}
                                  >
                                    {displayValue(
                                      restaurantAddress(details)
                                    )}
                                  </Text>
                                </View>
                              </View>
                            </View>

                            {/* CUSTOMER */}
                            <View
                              style={
                                styles.detailSection
                              }
                            >
                              <View
                                style={
                                  styles.detailSectionHeader
                                }
                              >
                                <Ionicons
                                  name="person-outline"
                                  size={16}
                                  color={ORANGE}
                                />

                                <Text
                                  style={
                                    styles.detailSectionTitle
                                  }
                                >
                                  الزبون والتوصيل
                                </Text>
                              </View>

                              <View
                                style={
                                  styles.detailField
                                }
                              >
                                <Text
                                  style={
                                    styles.detailLabel
                                  }
                                >
                                  الاسم
                                </Text>

                                <Text
                                  style={
                                    styles.detailValue
                                  }
                                >
                                  {customerOf(details)}
                                </Text>
                              </View>

                              <View
                                style={
                                  styles.detailTwoColumns
                                }
                              >
                                <View
                                  style={
                                    styles.detailHalf
                                  }
                                >
                                  <Text
                                    style={
                                      styles.detailLabel
                                    }
                                  >
                                    الهاتف
                                  </Text>

                                  <Text
                                    style={
                                      styles.detailValue
                                    }
                                    numberOfLines={1}
                                  >
                                    {displayValue(
                                      customerPhone(details)
                                    )}
                                  </Text>
                                </View>

                                <View
                                  style={
                                    styles.detailHalf
                                  }
                                >
                                  <Text
                                    style={
                                      styles.detailLabel
                                    }
                                  >
                                    عنوان التوصيل
                                  </Text>

                                  <Text
                                    style={
                                      styles.detailValue
                                    }
                                    numberOfLines={3}
                                  >
                                    {displayValue(
                                      customerAddress(details)
                                    )}
                                  </Text>
                                </View>
                              </View>
                            </View>

                            {/* PRODUCTS */}
                            <View
                              style={
                                styles.detailSection
                              }
                            >
                              <View
                                style={
                                  styles.detailSectionHeader
                                }
                              >
                                <Ionicons
                                  name="basket-outline"
                                  size={16}
                                  color={ORANGE}
                                />

                                <Text
                                  style={
                                    styles.detailSectionTitle
                                  }
                                >
                                  محتويات الطلب
                                </Text>
                              </View>

                              {Array.isArray(
                                details?.items
                              ) &&
                              details.items.length > 0 ? (
                                <View
                                  style={
                                    styles.productsBox
                                  }
                                >
                                  {details.items
                                    .slice(0, 8)
                                    .map(
                                      (
                                        item: any,
                                        index: number
                                      ) => (
                                        <View
                                          key={`${id}-product-${index}`}
                                          style={
                                            styles.productRow
                                          }
                                        >
                                          <View
                                            style={
                                              styles.productMain
                                            }
                                          >
                                            <Text
                                              style={
                                                styles.productName
                                              }
                                              numberOfLines={2}
                                            >
                                              {productName(item)}
                                            </Text>

                                            <Text
                                              style={
                                                styles.productQty
                                              }
                                            >
                                              الكمية:{" "}
                                              {item?.quantity ??
                                                1}
                                            </Text>
                                          </View>

                                          <View
                                            style={
                                              styles.productPriceBox
                                            }
                                          >
                                            <Text
                                              style={
                                                styles.productUnitPrice
                                              }
                                            >
                                              {productUnitPrice(item) !=
                                              null
                                                ? moneyValue(
                                                    productUnitPrice(
                                                      item
                                                    )
                                                  )
                                                : "السعر غير متوفر"}
                                            </Text>

                                            <Text
                                              style={
                                                styles.productLineTotal
                                              }
                                            >
                                              {productLineTotal(item) !=
                                              null
                                                ? moneyValue(
                                                    productLineTotal(
                                                      item
                                                    )
                                                  )
                                                : ""}
                                            </Text>
                                          </View>
                                        </View>
                                      )
                                    )}

                                  {details.items.length > 8 ? (
                                    <Text
                                      style={
                                        styles.moreProducts
                                      }
                                    >
                                      +{" "}
                                      {details.items.length -
                                        8}{" "}
                                      منتجات أخرى
                                    </Text>
                                  ) : null}
                                </View>
                              ) : (
                                <Text
                                  style={
                                    styles.noProducts
                                  }
                                >
                                  لا توجد تفاصيل منتجات متاحة.
                                </Text>
                              )}
                            </View>

                            {/* MONEY */}
                            <View
                              style={
                                styles.detailSection
                              }
                            >
                              <View
                                style={
                                  styles.detailSectionHeader
                                }
                              >
                                <Ionicons
                                  name="cash-outline"
                                  size={16}
                                  color={GREEN}
                                />

                                <Text
                                  style={
                                    styles.detailSectionTitle
                                  }
                                >
                                  الحساب
                                </Text>
                              </View>

                              <View
                                style={
                                  styles.moneyRow
                                }
                              >
                                <Text
                                  style={
                                    styles.moneyLabel
                                  }
                                >
                                  قيمة المنتجات
                                </Text>

                                <Text
                                  style={
                                    styles.moneyValue
                                  }
                                >
                                  {moneyValue(
                                    orderSubtotal(details)
                                  )}
                                </Text>
                              </View>

                              <View
                                style={
                                  styles.moneyRow
                                }
                              >
                                <Text
                                  style={
                                    styles.moneyLabel
                                  }
                                >
                                  رسوم التوصيل
                                </Text>

                                <Text
                                  style={
                                    styles.moneyValue
                                  }
                                >
                                  {moneyValue(
                                    orderDeliveryFee(details)
                                  )}
                                </Text>
                              </View>

                              <View
                                style={
                                  styles.grandTotalRow
                                }
                              >
                                <Text
                                  style={
                                    styles.grandTotalLabel
                                  }
