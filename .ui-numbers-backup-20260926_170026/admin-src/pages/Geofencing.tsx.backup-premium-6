import { useEffect, useMemo, useState } from "react";
import {
  Edit3,
  MapPinned,
  Plus,
  RefreshCw,
  Trash2,
  X,
} from "lucide-react";
import { api, getApiErrorMessage } from "../lib/api";
import { HomeBackButton } from "../components/HomeBackButton";

interface Point {
  latitude: string;
  longitude: string;
}

interface Geofence {
  _id: string;
  name: string;
  description?: string | null;
  coordinates: [number, number][];
  isActive: boolean;
  createdAt?: string;
  updatedAt?: string;
}

interface FormState {
  name: string;
  description: string;
  isActive: boolean;
  points: Point[];
}

const emptyForm: FormState = {
  name: "",
  description: "",
  isActive: true,
  points: [
    { latitude: "", longitude: "" },
    { latitude: "", longitude: "" },
    { latitude: "", longitude: "" },
  ],
};

function createPoint(): Point {
  return {
    latitude: "",
    longitude: "",
  };
}

function getPointsFromCoordinates(
  coordinates: [number, number][],
): Point[] {
  return coordinates.map(([latitude, longitude]) => ({
    latitude: String(latitude),
    longitude: String(longitude),
  }));
}

export default function Geofencing() {
  const [rows, setRows] = useState<Geofence[]>([]);
  const [form, setForm] = useState<FormState>(
    emptyForm,
  );

  const [editingId, setEditingId] =
    useState<string | null>(null);

  const [loading, setLoading] =
    useState(true);

  const [busy, setBusy] =
    useState(false);

  const [message, setMessage] =
    useState("");

  const [error, setError] =
    useState("");

  const activeCount = useMemo(
    () =>
      rows.filter(
        (row) => row.isActive,
      ).length,
    [rows],
  );

  async function loadGeofences() {
    setLoading(true);
    setError("");

    try {
      const response =
        await api.get("/geofences");

      const data = response.data;

      setRows(
        Array.isArray(data)
          ? data
          : Array.isArray(data?.geofences)
            ? data.geofences
            : Array.isArray(data?.data)
              ? data.data
              : [],
      );
    } catch (requestError) {
      setError(
        getApiErrorMessage(
          requestError,
          "تعذر تحميل المناطق الجغرافية.",
        ),
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void loadGeofences();
  }, []);

  function resetForm() {
    setForm(emptyForm);
    setEditingId(null);
    setError("");
  }

  function updateField(
    field: keyof FormState,
    value: string | boolean | Point[],
  ) {
    setForm((current) => ({
      ...current,
      [field]: value,
    }));
  }

  function updatePoint(
    index: number,
    field: keyof Point,
    value: string,
  ) {
    setForm((current) => ({
      ...current,
      points: current.points.map(
        (point, pointIndex) =>
          pointIndex === index
            ? {
                ...point,
                [field]: value,
              }
            : point,
      ),
    }));
  }

  function addPoint() {
    setForm((current) => ({
      ...current,
      points: [
        ...current.points,
        createPoint(),
      ],
    }));
  }

  function removePoint(index: number) {
    if (form.points.length <= 3) {
      setError(
        "لا يمكن أن تحتوي المنطقة الجغرافية على أقل من 3 نقاط.",
      );
      return;
    }

    setForm((current) => ({
      ...current,
      points: current.points.filter(
        (_, pointIndex) =>
          pointIndex !== index,
      ),
    }));
  }

  function validateForm() {
    if (!form.name.trim()) {
      return "اسم المنطقة الجغرافية مطلوب.";
    }

    if (form.points.length < 3) {
      return "يجب إضافة 3 نقاط على الأقل.";
    }

    for (
      let index = 0;
      index < form.points.length;
      index += 1
    ) {
      const point = form.points[index];

      const latitude = Number(
        point.latitude,
      );

      const longitude = Number(
        point.longitude,
      );

      if (
        point.latitude.trim() === "" ||
        point.longitude.trim() === ""
      ) {
        return `بيانات النقطة رقم ${
          index + 1
        } غير مكتملة.`;
      }

      if (
        !Number.isFinite(latitude) ||
        latitude < -90 ||
        latitude > 90
      ) {
        return `خط العرض في النقطة رقم ${
          index + 1
        } يجب أن يكون بين -90 و 90.`;
      }

      if (
        !Number.isFinite(longitude) ||
        longitude < -180 ||
        longitude > 180
      ) {
        return `خط الطول في النقطة رقم ${
          index + 1
        } يجب أن يكون بين -180 و 180.`;
      }
    }

    return "";
  }

  function buildPayload() {
    return {
      name: form.name.trim(),
      description:
        form.description.trim() || null,
      coordinates: form.points.map(
        (point) => [
          Number(point.latitude),
          Number(point.longitude),
        ],
      ),
      isActive: form.isActive,
    };
  }

  async function saveGeofence() {
    setBusy(true);
    setError("");
    setMessage("");

    try {
      const validationError =
        validateForm();

      if (validationError) {
        setError(validationError);
        return;
      }

      const payload =
        buildPayload();

      if (editingId) {
        const response =
          await api.patch(
            `/geofences/${editingId}`,
            payload,
          );

        const updated =
          response.data?.data ||
          response.data?.geofence ||
          response.data;

        if (updated?._id) {
          setRows((current) =>
            current.map((row) =>
              row._id === editingId
                ? updated
                : row,
            ),
          );
        } else {
          await loadGeofences();
        }

        setMessage(
          "تم تعديل المنطقة الجغرافية بنجاح.",
        );
      } else {
        const response =
          await api.post(
            "/geofences",
            payload,
          );

        const created =
          response.data?.data ||
          response.data?.geofence ||
          response.data;

        if (created?._id) {
          setRows((current) => [
            created,
            ...current,
          ]);
        } else {
          await loadGeofences();
        }

        setMessage(
          "تم إنشاء المنطقة الجغرافية بنجاح.",
        );
      }

      resetForm();
    } catch (requestError) {
      setError(
        getApiErrorMessage(
          requestError,
          "تعذر حفظ المنطقة الجغرافية.",
        ),
      );
    } finally {
      setBusy(false);
    }
  }

  function editGeofence(row: Geofence) {
    setEditingId(row._id);

    setForm({
      name: row.name || "",
      description:
        row.description || "",
      isActive: row.isActive,
      points:
        getPointsFromCoordinates(
          row.coordinates || [],
        ),
    });

    setMessage("");
    setError("");

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }

  async function toggleGeofence(
    row: Geofence,
  ) {
    setBusy(true);
    setError("");
    setMessage("");

    try {
      const response =
        await api.patch(
          `/geofences/${row._id}`,
          {
            isActive:
              !row.isActive,
          },
        );

      const updated =
        response.data?.data ||
        response.data?.geofence ||
        response.data;

      setRows((current) =>
        current.map((item) =>
          item._id === row._id
            ? {
                ...item,
                ...(updated || {}),
                isActive:
                  !row.isActive,
              }
            : item,
        ),
      );

      setMessage(
        row.isActive
          ? "تم تعطيل المنطقة الجغرافية."
          : "تم تفعيل المنطقة الجغرافية.",
      );
    } catch (requestError) {
      setError(
        getApiErrorMessage(
          requestError,
          "تعذر تغيير حالة المنطقة.",
        ),
      );
    } finally {
      setBusy(false);
    }
  }

  async function deleteGeofence(
    row: Geofence,
  ) {
    const confirmed =
      window.confirm(
        `سيتم حذف "${row.name}" نهائيًا. هل أنت متأكد؟`,
      );

    if (!confirmed) {
      return;
    }

    setBusy(true);
    setError("");
    setMessage("");

    try {
      await api.delete(
        `/geofences/${row._id}`,
      );

      setRows((current) =>
        current.filter(
          (item) =>
            item._id !== row._id,
        ),
      );

      if (editingId === row._id) {
        resetForm();
      }

      setMessage(
        "تم حذف المنطقة الجغرافية بنجاح.",
      );
    } catch (requestError) {
      setError(
        getApiErrorMessage(
          requestError,
          "تعذر حذف المنطقة الجغرافية.",
        ),
      );
    } finally {
      setBusy(false);
    }
  }

  return (
    <div dir="rtl">
      <div className="page-header">
        <div>
          <HomeBackButton />

          <h1>
            إدارة المناطق الجغرافية
          </h1>

          <p>
            إنشاء وإدارة النطاقات الجغرافية
            التي يمكن استخدامها في التسعير
            والتوزيع داخل زاجل ديلفري.
          </p>
        </div>

        <button
          type="button"
          className="btn"
          disabled={busy || loading}
          onClick={() =>
            void loadGeofences()
          }
        >
          <RefreshCw size={17} />
          تحديث البيانات
        </button>
      </div>

      <section className="cards-grid">
        <article className="data-card">
          <div className="data-card-header">
            <div>
              <strong>
                إجمالي المناطق
              </strong>
              <p>
                جميع المناطق الجغرافية
                المسجلة.
              </p>
            </div>

            <MapPinned size={26} />
          </div>

          <div className="data-card-body">
            <div>
              <span>العدد</span>
              <strong>
                {rows.length}
              </strong>
            </div>

            <div>
              <span>المفعلة</span>
              <strong>
                {activeCount}
              </strong>
            </div>
          </div>
        </article>
      </section>

      {(message || error) && (
        <section className="panel">
          {message && (
            <div className="status status-active">
              {message}
            </div>
          )}

          {error && (
            <div className="status status-inactive">
              {error}
            </div>
          )}
        </section>
      )}

      <section className="panel">
        <div className="page-section-title">
          <div>
            <h2>
              {editingId
                ? "تعديل المنطقة الجغرافية"
                : "إضافة منطقة جغرافية"}
            </h2>

            <p>
              كل نقطة تتكون من خط عرض
              وخط طول، ويجب وجود 3 نقاط
              على الأقل.
            </p>
          </div>

          {editingId && (
            <button
              type="button"
              className="btn"
              disabled={busy}
              onClick={resetForm}
            >
              <X size={17} />
              إلغاء التعديل
            </button>
          )}
        </div>

        <div className="form-grid">
          <label>
            اسم المنطقة
            <input
              value={form.name}
              onChange={(event) =>
                updateField(
                  "name",
                  event.target.value,
                )
              }
              placeholder="مثال: نطاق وسط المدينة"
            />
          </label>

          <label>
            الوصف
            <input
              value={form.description}
              onChange={(event) =>
                updateField(
                  "description",
                  event.target.value,
                )
              }
              placeholder="وصف اختياري للمنطقة"
            />
          </label>

          <label>
            حالة المنطقة
            <select
              value={
                form.isActive
                  ? "active"
                  : "inactive"
              }
              onChange={(event) =>
                updateField(
                  "isActive",
                  event.target.value ===
                    "active",
                )
              }
            >
              <option value="active">
                مفعلة
              </option>
              <option value="inactive">
                متوقفة
              </option>
            </select>
          </label>
        </div>

        <div
          style={{
            marginTop: 24,
          }}
        >
          <div
            className="page-section-title"
          >
            <div>
              <h2>
                نقاط المنطقة
              </h2>

              <p>
                الترتيب هنا يحدد شكل المضلع
                الذي سيستخدمه النظام.
              </p>
            </div>

            <button
              type="button"
              className="btn"
              disabled={busy}
              onClick={addPoint}
            >
              <Plus size={17} />
              إضافة نقطة
            </button>
          </div>

          <div className="cards-grid">
            {form.points.map(
              (point, index) => (
                <article
                  className="data-card"
                  key={`point-${index}`}
                >
                  <div className="data-card-header">
                    <div>
                      <strong>
                        النقطة{" "}
                        {index + 1}
                      </strong>
                      <p>
                        أدخل الإحداثيات
                        بالدرجات العشرية.
                      </p>
                    </div>

                    <button
                      type="button"
                      className="btn btn-danger"
                      disabled={
                        busy ||
                        form.points
                          .length <= 3
                      }
                      onClick={() =>
                        removePoint(
                          index,
                        )
                      }
                      title="حذف النقطة"
                    >
                      <Trash2 size={16} />
                    </button>
                  </div>

                  <div className="form-grid">
                    <label>
                      خط العرض
                      <input
                        type="number"
                        step="any"
                        min="-90"
                        max="90"
                        value={
                          point.latitude
                        }
                        onChange={(
                          event,
                        ) =>
                          updatePoint(
                            index,
                            "latitude",
                            event.target
                              .value,
                          )
                        }
                        placeholder="33.3200"
                      />
                    </label>

                    <label>
                      خط الطول
                      <input
                        type="number"
                        step="any"
                        min="-180"
                        max="180"
                        value={
                          point.longitude
                        }
                        onChange={(
                          event,
                        ) =>
                          updatePoint(
                            index,
                            "longitude",
                            event.target
                              .value,
                          )
                        }
                        placeholder="44.3700"
                      />
                    </label>
                  </div>
                </article>
              ),
            )}
          </div>
        </div>

        <div className="form-actions">
          <button
            type="button"
            className="btn btn-primary"
            disabled={busy}
            onClick={() =>
              void saveGeofence()
            }
          >
            {editingId ? (
              <>
                <Edit3 size={17} />
                حفظ التعديل
              </>
            ) : (
              <>
                <Plus size={17} />
                إنشاء المنطقة
              </>
            )}
          </button>

          {editingId && (
            <button
              type="button"
              className="btn"
              disabled={busy}
              onClick={resetForm}
            >
              إلغاء
            </button>
          )}
        </div>
      </section>

      <section className="panel">
        <div className="page-section-title">
          <div>
            <h2>
              المناطق الجغرافية الحالية
            </h2>

            <p>
              جميع المناطق المحفوظة من الخادم
              الحقيقي.
            </p>
          </div>
        </div>

        {loading ? (
          <div className="empty-state">
            جاري تحميل المناطق الجغرافية...
          </div>
        ) : rows.length === 0 ? (
          <div className="empty-state">
            لا توجد مناطق جغرافية حاليًا.
          </div>
        ) : (
          <div className="cards-grid">
            {rows.map((row) => (
              <article
                className="data-card"
                key={row._id}
              >
                <div className="data-card-header">
                  <div>
                    <strong>
                      {row.name}
                    </strong>

                    <p>
                      {row.description ||
                        "بدون وصف"}
                    </p>
                  </div>

                  <span
                    className={
                      row.isActive
                        ? "status status-active"
                        : "status status-inactive"
                    }
                  >
                    {row.isActive
                      ? "مفعلة"
                      : "متوقفة"}
                  </span>
                </div>

                <div className="data-card-body">
                  <div>
                    <span>
                      عدد النقاط
                    </span>
                    <strong>
                      {
                        row.coordinates
                          ?.length || 0
                      }
                    </strong>
                  </div>

                  <div>
                    <span>
                      آخر تحديث
                    </span>
                    <strong>
                      {row.updatedAt
                        ? new Date(
                            row.updatedAt,
                          ).toLocaleString(
                            "ar-EG",
                          )
                        : "غير متوفر"}
                    </strong>
                  </div>
                </div>

                <div className="data-card-actions">
                  <button
                    type="button"
                    className="btn"
                    disabled={busy}
                    onClick={() =>
                      editGeofence(
                        row,
                      )
                    }
                  >
                    <Edit3 size={16} />
                    تعديل
                  </button>

                  <button
                    type="button"
                    className="btn"
                    disabled={busy}
                    onClick={() =>
                      void toggleGeofence(
                        row,
                      )
                    }
                  >
                    {row.isActive
                      ? "تعطيل"
                      : "تفعيل"}
                  </button>

                  <button
                    type="button"
                    className="btn btn-danger"
                    disabled={busy}
                    onClick={() =>
                      void deleteGeofence(
                        row,
                      )
                    }
                  >
                    <Trash2 size={16} />
                    حذف
                  </button>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>
    </div>
  );
}
