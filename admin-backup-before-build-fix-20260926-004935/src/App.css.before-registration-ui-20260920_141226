.counter {
  font-size: 16px;
  padding: 5px 10px;
  border-radius: 5px;
  color: var(--accent);
  background: var(--accent-bg);
  border: 2px solid transparent;
  transition: border-color 0.3s;
  margin-bottom: 24px;

  &:hover {
    border-color: var(--accent-border);
  }
  &:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
}

.hero {
  position: relative;

  .base,
  .framework,
  .vite {
    inset-inline: 0;
    margin: 0 auto;
  }

  .base {
    width: 170px;
    position: relative;
    z-index: 0;
  }

  .framework,
  .vite {
    position: absolute;
  }

  .framework {
    z-index: 1;
    top: 34px;
    height: 28px;
    transform: perspective(2000px) rotateZ(300deg) rotateX(44deg) rotateY(39deg)
      scale(1.4);
  }

  .vite {
    z-index: 0;
    top: 107px;
    height: 26px;
    width: auto;
    transform: perspective(2000px) rotateZ(300deg) rotateX(40deg) rotateY(39deg)
      scale(0.8);
  }
}

#center {
  display: flex;
  flex-direction: column;
  gap: 25px;
  place-content: center;
  place-items: center;
  flex-grow: 1;

  @media (max-width: 1024px) {
    padding: 32px 20px 24px;
    gap: 18px;
  }
}

#next-steps {
  display: flex;
  border-top: 1px solid var(--border);
  text-align: left;

  & > div {
    flex: 1 1 0;
    padding: 32px;
    @media (max-width: 1024px) {
      padding: 24px 20px;
    }
  }

  .icon {
    margin-bottom: 16px;
    width: 22px;
    height: 22px;
  }

  @media (max-width: 1024px) {
    flex-direction: column;
    text-align: center;
  }
}

#docs {
  border-right: 1px solid var(--border);

  @media (max-width: 1024px) {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }
}

#next-steps ul {
  list-style: none;
  padding: 0;
  display: flex;
  gap: 8px;
  margin: 32px 0 0;

  .logo {
    height: 18px;
  }

  a {
    color: var(--text-h);
    font-size: 16px;
    border-radius: 6px;
    background: var(--social-bg);
    display: flex;
    padding: 6px 12px;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: box-shadow 0.3s;

    &:hover {
      box-shadow: var(--shadow);
    }
    .button-icon {
      height: 18px;
      width: 18px;
    }
  }

  @media (max-width: 1024px) {
    margin-top: 20px;
    flex-wrap: wrap;
    justify-content: center;

    li {
      flex: 1 1 calc(50% - 8px);
    }

    a {
      width: 100%;
      justify-content: center;
      box-sizing: border-box;
    }
  }
}

#spacer {
  height: 88px;
  border-top: 1px solid var(--border);
  @media (max-width: 1024px) {
    height: 48px;
  }
}

.ticks {
  position: relative;
  width: 100%;

  &::before,
  &::after {
    content: '';
    position: absolute;
    top: -4.5px;
    border: 5px solid transparent;
  }

  &::before {
    left: 0;
    border-left-color: var(--border);
  }
  &::after {
    right: 0;
    border-right-color: var(--border);
  }
}


.page-section-title {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
}

.page-section-title h1,
.page-section-title h2 {
  margin: 0;
}

.page-section-title p {
  margin: 8px 0 0;
  opacity: 0.7;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 18px;
}

.form-grid label {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-grid .full-width {
  grid-column: 1 / -1;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.data-card {
  border: 1px solid rgba(127, 127, 127, 0.18);
  border-radius: 18px;
  padding: 18px;
  background: rgba(127, 127, 127, 0.04);
}

.data-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.data-card-body {
  display: grid;
  gap: 12px;
}

.data-card-body > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid rgba(127, 127, 127, 0.1);
}

.data-card-body span {
  opacity: 0.65;
}

.data-card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
}

.status {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}

.status-active {
  background: rgba(34, 197, 94, 0.12);
}

.status-inactive {
  background: rgba(239, 68, 68, 0.12);
}

@media (max-width: 900px) {
  .form-grid,
  .cards-grid {
    grid-template-columns: 1fr;
  }

  .form-grid .full-width {
    grid-column: auto;
  }
}


.registration-requests-page{display:flex;flex-direction:column;gap:18px}
.registration-intro{align-items:center}
.registration-total-card{min-width:190px;padding:18px 20px;border-radius:16px;background:linear-gradient(135deg,#fff8e8,#fff);border:1px solid #f0dfbb;text-align:center}
.registration-total-card span{display:block;color:#957c5b;font-size:12px;margin-bottom:6px}
.registration-total-card strong{display:block;color:#9a5b10;font-size:34px;line-height:1}
.registration-summary-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.registration-summary-card{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:13px;width:100%;padding:17px 18px;background:#fff;border:1px solid #eadfce;border-radius:16px;text-align:right;color:inherit;cursor:pointer;transition:.18s ease}
.registration-summary-card:hover,.registration-summary-card.active{border-color:#e8b861;box-shadow:0 10px 28px rgba(112,75,19,.07);transform:translateY(-1px)}
.registration-summary-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:#fff7e8;color:#b56b14}
.registration-summary-card b,.registration-summary-card small{display:block}
.registration-summary-card b{font-size:14px;color:#44321f;margin-bottom:3px}
.registration-summary-card small{color:#9a876f;font-size:11px}
.registration-count{min-width:34px;height:34px;display:grid;place-items:center;padding:0 9px;border-radius:999px;background:#f7ead4;color:#9a5b10;font-weight:800}
.registration-panel-header{align-items:center}
.registration-panel-header p{margin:5px 0 0;color:#9a876f;font-size:11px}
.registration-refresh{display:inline-flex;align-items:center;gap:7px;border:1px solid #eadfce;background:#fffdfa;color:#66513a;border-radius:10px;min-height:38px;padding:0 13px;cursor:pointer}
.registration-toolbar{padding:0 0 14px}
.registration-search{display:flex;align-items:center;gap:8px;width:100%;min-height:44px;padding:0 13px;border:1px solid #eadfce;border-radius:11px;background:#fffdfa;color:#ad987d}
.registration-search input{width:100%;border:0;outline:0;background:transparent;color:#3b2a18;font-size:12px}
.registration-list{display:flex;flex-direction:column;gap:10px}
.registration-item{border:1px solid #eee4d6;border-radius:15px;overflow:hidden;background:#fff}
.registration-item.pending{border-color:#edd09f}
.registration-item-head{width:100%;display:grid;grid-template-columns:auto 1fr auto auto;align-items:center;gap:12px;padding:14px 16px;border:0;background:transparent;text-align:right;cursor:pointer;color:inherit}
.registration-avatar{width:42px;height:42px;display:grid;place-items:center;background:#fff7e8;color:#b56b14;border-radius:12px}
.registration-main-info{min-width:0}
.registration-main-info b,.registration-main-info small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.registration-main-info b{color:#44321f;font-size:13px}
.registration-main-info small{margin-top:3px;color:#9a876f;font-size:11px}
.registration-status{min-width:88px;padding:6px 9px;border-radius:999px;text-align:center;font-size:10px;font-weight:800}
.registration-status.pending{color:#94600e;background:#fff2cf}
.registration-status.approved{color:#34724a;background:#fff1dc}
.registration-status.rejected{color:#b14d3d;background:#fff0ed}
.registration-details{border-top:1px solid #f2eadf;padding:18px;background:#fffdfa}
.registration-data-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.registration-data-grid>div{padding:11px 12px;background:#fff;border:1px solid #f0e7da;border-radius:11px}
.registration-data-grid small,.registration-data-grid strong{display:block}
.registration-data-grid small{color:#ad987d;font-size:10px;margin-bottom:4px}
.registration-data-grid strong{color:#473523;font-size:11px;line-height:1.6;word-break:break-word}
.registration-data-wide{grid-column:span 2}
.registration-section-title{margin:18px 0 10px;color:#5c4530;font-size:12px;font-weight:800}
.registration-docs-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.registration-document{display:block;padding:12px;text-decoration:none;color:inherit;border:1px solid #eadfce;background:#fff;border-radius:12px;transition:.16s ease}
.registration-document:hover{border-color:#e6b55d;transform:translateY(-1px)}
.registration-document>span{display:grid;place-items:center;width:36px;height:36px;border-radius:10px;background:#fff7e8;color:#b56b14;margin-bottom:9px}
.registration-document b{color:#4a3826;font-size:11px}
.registration-document small{display:flex;align-items:center;gap:5px;color:#a28d74;font-size:10px;margin-top:4px}
.registration-location-box{display:flex;align-items:center;gap:10px;margin-top:12px;padding:12px 14px;border:1px solid #eadfce;border-radius:12px;background:#fff;color:#b56b14}
.registration-location-box b,.registration-location-box span{display:block}
.registration-location-box b{color:#4a3826;font-size:11px}
.registration-location-box span{margin-top:3px;color:#957f64;font-size:11px;direction:ltr}
.registration-reason{margin-top:12px;padding:11px 12px;border-radius:10px;background:#fff2ef;color:#a74c3c;font-size:11px;line-height:1.7}
.registration-actions{display:flex;gap:9px;margin-top:14px}
.registration-actions button{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:0 15px;border-radius:10px;border:0;cursor:pointer;font-family:inherit;font-size:11px;font-weight:800}
.registration-approve{color:#fff;background:#3f8b5c}
.registration-reject{color:#fff;background:#c45f4f}
.registration-nav-badge{min-width:21px;height:21px;padding:0 6px;display:inline-grid;place-items:center;margin-inline-start:auto;border-radius:999px;background:#d86d2f;color:#fff;font-size:10px;font-weight:800}
@media(max-width:900px){.registration-summary-grid,.registration-data-grid,.registration-docs-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.registration-data-wide{grid-column:span 2}}
@media(max-width:640px){.registration-summary-grid,.registration-data-grid,.registration-docs-grid{grid-template-columns:1fr}.registration-data-wide{grid-column:span 1}.registration-item-head{grid-template-columns:auto 1fr auto}.registration-status{min-width:0}.registration-actions{flex-direction:column}}


