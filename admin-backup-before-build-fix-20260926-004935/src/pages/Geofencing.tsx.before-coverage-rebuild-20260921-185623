import { useEffect, useMemo, useState } from "react";
import {
  Check,
  Edit3,
  Loader2,
  MapPinned,
  Plus,
  RefreshCw,
  Trash2,
  X,
  Power,
} from "lucide-react";
import { api, getApiErrorMessage } from "../lib/api";
import { HomeBackButton } from "../components/HomeBackButton";

interface Point {
  latitude: string;
  longitude: string;
}

interface Geofence {
  _id: string;
  name: string;
  description?: string | null;
  coordinates: [number, number][];
  isActive: boolean;
  createdAt?: string;
  updatedAt?: string;
}

interface FormState {
  name: string;
  description: string;
  isActive: boolean;
  points: Point[];
}

function createEmptyForm(): FormState {
  return {
    name: "",
    description: "",
    isActive: true,
    points: [
      { latitude: "", longitude: "" },
      { latitude: "", longitude: "" },
      { latitude: "", longitude: "" },
    ],
  };
}

function createPoint(): Point {
  return { latitude: "", longitude: "" };
}

function getPointsFromCoordinates(
  coordinates: [number, number][],
): Point[] {
  return coordinates.map(([latitude, longitude]) => ({
    latitude: String(latitude),
    longitude: String(longitude),
  }));
}

export default function Geofencing() {
  const [rows, setRows] = useState<Geofence[]>([]);
  const [form, setForm] = useState<FormState>(
    createEmptyForm(),
  );
  const [editingId, setEditingId] =
    useState<string | null>(null);
  const [loading, setLoading] = useState(true);
  const [busy, setBusy] = useState(false);
  const [message, setMessage] = useState("");
  const [error, setError] = useState("");

  const activeCount = useMemo(
    () => rows.filter((row) => row.isActive).length,
    [rows],
  );

  const inactiveCount = rows.length - activeCount;

  async function loadGeofences() {
    setLoading(true);
    setError("");

    try {
      const response = await api.get("/geofences");
      const data = response.data;

      setRows(
        Array.isArray(data)
          ? data
          : Array.isArray(data?.geofences)
            ? data.geofences
            : Array.isArray(data?.data)
              ? data.data
              : [],
      );
    } catch (err) {
      setError(
        getApiErrorMessage(
          err,
          "تعذر تحميل المناطق الجغرافية.",
        ),
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void loadGeofences();
  }, []);

  function resetForm() {
    setForm(createEmptyForm());
    setEditingId(null);
    setMessage("");
    setError("");
  }

  function updateField(
    field: keyof FormState,
    value: string | boolean,
  ) {
    setForm((current) => ({
      ...current,
      [field]: value,
    }));
  }

  function updatePoint(
    index: number,
    field: keyof Point,
    value: string,
  ) {
    setForm((current) => ({
      ...current,
      points: current.points.map((point, pointIndex) =>
        pointIndex === index
          ? { ...point, [field]: value }
          : point,
      ),
    }));
  }

  function addPoint() {
    setForm((current) => ({
      ...current,
      points: [...current.points, createPoint()],
    }));
  }

  function removePoint(index: number) {
    if (form.points.length <= 3) {
      setError("لا يمكن أن تحتوي المنطقة على أقل من 3 نقاط.");
      return;
    }

    setForm((current) => ({
      ...current,
      points: current.points.filter(
        (_, pointIndex) => pointIndex !== index,
      ),
    }));
  }

  function validateForm() {
    if (!form.name.trim()) {
      return "اسم المنطقة الجغرافية مطلوب.";
    }

    if (form.points.length < 3) {
      return "يجب إضافة 3 نقاط على الأقل.";
    }

    for (let index = 0; index < form.points.length; index += 1) {
      const point = form.points[index];
      const latitude = Number(point.latitude);
      const longitude = Number(point.longitude);

      if (
        point.latitude.trim() === "" ||
        point.longitude.trim() === ""
      ) {
        return `بيانات النقطة رقم ${index + 1} غير مكتملة.`;
      }

      if (
        !Number.isFinite(latitude) ||
        latitude < -90 ||
        latitude > 90
      ) {
        return `خط العرض في النقطة رقم ${index + 1} غير صحيح.`;
      }

      if (
        !Number.isFinite(longitude) ||
        longitude < -180 ||
        longitude > 180
      ) {
        return `خط الطول في النقطة رقم ${index + 1} غير صحيح.`;
      }
    }

    return "";
  }

  function buildPayload() {
    return {
      name: form.name.trim(),
      description: form.description.trim() || null,
      coordinates: form.points.map((point) => [
        Number(point.latitude),
        Number(point.longitude),
      ]),
      isActive: form.isActive,
    };
  }

  async function saveGeofence() {
    setBusy(true);
    setError("");
    setMessage("");

    try {
      const validationError = validateForm();

      if (validationError) {
        setError(validationError);
        return;
      }

      const payload = buildPayload();

      if (editingId) {
        const response = await api.patch(
          `/geofences/${editingId}`,
          payload,
        );

        const updated =
          response.data?.data ||
          response.data?.geofence ||
          response.data;

        if (updated?._id) {
          setRows((current) =>
            current.map((row) =>
              row._id === editingId ? updated : row,
            ),
          );
        } else {
          await loadGeofences();
        }

        setMessage("تم تعديل المنطقة الجغرافية بنجاح.");
      } else {
        const response = await api.post(
          "/geofences",
          payload,
        );

        const created =
          response.data?.data ||
          response.data?.geofence ||
          response.data;

        if (created?._id) {
          setRows((current) => [created, ...current]);
        } else {
          await loadGeofences();
        }

        setMessage("تم إنشاء المنطقة الجغرافية بنجاح.");
      }

      setForm(createEmptyForm());
      setEditingId(null);
    } catch (err) {
      setError(
        getApiErrorMessage(
          err,
          "تعذر حفظ المنطقة الجغرافية.",
        ),
      );
    } finally {
      setBusy(false);
    }
  }

  function editGeofence(row: Geofence) {
    setEditingId(row._id);
    setForm({
      name: row.name || "",
      description: row.description || "",
      isActive: row.isActive,
      points: getPointsFromCoordinates(row.coordinates || []),
    });
    setMessage("");
    setError("");

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }

  async function toggleGeofence(row: Geofence) {
    setBusy(true);
    setError("");
    setMessage("");

    try {
      const response = await api.patch(
        `/geofences/${row._id}`,
        { isActive: !row.isActive },
      );

      const updated =
        response.data?.data ||
        response.data?.geofence ||
        response.data;

      setRows((current) =>
        current.map((item) =>
          item._id === row._id
            ? {
                ...item,
                ...(updated || {}),
                isActive: !row.isActive,
              }
            : item,
        ),
      );

      setMessage(
        row.isActive
          ? "تم تعطيل المنطقة الجغرافية."
          : "تم تفعيل المنطقة الجغرافية.",
      );
    } catch (err) {
      setError(
        getApiErrorMessage(
          err,
          "تعذر تغيير حالة المنطقة.",
        ),
      );
    } finally {
      setBusy(false);
    }
  }

  async function deleteGeofence(row: Geofence) {
    if (
      !window.confirm(
        `سيتم حذف "${row.name}" نهائيًا. هل أنت متأكد؟`,
      )
    ) {
      return;
    }

    setBusy(true);
    setError("");
    setMessage("");

    try {
      await api.delete(`/geofences/${row._id}`);

      setRows((current) =>
        current.filter((item) => item._id !== row._id),
      );

      if (editingId === row._id) {
        resetForm();
      }

      setMessage("تم حذف المنطقة الجغرافية بنجاح.");
    } catch (err) {
      setError(
        getApiErrorMessage(
          err,
          "تعذر حذف المنطقة الجغرافية.",
        ),
      );
    } finally {
      setBusy(false);
    }
  }

  return (
    <main className="premium-page" dir="rtl">
      <div className="premium-page-shell">
        <section className="premium-page-intro">
          <div>
            <HomeBackButton />
            <span className="premium-page-kicker">
              الخرائط والتوزيع
            </span>
            <h1>إدارة المناطق الجغرافية</h1>
            <p>
              إنشاء وإدارة النطاقات الجغرافية المستخدمة في
              التسعير والتوزيع داخل زاجل ديلفري.
            </p>
          </div>

          <div className="premium-page-icon">
            <MapPinned size={28} />
          </div>
        </section>

        <section className="premium-stat-grid compact">
          <div className="premium-stat-card">
            <div className="premium-stat-icon">
              <MapPinned size={20} />
            </div>
            <span>إجمالي المناطق</span>
            <strong>{rows.length}</strong>
          </div>

          <div className="premium-stat-card">
            <div className="premium-stat-icon success">
              <Check size={20} />
            </div>
            <span>المناطق المفعلة</span>
            <strong>{activeCount}</strong>
          </div>

          <div className="premium-stat-card">
            <div className="premium-stat-icon danger">
              <X size={20} />
            </div>
            <span>المتوقفة</span>
            <strong>{inactiveCount}</strong>
          </div>
        </section>

        {(message || error) && (
          <div className={error ? "premium-error" : "premium-success"}>
            {error || message}
          </div>
        )}

        <section className="premium-panel">
          <div className="premium-section-heading">
            <div>
              <span>
                {editingId ? "تعديل منطقة" : "منطقة جديدة"}
              </span>
              <h2>
                {editingId
                  ? "تعديل المنطقة الجغرافية"
                  : "إضافة منطقة جغرافية"}
              </h2>
              <p>
                يجب أن تحتوي المنطقة على 3 نقاط على الأقل.
              </p>
            </div>

            <div className="premium-heading-icon">
              {editingId ? (
                <Edit3 size={20} />
              ) : (
                <Plus size={20} />
              )}
            </div>
          </div>

          <div className="premium-form-grid">
            <label className="premium-field">
              <span>اسم المنطقة</span>
              <input
                value={form.name}
                disabled={busy}
                onChange={(event) =>
                  updateField("name", event.target.value)
                }
                placeholder="مثال: نطاق وسط المدينة"
              />
            </label>

            <label className="premium-field">
              <span>الوصف</span>
              <input
                value={form.description}
                disabled={busy}
                onChange={(event) =>
                  updateField(
                    "description",
                    event.target.value,
                  )
                }
                placeholder="وصف اختياري"
              />
            </label>

            <label className="premium-field">
              <span>الحالة</span>
              <select
                value={form.isActive ? "active" : "inactive"}
                disabled={busy}
                onChange={(event) =>
                  updateField(
                    "isActive",
                    event.target.value === "active",
                  )
                }
              >
                <option value="active">مفعلة</option>
                <option value="inactive">متوقفة</option>
              </select>
            </label>
          </div>

          <div className="premium-points-header">
            <div>
              <span>حدود المنطقة</span>
              <h3>نقاط المضلع</h3>
            </div>

            <button
              type="button"
              className="premium-button ghost"
              disabled={busy}
              onClick={addPoint}
            >
              <Plus size={17} />
              إضافة نقطة
            </button>
          </div>

          <div className="premium-points-grid">
            {form.points.map((point, index) => (
              <article
                className="premium-point-card"
                key={`point-${index}`}
              >
                <div className="premium-point-top">
                  <div>
                    <span>نقطة</span>
                    <strong>{index + 1}</strong>
                  </div>

                  <button
                    type="button"
                    className="premium-icon-button danger"
                    disabled={busy || form.points.length <= 3}
                    onClick={() => removePoint(index)}
                    title="حذف النقطة"
                  >
                    <Trash2 size={16} />
                  </button>
                </div>

                <div className="premium-form-grid two">
                  <label className="premium-field">
                    <span>خط العرض</span>
                    <input
                      type="number"
                      step="any"
                      min="-90"
                      max="90"
                      value={point.latitude}
                      disabled={busy}
                      onChange={(event) =>
                        updatePoint(
                          index,
                          "latitude",
                          event.target.value,
                        )
                      }
                      placeholder="33.3200"
                    />
                  </label>

                  <label className="premium-field">
                    <span>خط الطول</span>
                    <input
                      type="number"
                      step="any"
                      min="-180"
                      max="180"
                      value={point.longitude}
                      disabled={busy}
                      onChange={(event) =>
                        updatePoint(
                          index,
                          "longitude",
                          event.target.value,
                        )
                      }
                      placeholder="44.3700"
                    />
                  </label>
                </div>
              </article>
            ))}
          </div>

          <div className="premium-form-actions">
            <button
              type="button"
              className="premium-button primary"
              disabled={busy}
              onClick={() => void saveGeofence()}
            >
              {busy ? (
                <Loader2 size={17} className="premium-spin" />
              ) : editingId ? (
                <Check size={17} />
              ) : (
                <Plus size={17} />
              )}
              {busy
                ? "جارٍ الحفظ..."
                : editingId
                  ? "حفظ التعديل"
                  : "إنشاء المنطقة"}
            </button>

            {editingId && (
              <button
                type="button"
                className="premium-button ghost"
                disabled={busy}
                onClick={resetForm}
              >
                <X size={17} />
                إلغاء التعديل
              </button>
            )}
          </div>
        </section>

        <section className="premium-panel">
          <div className="premium-section-heading">
            <div>
              <span>النطاقات المسجلة</span>
              <h2>المناطق الجغرافية الحالية</h2>
              <p>جميع المناطق المحفوظة من الخادم الحقيقي.</p>
            </div>

            <button
              type="button"
              className="premium-button ghost"
              disabled={loading || busy}
              onClick={() => void loadGeofences()}
            >
              <RefreshCw size={17} />
              تحديث
            </button>
          </div>

          {loading ? (
            <div className="premium-state-card">
              <Loader2 size={28} className="premium-spin" />
              <span>جارٍ تحميل المناطق...</span>
            </div>
          ) : rows.length === 0 ? (
            <div className="premium-state-card muted">
              <MapPinned size={30} />
              <h3>لا توجد مناطق جغرافية</h3>
              <p>أنشئ أول منطقة من النموذج أعلاه.</p>
            </div>
          ) : (
            <div className="premium-geofence-grid">
              {rows.map((row) => (
                <article
                  className="premium-geofence-card"
                  key={row._id}
                >
                  <div className="premium-geofence-top">
                    <div className="premium-rule-icon">
                      <MapPinned size={19} />
                    </div>

                    <span
                      className={`premium-status-pill ${
                        row.isActive ? "success" : "neutral"
                      }`}
                    >
                      {row.isActive ? "مفعلة" : "متوقفة"}
                    </span>
                  </div>

                  <h3>{row.name}</h3>
                  <p>
                    {row.description || "بدون وصف"}
                  </p>

                  <div className="premium-geofence-meta">
                    <div>
                      <span>عدد النقاط</span>
                      <strong>
                        {row.coordinates?.length || 0}
                      </strong>
                    </div>

                    <div>
                      <span>آخر تحديث</span>
                      <strong>
                        {row.updatedAt
                          ? new Date(
                              row.updatedAt,
                            ).toLocaleDateString("ar-EG")
                          : "غير متوفر"}
                      </strong>
                    </div>
                  </div>

                  <div className="premium-card-actions">
                    <button
                      type="button"
                      className="premium-button ghost"
                      disabled={busy}
                      onClick={() => editGeofence(row)}
                    >
                      <Edit3 size={16} />
                      تعديل
                    </button>

                    <button
                      type="button"
                      className="premium-button ghost"
                      disabled={busy}
                      onClick={() =>
                        void toggleGeofence(row)
                      }
                    >
                      <Power size={16} />
                      {row.isActive ? "تعطيل" : "تفعيل"}
                    </button>

                    <button
                      type="button"
                      className="premium-button danger"
                      disabled={busy}
                      onClick={() =>
                        void deleteGeofence(row)
                      }
                    >
                      <Trash2 size={16} />
                      حذف
                    </button>
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>
      </div>
    </main>
  );
}
