import { useEffect, useState } from "react";
import {
  Check,
  ChevronDown,
  ChevronUp,
  Loader2,
  Shield,
  UserRound,
  X,
} from "lucide-react";
import { api, getApiErrorMessage } from "../lib/api";
import { canManageLeaders } from "../lib/permissions";
import HomeBackButton from "../components/admin/HomeBackButton";
type LeaderRole =
  | "governorate_leader"
  | "area_leader";

type LeaderStatus =
  | "pending"
  | "active"
  | "rejected"
  | "suspended"
  | "inactive";

interface Leader {
  _id: string;
  fullName: string;
  phone: string;
  email?: string | null;
  role: LeaderRole;
  status: LeaderStatus;
  governorateId?: {
    _id: string;
    name: string;
  } | string | null;
  areaId?: string | null;
  rejectionReason?: string | null;
  suspensionReason?: string | null;
  createdAt: string;
  updatedAt: string;
}

const roleLabels: Record<LeaderRole, string> = {
  governorate_leader: "قائد محافظة",
  area_leader: "قائد منطقة",
};

const statusLabels: Record<LeaderStatus, string> = {
  pending: "قيد المراجعة",
  active: "نشط",
  rejected: "مرفوض",
  suspended: "موقوف",
  inactive: "غير نشط",
};

function govName(
  value: Leader["governorateId"],
) {
  if (!value) return "غير محددة";
  if (typeof value === "string") return value;
  return value.name;
}

export default function Leaders() {
  const [leaders, setLeaders] = useState<Leader[]>([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");
  const [currentRole, setCurrentRole] =
    useState<string | undefined>(undefined);
  const [openId, setOpenId] = useState<string | null>(
    null,
  );

  async function loadLeaders() {
    try {
      setLoading(true);
      setError("");

      const response = await api.get("/leaders");

      setLeaders(
        Array.isArray(response.data?.leaders)
          ? response.data.leaders
          : [],
      );
    } catch (err: any) {
      setError(
        getApiErrorMessage(err, "تعذر تحميل القادة."),
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    async function loadCurrentRole() {
      try {
        const response = await api.get("/auth/me");
        setCurrentRole(
          response.data?.user?.role,
        );
      } catch (error) {
        if (import.meta.env.DEV) {
          console.error(
            "Role loading error:",
            error,
          );
        }
      }
    }

    void loadCurrentRole();
  }, []);

  useEffect(() => {
    loadLeaders();
  }, []);

  async function approve(id: string) {
    if (!canManageLeaders(currentRole)) {
      setError("ليس لديك صلاحية لإدارة القادة.");
      return;
    }


    try {
      setSaving(true);
      setError("");

      await api.post(`/leaders/${id}/approve`);
      await loadLeaders();
    } catch (err: any) {
      setError(
        getApiErrorMessage(err, "تعذر قبول القائد."),
      );
    } finally {
      setSaving(false);
    }
  }

  async function reject(id: string) {
    if (!canManageLeaders(currentRole)) {
      setError("ليس لديك صلاحية لإدارة القادة.");
      return;
    }

    try {
      setSaving(true);
      setError("");

      await api.post(`/leaders/${id}/reject`, {
        reason: "رفض من لوحة الإدارة",
      });

      await loadLeaders();
    } catch (err: any) {
      setError(
        getApiErrorMessage(err, "تعذر رفض القائد."),
      );
    } finally {
      setSaving(false);
    }
  }

  return (
    <div className="admin-app" dir="rtl">
      <main className="admin-main">
<div className="admin-content">

          <HomeBackButton />
          <div className="dashboard">
            <section className="dashboard-intro">
              <div>
                <span className="dashboard-label">
                  الهيكل الإداري
                </span>
                <h1>القادة</h1>
                <p>
                  إدارة قادة المحافظات والمناطق.
                </p>
              </div>

              <div className="captains-intro-icon">
                <Shield size={24} />
              </div>
            </section>

            {error && (
              <div className="location-error">
                {error}
              </div>
            )}

            <section className="locations-summary">
              <div className="location-summary-card">
                <span>إجمالي القادة</span>
                <strong>{leaders.length}</strong>
              </div>

              <div className="location-summary-card">
                <span>قادة المحافظات</span>
                <strong>
                  {
                    leaders.filter(
                      (x) =>
                        x.role === "governorate_leader",
                    ).length
                  }
                </strong>
              </div>

              <div className="location-summary-card">
                <span>قادة المناطق</span>
                <strong>
                  {
                    leaders.filter(
                      (x) =>
                        x.role === "area_leader",
                    ).length
                  }
                </strong>
              </div>

              <div className="location-summary-card">
                <span>نشطون</span>
                <strong>
                  {
                    leaders.filter(
                      (x) => x.status === "active",
                    ).length
                  }
                </strong>
              </div>

              <div className="location-summary-card">
                <span>قيد المراجعة</span>
                <strong>
                  {
                    leaders.filter(
                      (x) => x.status === "pending",
                    ).length
                  }
                </strong>
              </div>
            </section>

            <section className="panel locations-panel">
              <div className="panel-header">
                <div>
                  <h2>قائمة القادة</h2>
                  <p>
                    البيانات من API القادة مباشرة.
                  </p>
                </div>
              </div>

              {loading ? (
                <div className="locations-loading">
                  <Loader2
                    size={27}
                    className="location-spin"
                  />
                  <span>جارٍ تحميل القادة...</span>
                </div>
              ) : leaders.length === 0 ? (
                <div className="locations-empty">
                  <div className="locations-empty-icon">
                    <UserRound size={25} />
                  </div>
                  <h3>لا يوجد قادة</h3>
                  <p>
                    لا توجد سجلات حاليًا.
                  </p>
                </div>
              ) : (
                <div className="establishments-list">
                  {leaders.map((leader) => {
                    const open =
                      openId === leader._id;

                    return (
                      <div
                        className="establishment-item"
                        key={leader._id}
                      >
                        <div className="establishment-row">
                          <button
                            type="button"
                            className="governorate-expand"
                            onClick={() =>
                              setOpenId(
                                open
                                  ? null
                                  : leader._id,
                              )
                            }
                          >
                            {open ? (
                              <ChevronUp size={18} />
                            ) : (
                              <ChevronDown size={18} />
                            )}
                          </button>

                          <div className="establishment-icon">
                            <Shield size={18} />
                          </div>

                          <div className="establishment-info">
                            <strong>
                              {leader.fullName}
                            </strong>
                            <span>
                              {
                                roleLabels[
                                  leader.role
                                ]
                              }
                            </span>
                          </div>

                          <span
                            className={`establishment-status ${leader.status}`}
                          >
                            {
                              statusLabels[
                                leader.status
                              ]
                            }
                          </span>

                          <span className="establishment-governorate">
                            {govName(
                              leader.governorateId,
                            )}
                          </span>
                        </div>

                        {open && (
                          <div className="establishment-details">
                            <div className="establishment-details-grid">
                              <div>
                                <span>الهاتف</span>
                                <strong>
                                  {leader.phone}
                                </strong>
                              </div>

                              <div>
                                <span>
                                  البريد الإلكتروني
                                </span>
                                <strong>
                                  {leader.email ||
                                    "غير مضاف"}
                                </strong>
                              </div>

                              <div>
                                <span>الدور</span>
                                <strong>
                                  {
                                    roleLabels[
                                      leader.role
                                    ]
                                  }
                                </strong>
                              </div>

                              <div>
                                <span>المحافظة</span>
                                <strong>
                                  {govName(
                                    leader.governorateId,
                                  )}
                                </strong>
                              </div>

                              <div>
                                <span>المنطقة</span>
                                <strong>
                                  {leader.areaId ||
                                    "غير محددة"}
                                </strong>
                              </div>

                              <div>
                                <span>المعرف</span>
                                <strong>
                                  {leader._id}
                                </strong>
                              </div>
                            </div>

                            {leader.rejectionReason && (
                              <div className="captain-reason">
                                <span>
                                  سبب الرفض
                                </span>
                                <strong>
                                  {
                                    leader.rejectionReason
                                  }
                                </strong>
                              </div>
                            )}

                            {leader.status ===
                              "pending" && (
                              <div className="captain-actions">
                                <button
                                  type="button"
                                  className="captain-action approve"
                                  disabled={
                                    saving ||
                                    !canManageLeaders(currentRole)
                                  }
                                  onClick={() =>
                                    approve(
                                      leader._id,
                                    )
                                  }
                                >
                                  <Check size={16} />
                                  قبول وتفعيل
                                </button>

                                <button
                                  type="button"
                                  className="captain-action reject"
                                  disabled={
                                    saving ||
                                    !canManageLeaders(currentRole)
                                  }
                                  onClick={() =>
                                    reject(
                                      leader._id,
                                    )
                                  }
                                >
                                  <X size={16} />
                                  رفض
                                </button>
                              </div>
                            )}
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              )}
            </section>
          </div>
        </div>
      </main>
    </div>
  );
}
